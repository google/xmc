load("@io_bazel_rules_go//go:def.bzl", "go_library", "go_test")

package(default_visibility = ["//visibility:public"])

go_library(
    name = "metricsquerytest",
    testonly = True,
    srcs = ["rows.go"],
    importpath = "xmanager_cloud/pkg/metricsquery/metricsquerytest",
    deps = [
        "//pkg/bigquery",
        "@com_github_clickhouse_clickhouse_go_v2//lib/driver",
    ],
)

go_test(
    name = "metricsquerytest_test",
    srcs = ["rows_test.go"],
    embed = [":metricsquerytest"],
    deps = ["@com_github_google_go_cmp//cmp"],
)
