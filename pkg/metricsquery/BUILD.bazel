load("@io_bazel_rules_go//go:def.bzl", "go_library", "go_test")

go_library(
    name = "metricsquery",
    srcs = [
        "backend.go",
        "predicate.go",
        "querier.go",
        "series.go",
        "summary.go",
    ],
    importpath = "xmanager_cloud/pkg/metricsquery",
    visibility = ["//visibility:public"],
    deps = [
        "//pkg/bigquery",
        "@com_github_clickhouse_clickhouse_go_v2//lib/driver",
    ],
)

go_test(
    name = "metricsquery_test",
    srcs = [
        "backend_test.go",
        "fakes_test.go",
        "predicate_test.go",
        "querier_test.go",
        "series_test.go",
        "summary_test.go",
    ],
    embed = [":metricsquery"],
    deps = [
        "//pkg/bigquery",
        "//pkg/metricsquery/metricsquerytest",
        "@com_github_clickhouse_clickhouse_go_v2//lib/driver",
        "@com_github_google_go_cmp//cmp",
    ],
)
