load("@io_bazel_rules_go//go:def.bzl", "go_library", "go_test")

go_library(
    name = "linter",
    srcs = [
        "diagnostic.go",
        "linter.go",
        "manifest.go",
    ],
    importpath = "xmanager_cloud/pkg/components/linter",
    visibility = ["//visibility:public"],
    deps = [
        "@in_gopkg_yaml_v3//:yaml_v3",
    ],
)

go_test(
    name = "linter_test",
    srcs = [
        "diagnostic_test.go",
        "linter_test.go",
        "manifest_test.go",
    ],
    embed = [":linter"],
    deps = [
        "@in_gopkg_yaml_v3//:yaml_v3",
    ],
)
