load("@io_bazel_rules_go//go:def.bzl", "go_library", "go_test")

package(default_visibility = ["//visibility:public"])

go_library(
    name = "lifecycle",
    srcs = [
        "deactivation_engine.go",
        "health_aggregator.go",
        "snapshot_resolver.go",
    ],
    importpath = "xmanager_cloud/pkg/components/store/lifecycle",
    deps = [
        "//api/protos/components/v1alpha1",
        "//pkg/components/naming",
        "//pkg/components/semver",
        "//pkg/components/store",
        "//pkg/components/store/dependency",
        "@org_golang_google_grpc//codes",
        "@org_golang_google_grpc//status",
        "@org_golang_google_protobuf//types/known/durationpb",
    ],
)

go_test(
    name = "lifecycle_test",
    srcs = [
        "deactivation_engine_test.go",
        "health_aggregator_test.go",
        "snapshot_resolver_test.go",
    ],
    embed = [":lifecycle"],
    deps = [
        "//api/protos/components/v1alpha1",
        "//pkg/components/store",
        "@com_github_google_go_cmp//cmp",
        "@org_golang_google_genproto_googleapis_rpc//errdetails",
        "@org_golang_google_grpc//codes",
        "@org_golang_google_grpc//status",
        "@org_golang_google_protobuf//testing/protocmp",
        "@org_golang_google_protobuf//types/known/durationpb",
    ],
)
