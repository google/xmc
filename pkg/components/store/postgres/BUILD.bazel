load("@io_bazel_rules_go//go:def.bzl", "go_library", "go_test")

package(default_visibility = ["//visibility:public"])

go_library(
    name = "postgres",
    srcs = [
        "postgres_intent.go",
        "postgres_ownership_fence.go",
        "postgres_store.go",
    ],
    importpath = "xmanager_cloud/pkg/components/store/postgres",
    deps = [
        "//api/protos/components/v1alpha1",
        "//internal/grpcerr",
        "//internal/logging",
        "//internal/storage/postgres/pgdb",
        "//pkg/components/naming",
        "//pkg/components/semver",
        "//pkg/components/store",
        "//pkg/components/store/dependency",
        "//pkg/components/store/lifecycle",
        "//pkg/components/store/ownership",
        "@com_github_jackc_pgx_v5//:pgx",
        "@com_github_jackc_pgx_v5//pgtype",
        "@com_github_jackc_pgx_v5//pgxpool",
        "@org_golang_google_grpc//codes",
        "@org_golang_google_grpc//status",
        "@org_golang_google_protobuf//proto",
    ],
)

go_test(
    name = "postgres_test",
    srcs = [
        "postgres_intent_test.go",
        "postgres_ownership_fence_test.go",
        "postgres_store_test.go",
    ],
    embed = [":postgres"],
    tags = ["local"],
    deps = [
        "//api/protos/components/v1alpha1",
        "//internal/grpcerr",
        "//internal/storage/postgres/testing",
        "//pkg/components/naming",
        "//pkg/components/store",
        "//pkg/components/store/ownership",
        "@com_github_google_go_cmp//cmp",
        "@com_github_jackc_pgx_v5//pgtype",
        "@com_github_jackc_pgx_v5//pgxpool",
        "@org_golang_google_genproto_googleapis_rpc//errdetails",
        "@org_golang_google_grpc//codes",
        "@org_golang_google_grpc//status",
        "@org_golang_google_protobuf//proto",
        "@org_golang_google_protobuf//testing/protocmp",
    ],
)
