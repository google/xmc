    embed = [":spanner"],
    deps = [
        "//api/protos/components/v1alpha1",
        "//api/protos/experiment:messages_go_proto",
        "//internal/storage/data",
        "//internal/storage/spanner",
        "//internal/storage/spanner/component",
        "//internal/storage/spanner/data",
        "//internal/storage/spanner/emulator",
        "//pkg/components/store",
        "//pkg/components/store/dependency",
        "//pkg/components/store/memory",
        "//pkg/components/store/ownership",
        "@com_github_google_go_cmp//cmp",
        "@com_github_google_go_cmp//cmp/cmpopts",
        "@com_github_prometheus_client_golang//prometheus/testutil",
        "@com_google_cloud_go_spanner//:spanner",
        "@org_golang_google_genproto_googleapis_rpc//errdetails",
        "@org_golang_google_grpc//codes",
        "@org_golang_google_grpc//status",
        "@org_golang_google_protobuf//proto",
