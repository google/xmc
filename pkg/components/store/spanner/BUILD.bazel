load("@io_bazel_rules_go//go:def.bzl", "go_library", "go_test")

package(default_visibility = ["//visibility:public"])

go_library(
    name = "spanner",
    srcs = [
        "spanner_ownership_fence.go",
        "spanner_store.go",
    ],
    importpath = "xmanager_cloud/pkg/components/store/spanner",
    deps = [
        "//api/protos/components/v1alpha1",
        "//internal/logging",
        "//internal/storage",
        "//internal/storage/spanner/component",
        "//pkg/components/semver",
        "//pkg/components/store",
        "//pkg/components/store/dependency",
        "//pkg/components/store/lifecycle",
        "//pkg/components/store/ownership",
        "@com_google_cloud_go_spanner//:spanner",
        "@org_golang_google_grpc//codes",
        "@org_golang_google_grpc//status",
        "@org_golang_google_protobuf//proto",
        "@org_golang_google_protobuf//types/known/timestamppb",
    ],
)

go_test(
    name = "spanner_test",
    srcs = [
        "export_test.go",
        "intent_dependency_registration_test.go",
        "intent_idempotency_test.go",
        "intent_source_test.go",
        "observation_heartbeat_test.go",
        "ownership_metrics_test.go",
        "rejection_error_info_test.go",
        "spanner_intent_fast_path_test.go",
        "spanner_ownership_fence_test.go",
        "spanner_store_test.go",
