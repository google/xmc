load("@io_bazel_rules_go//go:def.bzl", "go_library", "go_test")

package(default_visibility = ["//visibility:public"])

go_library(
    name = "store",
    srcs = [
        "deactivation_engine.go",
        "dependency_parser.go",
        "field_mask.go",
        "graph_validator.go",
        "health_aggregator.go",
        "memory_store.go",
        "snapshot_resolver.go",
        "spanner_store.go",
        "store.go",
    ],
    importpath = "xmanager_cloud/pkg/components/store",
    deps = [
        "//api/protos/components/v1alpha1",
        "//pkg/components/graph",
        "//pkg/components/naming",
        "//pkg/components/semver",
        "@com_google_cloud_go_spanner//:spanner",
        "@in_gopkg_yaml_v3//:yaml_v3",
        "@org_golang_google_api//iterator",
        "@org_golang_google_grpc//codes",
        "@org_golang_google_grpc//status",
        "@org_golang_google_protobuf//proto",
        "@org_golang_google_protobuf//types/known/durationpb",
        "@org_golang_google_protobuf//types/known/timestamppb",
    ],
)

go_test(
    name = "store_test",
    srcs = [
        "deactivation_engine_test.go",
        "dependency_parser_test.go",
        "field_mask_test.go",
        "graph_validator_test.go",
        "health_aggregator_test.go",
        "memory_store_test.go",
        "snapshot_resolver_test.go",
        "spanner_store_test.go",
        "store_test.go",
    ],
    embed = [":store"],
    deps = [
        "//api/protos/components/v1alpha1",
        "//api/protos/experiment:messages_go_proto",
        "//internal/storage/data",
        "//internal/storage/spanner/data",
        "//internal/storage/spanner/emulator",
        "@com_github_google_go_cmp//cmp",
        "@com_github_google_go_cmp//cmp/cmpopts",
        "@com_google_cloud_go_spanner//:spanner",
        "@org_golang_google_grpc//codes",
        "@org_golang_google_grpc//status",
        "@org_golang_google_protobuf//proto",
        "@org_golang_google_protobuf//testing/protocmp",
        "@org_golang_google_protobuf//types/known/durationpb",
    ],
)
