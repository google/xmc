load("@io_bazel_rules_go//go:def.bzl", "go_library", "go_test")

package(default_visibility = ["//visibility:public"])

go_library(
    name = "bridge",
    srcs = [
        "fake_helm_manager.go",
        "helm_builder.go",
        "helm_manager.go",
        "reconciler.go",
        "sdk_helm_action_runner.go",
    ],
    importpath = "xmanager_cloud/pkg/components/bridge",
    deps = [
        "//api/protos/components/v1alpha1",
        "//internal/logging",
        "//pkg/components/naming",
        "@io_k8s_api//core/v1:core",
        "@io_k8s_apimachinery//pkg/api/errors",
        "@io_k8s_apimachinery//pkg/apis/meta/v1:meta",
        "@io_k8s_apimachinery//pkg/apis/meta/v1/unstructured",
        "@io_k8s_cli_runtime//pkg/genericclioptions",
        "@io_k8s_client_go//kubernetes",
        "@io_k8s_client_go//util/retry",
        "@org_golang_google_grpc//:go_default_library",
        "@org_golang_google_grpc//codes",
        "@org_golang_google_grpc//status",
        "@sh_helm_helm_v3//pkg/action",
        "@sh_helm_helm_v3//pkg/chart",
        "@sh_helm_helm_v3//pkg/chart/loader",
        "@sh_helm_helm_v3//pkg/cli",
        "@sh_helm_helm_v3//pkg/release",
    ],
)

go_test(
    name = "bridge_test",
    srcs = [
        "fake_helm_manager_test.go",
        "helm_builder_test.go",
        "helm_manager_test.go",
        "reconciler_test.go",
        "sdk_helm_action_runner_test.go",
    ],
    data = [
        "//deploy/helm:chart",
    ],
    embed = [":bridge"],
    deps = [
        "//api/protos/components/v1alpha1",
        "//pkg/components/store",
        "@io_k8s_apimachinery//pkg/apis/meta/v1:meta",
        "@io_k8s_apimachinery//pkg/apis/meta/v1/unstructured",
        "@io_k8s_client_go//kubernetes/fake",
        "@org_golang_google_grpc//codes",
        "@org_golang_google_grpc//status",
        "@org_golang_google_protobuf//proto",
        "@org_golang_google_protobuf//types/known/durationpb",
        "@sh_helm_helm_v3//pkg/chart",
        "@sh_helm_helm_v3//pkg/release",
    ],
)
