load("@io_bazel_rules_go//go:def.bzl", "go_library", "go_test")

go_library(
    name = "jwks",
    srcs = [
        "validator.go",
    ],
    importpath = "xmanager_cloud/pkg/auth/jwks",
    visibility = ["//visibility:public"],
    deps = [
        "//internal/logging",
        "@com_github_golang_jwt_jwt_v5//:jwt",
    ],
)

go_test(
    name = "jwks_test",
    srcs = [
        "validator_test.go",
    ],
    embed = [":jwks"],
    deps = [
        "@com_github_golang_jwt_jwt_v5//:jwt",
    ],
)
