# gazelle:map_kind go_library go_library @io_bazel_rules_go//go:def.bzl
# gazelle:map_kind go_test go_test @io_bazel_rules_go//go:def.bzl
load("@io_bazel_rules_go//go:def.bzl", "go_library", "go_test")

go_library(
    name = "oauth2",
    srcs = [
        "config.go",
        "handlers.go",
        "middleware.go",
        "pipeline.go",
        "provider.go",
        "session.go",
    ],
    importpath = "xmanager_cloud/pkg/auth/oauth2",
    visibility = ["//visibility:public"],
    deps = [
        "@com_github_golang_jwt_jwt_v5//:jwt",
        "@com_google_cloud_go_iam//apiv1/iampb",
        "@com_google_cloud_go_resourcemanager//apiv3",
        "@org_golang_google_api//idtoken",
        "@org_golang_x_oauth2//:oauth2",
        "@org_golang_x_sync//singleflight",
    ],
)

go_test(
    name = "oauth2_test",
    srcs = [
        "config_test.go",
        "oauth2_test.go",
        "pipeline_test.go",
    ],
    embed = [":oauth2"],
    deps = [
        "@com_github_golang_jwt_jwt_v5//:jwt",
        "@com_google_cloud_go_iam//apiv1/iampb",
        "@org_golang_google_api//idtoken",
    ],
)
