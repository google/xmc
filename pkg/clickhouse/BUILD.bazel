load("@io_bazel_rules_go//go:def.bzl", "go_library", "go_test")

go_library(
    name = "clickhouse",
    srcs = ["clickhouse.go"],
    importpath = "xmanager_cloud/pkg/clickhouse",
    visibility = ["//visibility:public"],
    deps = [
        "@com_github_clickhouse_clickhouse_go_v2//:clickhouse-go",
        "@com_github_clickhouse_clickhouse_go_v2//lib/driver",
    ],
)

go_test(
    name = "clickhouse_test",
    srcs = ["clickhouse_test.go"],
    embed = [":clickhouse"],
    deps = ["@com_github_clickhouse_clickhouse_go_v2//:clickhouse-go"],
)
