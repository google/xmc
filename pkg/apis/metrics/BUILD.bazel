load("@io_bazel_rules_go//go:def.bzl", "go_library", "go_test")

go_library(
    name = "metrics",
    srcs = ["types.go"],
    importpath = "github.com/google/xmc/pkg/apis/metrics",
    visibility = ["//visibility:public"],
    deps = [
        "//api/protos/metrics:metrics_go_proto",
    ],
)

go_test(
    name = "metrics_test",
    srcs = ["types_test.go"],
    embed = [":metrics"],
    deps = [
        "//api/protos/metrics:metrics_go_proto",
    ],
)
