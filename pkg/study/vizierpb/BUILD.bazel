load("@io_bazel_rules_go//go:def.bzl", "go_library", "go_test")
load("@io_bazel_rules_go//proto:def.bzl", "go_proto_library")

# gazelle:ignore

go_proto_library(
    name = "vizier_go_proto",
    compilers = [
        "@io_bazel_rules_go//proto:go_proto",
        "@io_bazel_rules_go//proto:go_grpc_v2",
    ],
    importpath = "xmanager_cloud/pkg/study/vizierpb",
    proto = "@oss_vizier//:vizier_proto",
    deps = [
        "@com_google_cloud_go_longrunning//autogen/longrunningpb",
        "@com_google_googleapis//google/api:field_behavior_go_proto",
        "@com_google_googleapis//google/api:resource_go_proto",
        "@org_golang_google_genproto_googleapis_api//:api",
        "@org_golang_google_genproto_googleapis_api//annotations",
    ],
)

go_library(
    name = "vizierpb",
    srcs = ["doc.go"],
    embed = [":vizier_go_proto"],
    importpath = "xmanager_cloud/pkg/study/vizierpb",
    visibility = ["//visibility:public"],
)

go_test(
    name = "vizierpb_test",
    srcs = ["vizierpb_test.go"],
    deps = [
        ":vizierpb",
        "@com_github_google_go_cmp//cmp",
        "@org_golang_google_protobuf//proto",
        "@org_golang_google_protobuf//testing/protocmp",
    ],
)
