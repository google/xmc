load("@rules_python//python:py_binary.bzl", "py_binary")
load("@rules_python//python:py_library.bzl", "py_library")
load("@rules_python//python:py_test.bzl", "py_test")

package(default_visibility = ["//visibility:public"])

exports_files([
    "README.md",
    "check_examples_coverage.py",
    "check_examples_coverage_test.py",
    "examples_import_smoke.py",
    "examples_import_smoke_test.py",
    "format_visual_audit_summary.js",
    "format_visual_audit_summary_test.js",
    "gallery_template/index.html",
    "weekly_visual_snapshot.py",
    "weekly_visual_snapshot_test.py",
])

filegroup(
    name = "gallery_template",
    srcs = glob(["gallery_template/**"]),
)

py_library(
    name = "weekly_visual_snapshot_lib",
    srcs = ["weekly_visual_snapshot.py"],
    data = [":gallery_template"],
    imports = ["../.."],
    deps = [
        "//tools/nightly_tests/verification:endpoint_resolution",
        "//tools/nightly_tests/verification:ess_session",
        "//tools/nightly_tests/verification:ui_entities_validator_lib",
        "//tools/nightly_tests/verification:verifier_cli",
        "@absl_py//absl/flags",
    ],
)

py_binary(
    name = "weekly_visual_snapshot",
    srcs = ["weekly_visual_snapshot.py"],
    data = [":gallery_template"],
    imports = ["../.."],
    deps = [
        ":weekly_visual_snapshot_lib",
    ],
)

py_test(
    name = "weekly_visual_snapshot_test",
    size = "small",
    srcs = ["weekly_visual_snapshot_test.py"],
    data = [":gallery_template"],
    imports = ["../.."],
    deps = [":weekly_visual_snapshot_lib"],
)

py_library(
    name = "check_examples_coverage_lib",
    srcs = ["check_examples_coverage.py"],
    imports = ["../.."],
)

py_binary(
    name = "check_examples_coverage",
    srcs = ["check_examples_coverage.py"],
    imports = ["../.."],
)

py_test(
    name = "check_examples_coverage_test",
    size = "small",
    srcs = ["check_examples_coverage_test.py"],
    imports = ["../.."],
    deps = [":check_examples_coverage_lib"],
)

py_library(
    name = "examples_import_smoke_lib",
    srcs = ["examples_import_smoke.py"],
    imports = ["../.."],
)

py_binary(
    name = "examples_import_smoke",
    srcs = ["examples_import_smoke.py"],
    imports = ["../.."],
)

py_test(
    name = "examples_import_smoke_test",
    size = "small",
    srcs = ["examples_import_smoke_test.py"],
    imports = ["../.."],
    deps = [":examples_import_smoke_lib"],
)
