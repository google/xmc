load("@rules_python//python:py_binary.bzl", "py_binary")
load("@rules_python//python:py_library.bzl", "py_library")
load("@rules_python//python:py_test.bzl", "py_test")

package(default_visibility = ["//visibility:public"])

exports_files([
    "common.py",
    "common_test.py",
    "demo_workload_verify.py",
    "xmc_entities_validator.py",
])

py_library(
    name = "xmc_entities_validator_lib",
    srcs = [
        "xmc_entities_validator.py",
    ],
    imports = ["../.."],
)

py_library(
    name = "common",
    srcs = [
        "common.py",
    ],
    imports = ["../.."],
    deps = [
        ":xmc_entities_validator_lib",
        "@absl_py//absl:app",
        "@absl_py//absl/flags",
    ],
)

py_binary(
    name = "demo_workload_verify",
    srcs = ["demo_workload_verify.py"],
    imports = ["../.."],
    deps = [
        ":common",
        ":xmc_entities_validator_lib",
    ],
)

py_test(
    name = "common_test",
    srcs = ["common_test.py"],
    imports = ["../.."],
    deps = [
        ":common",
        ":xmc_entities_validator_lib",
    ],
)

py_test(
    name = "xmc_entities_validator_test",
    srcs = ["xmc_entities_validator_test.py"],
    imports = ["../.."],
    deps = [
        ":xmc_entities_validator_lib",
    ],
)
