load("@io_bazel_rules_go//go:def.bzl", "go_binary", "go_library", "go_test")

go_library(
    name = "check_go_determinism_lib",
    srcs = ["main.go"],
    importpath = "github.com/google/xmc/tools/lint/check_go_determinism",
    visibility = ["//visibility:private"],
)

go_binary(
    name = "check_go_determinism",
    embed = [":check_go_determinism_lib"],
    visibility = ["//visibility:public"],
)

go_test(
    name = "check_go_determinism_test",
    srcs = ["main_test.go"],
    embed = [":check_go_determinism_lib"],
)
