load("@io_bazel_rules_go//go:def.bzl", "go_binary")
load("//:oci.bzl", "dev_binary_guard_test")

# A mockauth-tagged binary without a _dev suffix proves the guard's gotags clause on its own.
go_binary(
    name = "mockauth_tagged_binary",
    testonly = True,
    srcs = ["main.go"],
    gotags = ["mockauth"],
    pure = "on",
)

dev_binary_guard_test(
    name = "mockauth_tagged_binary_detected_test",
    binary = ":mockauth_tagged_binary",
    expect_dev_binary = True,
)
