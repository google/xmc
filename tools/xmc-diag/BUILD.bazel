load("@io_bazel_rules_go//go:def.bzl", "go_binary")
load("//:compat.bzl", "compat_go_library", "compat_go_test")

package(default_visibility = ["//visibility:private"])

compat_go_library(
    name = "xmc_diag_lib",
    srcs = ["main.go"],
    importpath = "xmanager_cloud/tools/xmc_diag/main",
    deps = [
        "//pkg/clickhouse",
        "@com_github_clickhouse_clickhouse_go_v2//lib/driver",
        "@com_github_twmb_franz_go//pkg/kgo",
        "@com_github_twmb_franz_go_pkg_kadm//:kadm",
    ],
)

go_binary(
    name = "xmc-diag",
    embed = [":xmc_diag_lib"],
    pure = "on",
    visibility = ["//visibility:public"],
)

compat_go_test(
    name = "xmc_diag_test",
    srcs = ["main_test.go"],
    embed = [":xmc_diag_lib"],
    deps = [
        "@com_github_twmb_franz_go_pkg_kadm//:kadm",
    ],
)
