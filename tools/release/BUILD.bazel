load("@rules_python//python:py_library.bzl", "py_library")
load("@rules_python//python:py_test.bzl", "py_test")

package(default_visibility = ["//visibility:public"])

exports_files([
    "extract_release_metadata.py",
])

py_library(
    name = "models_lib",
    srcs = ["models.py"],
    imports = ["../.."],
)

py_library(
    name = "yaml_parser_lib",
    srcs = ["yaml_parser.py"],
    imports = ["../.."],
)

py_library(
    name = "git_ops_lib",
    srcs = ["git_ops.py"],
    imports = ["../.."],
    deps = [
        ":models_lib",
        "//tools/common:tool_utils",
    ],
)

py_library(
    name = "feature_flags_lib",
    srcs = ["feature_flags.py"],
    imports = ["../.."],
    deps = [
        ":git_ops_lib",
        ":models_lib",
        ":yaml_parser_lib",
    ],
)

py_library(
    name = "commit_classifier_lib",
    srcs = ["commit_classifier.py"],
    imports = ["../.."],
    deps = [
        ":feature_flags_lib",
        ":models_lib",
    ],
)

py_library(
    name = "semver_engine_lib",
    srcs = ["semver_engine.py"],
    imports = ["../.."],
    deps = [
        ":models_lib",
    ],
)

py_library(
    name = "extract_release_metadata_lib",
