load("@rules_python//python:py_binary.bzl", "py_binary")
load("@rules_python//python:py_library.bzl", "py_library")
load("@rules_python//python:py_test.bzl", "py_test")

package(default_visibility = ["//visibility:public"])

exports_files(["recover_closed_stacked_pr.py"])

py_library(
    name = "recover_closed_stacked_pr_lib",
    srcs = ["recover_closed_stacked_pr.py"],
    imports = ["../.."],
    deps = [
        "//tools/common:tool_utils",
        "//tools/pr_review:github_utils",
    ],
)

py_binary(
    name = "recover_closed_stacked_pr",
    srcs = ["recover_closed_stacked_pr.py"],
    imports = ["../.."],
    deps = [":recover_closed_stacked_pr_lib"],
)

py_test(
    name = "recover_closed_stacked_pr_test",
    srcs = ["recover_closed_stacked_pr_test.py"],
    imports = ["../.."],
    deps = [":recover_closed_stacked_pr_lib"],
)
