load("@rules_python//python:py_library.bzl", "py_library")
load("@rules_python//python:py_test.bzl", "py_test")

# DEV/TEST ONLY Vizier fixture (see README.md). vizier_server.py is not a Bazel target: it needs
# google-vizier, which is installed only in the fixture image.
filegroup(
    name = "manifests",
    srcs = ["vizier.yaml"],
    visibility = ["//test/e2e:__pkg__"],
)

py_library(
    name = "server_env",
    srcs = ["server_env.py"],
    imports = ["."],
)

py_test(
    name = "server_env_test",
    size = "small",
    srcs = ["server_env_test.py"],
    main = "server_env_test.py",
    deps = [":server_env"],
)

py_library(
    name = "supported_algorithms",
    srcs = ["supported_algorithms.py"],
    imports = ["."],
)

py_test(
    name = "supported_algorithms_test",
    size = "small",
    srcs = ["supported_algorithms_test.py"],
    main = "supported_algorithms_test.py",
    deps = [":supported_algorithms"],
)
