load("@rules_python//python:py_binary.bzl", "py_binary")
load("@rules_python//python:py_library.bzl", "py_library")
load("@rules_python//python:py_test.bzl", "py_test")

py_library(
    name = "example_runner",
    srcs = ["example_runner.py"],
    visibility = ["//visibility:public"],
    deps = [
        "//test/e2e/lib:orchestration_lib",
    ],
)

py_library(
    name = "examples_e2e_pkg",
    srcs = [
        "__init__.py",
        "test_demo_workload.py",
    ],
    visibility = ["//visibility:public"],
    deps = [
        ":example_runner",
        "//test/e2e/lib:orchestration_lib",
        "//tools/nightly_tests:common",
        "//tools/nightly_tests:demo_workload_verify_lib",
        "//tools/nightly_tests:xmc_entities_validator_lib",
    ],
)

py_test(
    name = "example_runner_test",
    srcs = ["example_runner_test.py"],
    deps = [
        ":example_runner",
        "//test/e2e/lib:orchestration_lib",
    ],
)

py_test(
    name = "test_demo_workload_test",
    srcs = ["test_demo_workload_test.py"],
    deps = [
        ":example_runner",
        ":examples_e2e_pkg",
        "//tools/nightly_tests:demo_workload_verify_lib",
    ],
)

py_binary(
    name = "test_demo_workload",
    srcs = ["test_demo_workload.py"],
    main = "test_demo_workload.py",
    visibility = ["//visibility:public"],
    deps = [
        ":example_runner",
        ":examples_e2e_pkg",
        "//test/e2e:e2e_pkg",
        "//tools/nightly_tests:common",
        "//tools/nightly_tests:demo_workload_verify_lib",
        "//tools/nightly_tests:xmc_entities_validator_lib",
    ],
)
