load("@rules_python//python:py_library.bzl", "py_library")
load("@rules_python//python:py_test.bzl", "py_test")

py_library(
    name = "orchestration_lib",
    srcs = [
        "__init__.py",
        "command.py",
        "config.py",
        "spanner.py",
    ],
    visibility = ["//visibility:public"],
)

py_test(
    name = "command_test",
    srcs = ["command_test.py"],
    deps = [":orchestration_lib"],
)

py_test(
    name = "config_test",
    srcs = ["config_test.py"],
    deps = [":orchestration_lib"],
)

py_test(
    name = "spanner_test",
    srcs = ["spanner_test.py"],
    deps = [":orchestration_lib"],
)
