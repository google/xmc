        "profile_migration_test.go",
    ],
    data = [
        ":profile_migration_testdata",
        "//deploy/helm:chart",
        "//deploy/profiles/stable-2026a:chart",
    ],
    tags = [
        "e2e",
        "exclusive",
        "external",
        "local",
        "manual",
    ],
    deps = _KIND_3P_DEPS + [
        "@com_github_google_go_cmp//cmp",
        "@io_k8s_apimachinery//pkg/api/resource",
    ],
)
