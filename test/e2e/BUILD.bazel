# Installs the BYO Vizier reference chart (KinD overlay) and registers it as the stable-2026a
# `vizier` component. The Vizier image must already be built into the local Docker daemon; see
# deploy/addons/hpo/vizier/README.md.
go_test(
    name = "vizier_kind_test",
    size = "large",
    timeout = "long",
    srcs = [
        "kind_3p_harness_test.go",
        "vizier_kind_test.go",
    ],
    data = [
        "//deploy/addons/hpo/vizier:chart",
        "//deploy/helm:chart",
        "//deploy/profiles/stable-2026a/components/vizier:chart",
    ],
    tags = [
        "e2e",
        "exclusive",
        "external",
        "local",
        "manual",
    ],
    deps = _KIND_3P_DEPS,
)

# Test-only fixtures of profile_migration_test: admin values, the stable-2026b overlay and the
# rolling-gateway stand-in chart.
filegroup(
    name = "profile_migration_testdata",
    srcs = glob(["testdata/profile_migration/**"]),
)

go_test(
    name = "profile_migration_test",
    size = "large",
    timeout = "long",
    srcs = [
        "clickhouse_kind_instance_test.go",
        "kind_3p_harness_test.go",
