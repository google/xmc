# Pinned upstream controller release manifests (see MODULE.bazel) that the E2E harness
# installs into the KinD cluster before the XMC Helm release.
genrule(
    name = "jobset_manifests",
    srcs = ["@jobset_v0_12_0_manifests//file"],
    outs = ["jobset_manifests.yaml"],
    cmd = "cp $< $@",
    visibility = ["//test/e2e:__subpackages__"],
)

genrule(
    name = "kueue_manifests",
    srcs = ["@kueue_v0_18_2_manifests//file"],
    outs = ["kueue_manifests.yaml"],
    cmd = "cp $< $@",
    visibility = ["//test/e2e:__subpackages__"],
)
