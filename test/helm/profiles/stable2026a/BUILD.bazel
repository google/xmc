load("@io_bazel_rules_go//go:def.bzl", "go_test")

# Tests for the stable-2026a profile meta-chart: the generic profilecontract checks plus
# stable-2026a expectations. They live outside the chart package so the test binary is not placed
# inside the chart directory that Helm's loader reads.
go_test(
    name = "stable2026a_test",
    srcs = ["profile_chart_test.go"],
    data = ["//deploy/profiles/stable-2026a:chart"],
    deps = [
        "//test/helm/profiles/profilecontract",
        "@com_github_google_go_cmp//cmp",
    ],
)
