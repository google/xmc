load("@io_bazel_rules_go//go:def.bzl", "go_library", "go_test")

# Generic contract checks for profile meta-charts, shared by the per-profile test packages.
go_library(
    name = "profilecontract",
    testonly = True,
    srcs = [
        "catalog.go",
        "contract.go",
        "render.go",
    ],
    importpath = "xmanager_cloud/test/helm/profiles/profilecontract",
    visibility = [
        # ChartDir, DecodeDocs and Lookup are also used by the addon chart tests.
        "//test/helm/addons:__subpackages__",
        "//test/helm/profiles:__subpackages__",
    ],
    deps = [
        "@com_github_google_go_cmp//cmp",
        "@in_gopkg_yaml_v3//:yaml_v3",
        "@sh_helm_helm_v3//pkg/chart",
        "@sh_helm_helm_v3//pkg/chart/loader",
        "@sh_helm_helm_v3//pkg/chartutil",
        "@sh_helm_helm_v3//pkg/engine",
    ],
)

# Tests the checks against mutated copies of the stable-2026a chart, and the building blocks
# against testdata/minichart.
go_test(
    name = "profilecontract_test",
    srcs = [
        "contract_test.go",
        "render_test.go",
    ],
    data = ["//deploy/profiles/stable-2026a:chart"] + glob(["testdata/**"]),
    embed = [":profilecontract"],
    deps = ["@com_github_google_go_cmp//cmp"],
)
