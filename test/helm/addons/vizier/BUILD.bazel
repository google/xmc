load("@io_bazel_rules_go//go:def.bzl", "go_test")

# Renders the BYO Vizier reference chart through the Helm SDK. It lives outside the chart package
# so the test binary is not placed inside the chart directory that Helm's loader reads.
go_test(
    name = "vizier_test",
    size = "small",
    srcs = ["chart_test.go"],
    data = ["//deploy/addons/hpo/vizier:chart"],
    deps = [
        "//test/helm/profiles/profilecontract",
        "@com_github_google_go_cmp//cmp",
        "@in_gopkg_yaml_v3//:yaml_v3",
        "@sh_helm_helm_v3//pkg/chart",
        "@sh_helm_helm_v3//pkg/chart/loader",
        "@sh_helm_helm_v3//pkg/chartutil",
        "@sh_helm_helm_v3//pkg/engine",
    ],
)
