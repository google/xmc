load("@rules_python//python:defs.bzl", "py_binary", "py_library", "py_test")

package(default_visibility = ["//visibility:public"])

py_library(
    name = "server_local",
    srcs = ["server_local.py"],
    data = [
        "//test/dataengine:golden_testdata",
        "//test/fixtures/dashboards",
    ],
    imports = ["."],
    visibility = ["//visibility:public"],
    deps = [
        ":resource_fixtures",
        "//cmd/ui:server",
    ],
)

py_binary(
    name = "server",
    srcs = ["server_local.py"],
    main = "server_local.py",
    deps = [
        ":server_local",
    ],
)

py_test(
    name = "server_local_test",
    srcs = ["server_local_test.py"],
    data = [
        "//test/dataengine:golden_testdata",
        "//test/fixtures/dashboards",
    ],
    deps = [
        ":server_local",
    ],
)

py_library(
    name = "resource_fixtures",
    srcs = ["resource_fixtures.py"],
    imports = ["."],
)

py_test(
    name = "resource_fixtures_test",
    srcs = ["resource_fixtures_test.py"],
    deps = [":resource_fixtures"],
)
