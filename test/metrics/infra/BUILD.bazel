load("@io_bazel_rules_go//go:def.bzl", "go_library", "go_test")
load("@rules_python//python:defs.bzl", "py_library", "py_test")

go_library(
    name = "infra",
    srcs = ["setup.go"],
    importpath = "xmanager_cloud/test/metrics/infra",
    visibility = ["//visibility:public"],
    deps = [
        "@com_github_clickhouse_clickhouse_go_v2//:clickhouse-go",
        "@com_github_clickhouse_clickhouse_go_v2//lib/driver",
        "@com_github_testcontainers_testcontainers_go//:testcontainers-go",
        "@com_github_testcontainers_testcontainers_go//network",
        "@com_github_testcontainers_testcontainers_go//wait",
        "@com_github_testcontainers_testcontainers_go_modules_clickhouse//:clickhouse",
        "@com_github_testcontainers_testcontainers_go_modules_redpanda//:redpanda",
        "@com_github_twmb_franz_go//pkg/kgo",
        "@com_github_twmb_franz_go_pkg_kadm//:kadm",
    ],
)

go_test(
    name = "infra_test",
    srcs = ["setup_test.go"],
    data = [
        "//api/protos/metrics:metrics.proto",
        "//deploy/clickhouse:schema.sql",
    ],
    embed = [":infra"],
    tags = [
        "local",
        "manual",
        "requires-network",
    ],
)

py_library(
    name = "infra_py",
    srcs = ["setup.py"],
    imports = ["../../.."],
    visibility = ["//visibility:public"],
)

py_test(
    name = "setup_py_test",
    srcs = ["setup_test.py"],
    imports = ["../../.."],
    main = "setup_test.py",
    deps = [":infra_py"],
)
