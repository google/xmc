load("@io_bazel_rules_go//go:def.bzl", "go_test")

# Stages the pinned kube-apiserver, etcd and kubectl binaries into this package so the test binary
# resolves them from a stable runfiles path (see envtestassets.runfilesAssetsDir) instead of the
# bzlmod-generated canonical name of the external repository, which is not stable.
genrule(
    name = "envtest_control_plane_binaries",
    srcs = select({
        "@platforms//cpu:x86_64": ["@envtest_control_plane_linux_amd64//:control_plane"],
        "@platforms//cpu:aarch64": ["@envtest_control_plane_linux_arm64//:control_plane"],
    }),
    outs = [
        "envtest_control_plane/etcd",
        "envtest_control_plane/kube-apiserver",
        "envtest_control_plane/kubectl",
    ],
    cmd = "for binary in $(SRCS); do cp -p \"$$binary\" \"$(RULEDIR)/envtest_control_plane/$$(basename $$binary)\"; done",
)

go_test(
    name = "integration_test",
    size = "medium",
    timeout = "short",
    srcs = [
        "components_admission_test.go",
        "components_status_sync_test.go",
    ],
    data = [
        ":envtest_control_plane_binaries",
        "//deploy/helm:chart",
    ],
    deps = [
        "//api/protos/components/v1alpha1",
        "//pkg/components/bridge",
        "//pkg/components/bridge/statussync",
        "//test/integration/componentenv",
        "@io_k8s_apimachinery//pkg/api/errors",
        "@io_k8s_apimachinery//pkg/apis/meta/v1:meta",
        "@io_k8s_apimachinery//pkg/apis/meta/v1/unstructured",
        "@io_k8s_apimachinery//pkg/runtime/schema",
        "@io_k8s_apimachinery//pkg/types",
        "@io_k8s_client_go//dynamic",
    ],
)
