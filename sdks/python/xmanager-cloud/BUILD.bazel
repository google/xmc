load("@rules_python//python:defs.bzl", "py_library", "py_test")

# The xmanager_cloud package needs PyPI dependencies (`packaging`) that Bazel does
# not provide, so src/xmanager_cloud/*_test.py runs against the installed wheel
# and sdist in .github/workflows/xmanager-cloud-package.yml instead.

py_library(
    name = "build_staging",
    srcs = ["build_staging.py"],
    imports = ["."],
)

py_test(
    name = "build_staging_test",
    srcs = ["build_staging_test.py"],
    deps = [":build_staging"],
)

py_library(
    name = "install_smoke_check",
    srcs = ["install_smoke_check.py"],
    imports = ["."],
    deps = [":build_staging"],
)

py_test(
    name = "install_smoke_check_test",
    srcs = ["install_smoke_check_test.py"],
    deps = [":install_smoke_check"],
)
