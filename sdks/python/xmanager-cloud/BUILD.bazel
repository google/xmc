load("@rules_python//python:defs.bzl", "py_library", "py_test")

# The xmanager_cloud package needs PyPI dependencies (`packaging`) that Bazel does
# not provide, so src/xmanager_cloud/*_test.py runs against the installed wheel
# and sdist in .github/workflows/xmanager-cloud-package.yml instead. The xm_cloud
# CLI uses only the standard library; its tests run in both places.

py_library(
    name = "xm_cloud_cli",
    srcs = [
        "src/xm_cloud/__init__.py",
        "src/xm_cloud/cli/__init__.py",
        "src/xm_cloud/cli/arg_parsing.py",
        "src/xm_cloud/cli/credentials.py",
        "src/xm_cloud/cli/login_command.py",
        "src/xm_cloud/cli/logout_command.py",
        "src/xm_cloud/cli/main.py",
        "src/xm_cloud/cli/terminal_text.py",
    ],
    imports = ["src"],
)

py_test(
    name = "terminal_text_test",
    srcs = ["src/xm_cloud/cli/terminal_text_test.py"],
    deps = [":xm_cloud_cli"],
)

py_test(
    name = "arg_parsing_test",
    srcs = ["src/xm_cloud/cli/arg_parsing_test.py"],
    deps = [":xm_cloud_cli"],
)

py_test(
    name = "credentials_test",
    srcs = ["src/xm_cloud/cli/credentials_test.py"],
    deps = [
        ":xm_cloud_cli",
        # Checks that the credentials cache key matches the one xdash reads.
        "//sdks/python/xdash:auth",
    ],
)

py_test(
    name = "login_command_test",
    srcs = ["src/xm_cloud/cli/login_command_test.py"],
    deps = [":xm_cloud_cli"],
)

py_test(
    name = "logout_command_test",
    srcs = ["src/xm_cloud/cli/logout_command_test.py"],
    deps = [":xm_cloud_cli"],
)

py_test(
    name = "main_test",
    srcs = ["src/xm_cloud/cli/main_test.py"],
    deps = [":xm_cloud_cli"],
)

py_library(
    name = "build_staging",
    srcs = ["build_staging.py"],
    imports = ["."],
)

py_test(
    name = "build_staging_test",
    srcs = ["build_staging_test.py"],
    deps = [":build_staging"],
)

py_library(
    name = "install_smoke_check",
    srcs = ["install_smoke_check.py"],
    imports = ["."],
    deps = [":build_staging"],
)

py_test(
    name = "install_smoke_check_test",
    srcs = ["install_smoke_check_test.py"],
    deps = [":install_smoke_check"],
)
