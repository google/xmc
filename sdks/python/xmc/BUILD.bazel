load("@rules_python//python:defs.bzl", "py_binary", "py_library", "py_test")

py_library(
    name = "xmc",
    srcs = [
        "__init__.py",
        "autolog.py",
        "buffer.py",
        "client.py",
        "dist_harvest.py",
        "flusher.py",
        "integrations/__init__.py",
        "integrations/common.py",
        "integrations/keras.py",
        "integrations/lightning.py",
        "network.py",
        "resilience.py",
        "types.py",
    ] + glob(
        ["auth/*.py"],
        exclude = ["auth/*_test.py"],
    ),
    data = [
        "README.md",
        "py.typed",
        "pyproject.toml",
    ],
    imports = [".."],
    visibility = ["//visibility:public"],
    deps = [
        "//api/protos/metrics:metrics_py_proto",
    ],
)

