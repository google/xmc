module(
    name = "xmanager_cloud",
    version = "1.0.0",
)

bazel_dep(name = "rules_go", version = "0.60.0", repo_name = "io_bazel_rules_go")
bazel_dep(name = "gazelle", version = "0.40.0", repo_name = "bazel_gazelle")
bazel_dep(name = "rules_proto", version = "7.1.0")
bazel_dep(name = "protobuf", version = "33.4", repo_name = "com_google_protobuf")
bazel_dep(name = "googleapis", version = "0.0.0-20260514-1dbb1a14", repo_name = "com_google_googleapis")
bazel_dep(name = "googleapis-go", version = "1.1.5")

go_sdk = use_extension("@io_bazel_rules_go//go:extensions.bzl", "go_sdk")
go_sdk.host()

go_deps = use_extension("@bazel_gazelle//:extensions.bzl", "go_deps")
go_deps.from_file(go_mod = "//:go.mod")
use_repo(
    go_deps,
    "org_golang_google_genproto",
    "org_golang_google_genproto_googleapis_api",
    "org_golang_google_genproto_googleapis_rpc",
    "org_golang_google_protobuf",
    "org_golang_google_grpc",
    "com_google_cloud_go_longrunning",
    "com_github_google_go_cmp",
    "com_github_google_tink_go",
    "com_github_google_uuid",
    "org_golang_x_oauth2",
    "org_golang_google_api",
    "io_k8s_api",
    "io_k8s_apimachinery",
    "io_k8s_client_go",
    "io_k8s_sigs_controller_runtime",
    "com_google_cloud_go_spanner",
    "com_github_kylelemons_godebug",
    "com_github_redis_go_redis_v9",
)
