go_sdk.download(version = "1.26.0")

# The buf CLI used by buf_breaking_test (//api:protos_breaking_test).
# sha256 is the checksum of the release's sha256.txt.
buf = use_extension("@rules_buf//buf:extensions.bzl", "buf")
buf.toolchains(
    sha256 = "18f603d3b418f6a1259da4425b04bbe2fbaf60c2b796b98114d961e8736198b9",
    version = "v1.73.0",
)

http_archive = use_repo_rule("@bazel_tools//tools/build_defs/repo:http.bzl", "http_archive")

_ENVTEST_BUILD_FILE = """filegroup(
    name = "assets",
    srcs = ["etcd", "kube-apiserver", "kubectl"],
    visibility = ["//visibility:public"],
)
"""

[
    http_archive(
        name = "kubebuilder_envtest_" + plat.replace("-", "_"),
        build_file_content = _ENVTEST_BUILD_FILE,
        integrity = integrity,
        strip_prefix = "controller-tools/envtest",
        urls = ["https://github.com/kubernetes-sigs/controller-tools/releases/download/envtest-v1.30.3/envtest-v1.30.3-%s.tar.gz" % plat],
    )
    for plat, integrity in [
        ("linux-amd64", "sha512-DllIUR41FW6KuiY/2HiYOxGq2C0PdLVQepgEudEBWD8cSEKBaQxv8aNnjtA4yHSRVZJ1k3QIS3i1et490SZsHQ=="),
        ("linux-arm64", "sha512-slxF1HN5IuEjQzRLKCTSaBwAZvkiQtWbucovPRUlPxsOqoj1ZdmPxvyw3yTmeRae0OzcR3gqTiWH3edrGau7DQ=="),
        ("darwin-amd64", "sha512-VjW+tuCKIoMYpD2d8nupKHnIzlU6OW4YMwYyuFtHJLPyxJy0HFUMFimQb1g7szJvl3x0FFcmuHJ8hG0UNj0zcw=="),
        ("darwin-arm64", "sha512-h47tMBb7xQXKsxC0m+K62y24jqqgL6IcRIwP9ZbVz9KPlNspQyBQ6yfxp6/qcRV+3LT+YUjyjmO/RmirfV2LWw=="),
    ]
]

http_file = use_repo_rule("@bazel_tools//tools/build_defs/repo:http.bzl", "http_file")

# Upstream controller release manifests that the KinD E2E harness installs. Keep the versions in
# sync with sigs.k8s.io/jobset and sigs.k8s.io/kueue in go.mod.
http_file(
    name = "jobset_v0_12_0_manifests",
    downloaded_file_path = "jobset_manifests.yaml",
    sha256 = "a41aaf12dd0b7b0a3d626b8d6107f32c3dc889d7e7830adc46b8cdb77a8963bb",
    urls = ["https://github.com/kubernetes-sigs/jobset/releases/download/v0.12.0/manifests.yaml"],
)

http_file(
    name = "kueue_v0_18_2_manifests",
    downloaded_file_path = "kueue_manifests.yaml",
    sha256 = "087c660cb2ba78947c9041f80d23c85e091e939c95377f47fb7a012cdca5f85f",
    urls = ["https://github.com/kubernetes-sigs/kueue/releases/download/v0.18.2/manifests.yaml"],
)

go_deps = use_extension("@bazel_gazelle//:extensions.bzl", "go_deps")
go_deps.from_file(go_mod = "//:go.mod")
go_deps.module(
    path = "github.com/moby/moby/client",
    sum = "h1:S+2XegzHQrrvTCvF6s5HFzcrywWQmuVnhOXe2kiWjIw=",
    version = "v0.4.0",
)
go_deps.module(
    path = "github.com/moby/moby/api",
    sum = "h1:wiat9QAhnDQjA7wk1kh/TqHz2I1uUA7M7t9SAl/JNXg=",
    version = "v1.54.2",
)
go_deps.module(
    path = "google.golang.org/grpc/cmd/protoc-gen-go-grpc",
    sum = "h1:F29+wU6Ee6qgu9TddPgooOdaqsxTMunOoj8KA5yuS5A=",
    version = "v1.5.1",
)
go_deps.gazelle_override(
    build_file_generation = "on",
    directives = [
        "gazelle:default_visibility //visibility:public",
    ],
    path = "cloud.google.com/go",
)

# grpc-gateway ships its own Bazel BUILD files (referencing @googleapis and
# repo-local proto toolchains) alongside pre-generated *.pb.go files.
# Regenerate BUILD files from Go sources only, without proto rules.
go_deps.gazelle_override(
    build_file_generation = "clean",
    directives = [
        "gazelle:proto disable",
    ],
    path = "github.com/grpc-ecosystem/grpc-gateway/v2",
)
