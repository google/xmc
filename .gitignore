# Bazel build products and symlinks
/bazel-*
.env
/bin/

# Environment-specific values overrides
/deploy/helm/environments/values-*.yaml

# Locally packaged profile charts (helm package)
/deploy/profiles/*/*.tgz

# Node.js and Angular
cmd/ui/node_modules/
cmd/ui/.angular/
cmd/ui/dist/
cmd/ui/build_tmp/
cmd/ui/test-results/
cmd/ui/playwright-report/

**__pycache__**
# proto binaries
*.pb

# deployment files
*-deployment.yaml
/cluster-toolkit

# Compiled Cluster Toolkit deployments
/ctk-out

# Local development config
/.xmc_dev/
deploy/local/xmanager-cloud-local.yaml
deploy/local/*-local.yaml

# Python virtual environments & build artifacts
**/venv/
**/.venv/
/.venv*/
*.egg-info/
# In-tree pip builds (e.g. install_xmanager.py installing sdks/python/xmc)
sdks/python/*/build/

# PR review checklist artifacts
pr_review_checklist.md
