# Restoring default Bazel options

# Cross-compilation platform shortcuts
build:linux_amd64 --platforms=@io_bazel_rules_go//go/toolchain:linux_amd64
build:linux_arm64 --platforms=@io_bazel_rules_go//go/toolchain:linux_arm64

# Require explicit __init__.py files in Python targets (future rules_python 3.0 default)
build --@rules_python//python/config_settings:incompatible_default_to_explicit_init_py=true

# Exclude target Starlark flags (e.g. rules_go race/linkmode transitions) from the exec
# configuration so host tools like protoc are compiled once instead of per transition.
build --incompatible_exclude_starlark_flags_from_exec_config=true

# Configure workspace status command for version stamping
build --workspace_status_command="python3 tools/common/workspace_status.py"
build --stamp

# Local Bazel disk cache settings for GitHub-hosted CI runners (ubuntu-latest).
# CI workflows pass --disk_cache=${HOME}/.cache/bazel-disk explicitly (avoiding
# unexpanded '~' in .bazelrc). Compress cached blobs and skip caching linked Go
# binaries (~9 GB of static test executables) so ephemeral runners do not exhaust disk space.
build:ci --remote_cache_compression=true
build:ci --modify_execution_info=GoLink=+no-remote-cache
# Disable the testcontainers Ryuk reaper on CI. Ephemeral CI runner VMs discard
# containers on job teardown, whereas local runs keep Ryuk enabled so developer
# machines don't leak containers.
test:ci --test_env=TESTCONTAINERS_RYUK_DISABLED=true

# Deterministic test execution environment
test --test_env=PYTHONHASHSEED=0
test --test_env=TZ=UTC

# Deterministic coverage collection (LCOV combined report across workspace packages)
coverage --combined_report=lcov
coverage --experimental_fetch_all_coverage_outputs
coverage --instrumentation_filter="^//(api|cmd|deploy|examples|internal|pkg|sdks|tools)[/:]"


