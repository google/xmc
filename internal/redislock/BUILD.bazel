load("@io_bazel_rules_go//go:def.bzl", "go_library", "go_test")

go_library(
    name = "redislock",
    srcs = ["redislock.go"],
    importpath = "xmanager_cloud/internal/redislock",
    visibility = ["//:__subpackages__"],
    deps = ["@com_github_redis_go_redis_v9//:go-redis"],
)

go_test(
    name = "redislock_test",
    srcs = ["redislock_test.go"],
    embed = [":redislock"],
    deps = [
        "@com_github_google_go_cmp//cmp",
        "@com_github_redis_go_redis_v9//:go-redis",
    ],
)

go_test(
    name = "redislock_redis_test",
    srcs = ["redislock_redis_test.go"],
    tags = ["local"],
    deps = [
        ":redislock",
        "//internal/redistest",
        "@com_github_redis_go_redis_v9//:go-redis",
    ],
)
