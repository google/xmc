# gazelle:ignore
load("@io_bazel_rules_go//go:def.bzl", "go_library", "go_test")

go_library(
    name = "interfaces",
    srcs = ["interfaces.go"],
    importpath = "xmanager_cloud/common/interfaces",
    visibility = ["//visibility:public"],
    deps = [
        "//api/protos/task_queue:task_go_proto",
    ],
)

go_library(
    name = "health",
    srcs = ["health.go"],
    importpath = "xmanager_cloud/common/health",
    visibility = ["//visibility:public"],
    deps = [
        "//internal/logging",
        "@com_google_cloud_go_spanner//:spanner",
        "@io_k8s_client_go//kubernetes",
        "@org_golang_google_api//iterator",
    ],
)

go_test(
    name = "health_test",
    srcs = ["health_test.go"],
    embed = [":health"],
    deps = [
        "//internal/storage/spanner/emulator",
        "@io_k8s_apimachinery//pkg/version",
        "@io_k8s_client_go//discovery",
        "@io_k8s_client_go//kubernetes",
    ],
)
