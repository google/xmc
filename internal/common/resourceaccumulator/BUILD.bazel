load("@io_bazel_rules_go//go:def.bzl", "go_library", "go_test")

go_library(
    name = "resourceaccumulator",
    srcs = [
        "classifier.go",
        "resourceaccumulator.go",
    ],
    importpath = "github.com/google/xmc/internal/common/resourceaccumulator",
    visibility = ["//:__subpackages__"],
    deps = [
        "//api/protos/experiment:messages_go_proto",
        "//internal/common/tputopology",
        "//internal/domain/workunit",
        "//internal/kubernetes/common/constants",
    ],
)

go_test(
    name = "resourceaccumulator_test",
    srcs = [
        "classifier_test.go",
        "resourceaccumulator_test.go",
    ],
    embed = [":resourceaccumulator"],
    deps = [
        "//api/protos/experiment:messages_go_proto",
        "@com_github_google_go_cmp//cmp",
    ],
)
