load("@io_bazel_rules_go//go:def.bzl", "go_library", "go_test")

package(default_visibility = ["//visibility:public"])

go_library(
    name = "health",
    srcs = [
        "health.go",
        "postgres_health.go",
        "spanner_health.go",
    ],
    importpath = "xmanager_cloud/internal/common/health",
    deps = [
        "//internal/logging",
        "//internal/storage/spanner/migrations/version",
        "@com_github_jackc_pgx_v5//:pgx",
        "@com_github_jackc_pgx_v5//pgxpool",
        "@com_google_cloud_go_spanner//:spanner",
        "@io_k8s_client_go//kubernetes",
        "@org_golang_google_api//iterator",
    ],
)

go_test(
    name = "health_test",
    srcs = [
        "health_test.go",
        "postgres_health_test.go",
    ],
    embed = [":health"],
    deps = [
        "//internal/storage/spanner/emulator",
        "//internal/storage/spanner/migrations/version",
        "@com_github_jackc_pgx_v5//:pgx",
        "@io_k8s_apimachinery//pkg/version",
        "@io_k8s_client_go//discovery",
        "@io_k8s_client_go//kubernetes",
    ],
)
