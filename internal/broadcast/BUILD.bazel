load("@io_bazel_rules_go//go:def.bzl", "go_library", "go_test")

package(default_visibility = ["//:__subpackages__"])

go_library(
    name = "broadcast",
    srcs = [
        "broadcast.go",
        "consumer.go",
        "events.go",
        "fake.go",
        "publisher.go",
    ],
    importpath = "github.com/google/xmc/internal/broadcast",
    deps = [
        "@com_github_redis_go_redis_v9//:go-redis",
    ],
)

go_test(
    name = "broadcast_test",
    srcs = [
        "consumer_test.go",
        "fake_test.go",
        "publisher_test.go",
    ],
    embed = [":broadcast"],
    deps = [
        "@com_github_redis_go_redis_v9//:go-redis",
    ],
)
