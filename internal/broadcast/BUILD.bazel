load("@io_bazel_rules_go//go:def.bzl", "go_library", "go_test")

package(default_visibility = ["//:__subpackages__"])

go_library(
    name = "broadcast",
    srcs = [
        "broadcast.go",
        "events.go",
    ],
    importpath = "xmanager_cloud/internal/broadcast",
    deps = [
        "//internal/logging",
        "@com_github_redis_go_redis_v9//:go-redis",
    ],
)

go_test(
    name = "broadcast_test",
    srcs = [
        "broadcast_test.go",
        "events_test.go",
    ],
    embed = [":broadcast"],
    deps = [
        "@com_github_google_go_cmp//cmp",
    ],
)
