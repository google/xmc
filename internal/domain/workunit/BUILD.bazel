load("//:compat.bzl", "compat_go_library", "compat_go_test")

package(default_visibility = ["//visibility:public"])

compat_go_library(
    name = "workunit",
    srcs = ["service.go"],
    importpath = "xmanager_cloud/internal/domain/workunit",
    deps = [
        "//api/protos/experiment:messages_go_proto",
        "//internal/compat/proto",
        "//internal/logging",
        "//internal/storage",
        "//internal/storage/state",
        "//internal/validator",
        "@org_golang_google_protobuf//types/known/timestamppb:go_default_library",
    ],
)

compat_go_test(
    name = "workunit_test",
    srcs = ["service_test.go"],
    embed = [":workunit"],
    deps = [
        "//api/protos/experiment:messages_go_proto",
        "//internal/compat/cmp",
        "//internal/compat/proto",
        "//internal/compat/protocmp",
        "//internal/storage",
    ],
)
