# gazelle:ignore
load("@io_bazel_rules_go//go:def.bzl", "go_library", "go_test")

go_library(
    name = "workunit",
    srcs = [
        "updateworkunitexecutions.go",
    ],
    importpath = "xmanager_cloud/internal/workunit",
    visibility = ["//:__subpackages__"],
    deps = [
        "//api/protos/experiment:messages_go_proto",
        "//internal/common/resourceaccumulator",
        "//internal/compat/field_mask",
        "//internal/compat/proto",
        "//internal/compat/status",
        "//internal/logging",
        "//internal/storage",
        "//internal/storage/data",
        "//internal/storage/state",
        "//internal/validator",
        "@com_github_kylelemons_godebug//diff",
        "@org_golang_google_protobuf//encoding/prototext:go_default_library",
        "@org_golang_google_protobuf//types/known/timestamppb:go_default_library",
    ],
)

go_test(
    name = "workunit_test",
    srcs = [
        "updateworkunitexecutions_test.go",
    ],
    embed = [":workunit"],
    shard_count = 4,
    deps = [
        "//api/protos/experiment:messages_go_proto",
        "//internal/compat/field_mask",
        "//internal/storage",
        "//internal/storage/spanner",
        "//internal/storage/spanner/emulator",
        "@org_golang_google_protobuf//types/known/timestamppb:go_default_library",
    ],
)
