load("@io_bazel_rules_go//go:def.bzl", "go_library", "go_test")

go_library(
    name = "dataengine",
    srcs = [
        "engine.go",
        "predicate.go",
        "provider.go",
        "querier.go",
        "series.go",
        "summary_box.go",
    ],
    importpath = "github.com/google/xmc/internal/dashboard/dataengine",
    visibility = ["//visibility:public"],
    deps = [
        "//api/protos/dashboard:api_go_proto",
        "//api/protos/dashboard:service_go_proto",
        "//internal/logging",
        "@com_github_clickhouse_clickhouse_go_v2//lib/driver",
        "@org_golang_google_protobuf//types/known/timestamppb",
        "@org_golang_x_sync//singleflight",
    ],
)

go_test(
    name = "dataengine_test",
    srcs = [
        "engine_test.go",
        "mock_test.go",
        "predicate_test.go",
        "provider_test.go",
        "series_test.go",
        "summary_box_test.go",
    ],
    embed = [":dataengine"],
    deps = [
        "//api/protos/dashboard:api_go_proto",
        "//api/protos/dashboard:service_go_proto",
        "@com_github_clickhouse_clickhouse_go_v2//lib/driver",
        "@org_golang_google_protobuf//types/known/timestamppb",
    ],
)
