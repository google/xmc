load("@io_bazel_rules_go//go:def.bzl", "go_library")
load("//:compat.bzl", "compat_go_library", "compat_go_test")

package(default_visibility = ["//visibility:public"])

go_library(
    name = "constants",
    srcs = ["constants/constants.go"],
    importpath = "xmanager_cloud/kubernetes/common/constants",
)

compat_go_library(
    name = "jobsetutil",
    srcs = ["jobsetutil/jobsetutil.go"],
    importpath = "xmanager_cloud/kubernetes/common/jobsetutil",
    deps = [
        "//api/protos/experiment:messages_go_proto",
        "//internal/compat/log",
        "@io_k8s_apimachinery//pkg/apis/meta/v1:meta",
        "@io_k8s_sigs_jobset//api/jobset/v1alpha2",
    ],
)

compat_go_test(
    name = "jobsetutil_test",
    srcs = ["jobsetutil/jobsetutil_test.go"],
    embed = [":jobsetutil"],
    deps = [
        "//api/protos/experiment:messages_go_proto",
        "//internal/compat/cmp",
        "@io_k8s_apimachinery//pkg/apis/meta/v1:meta",
        "@io_k8s_sigs_jobset//api/jobset/v1alpha2",
    ],
)
