load("@io_bazel_rules_go//go:def.bzl", "go_library")
load("//:compat.bzl", "compat_go_library", "compat_go_test")

package(default_visibility = ["//visibility:public"])

go_library(
    name = "constants",
    srcs = ["constants.go"],
    importpath = "xmanager_cloud/kubernetes/common/constants",
)

compat_go_library(
    name = "jobsetutil",
    srcs = ["jobsetutil.go"],
    importpath = "xmanager_cloud/kubernetes/common/jobsetutil",
    deps = [
        "//internal/compat/log",
        "//internal/kubernetes/api/v1alpha2",
        "@io_k8s_apimachinery//pkg/apis/meta/v1:meta",
    ],
)

compat_go_test(
    name = "jobsetutil_test",
    srcs = ["jobsetutil_test.go"],
    embed = [":jobsetutil"],
    deps = [
        "//internal/compat/cmp",
        "//internal/kubernetes/api/v1alpha2",
        "@io_k8s_apimachinery//pkg/apis/meta/v1:meta",
    ],
)
