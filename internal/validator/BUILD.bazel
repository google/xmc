load("@io_bazel_rules_go//go:def.bzl", "go_library", "go_test")

go_library(
    name = "validator",
    srcs = [
        "names.go",
        "parameters.go",
        "requests.go",
        "volumes.go",
    ],
    importpath = "xmanager_cloud/validator/validator",  # keep
    visibility = ["//:__subpackages__"],
    deps = [
        "//api/protos/experiment:api_go_proto",
        "//api/protos/experiment:messages_go_proto",
        "//api/protos/xid:api_go_proto",
        "//api/protos/xid:messages_go_proto",
        "//internal/compat/log",
        "//internal/compat/status",
        "//internal/kubernetes/common:jobsetutil",
    ],
)

go_test(
    name = "validator_test",
    srcs = [
        "names_test.go",
        "parameters_test.go",
        "requests_test.go",
        "volumes_test.go",
    ],
    embed = [":validator"],
    shard_count = 10,
    deps = [
        "//api/protos/experiment:api_go_proto",
        "//api/protos/experiment:messages_go_proto",
        "//api/protos/xid:api_go_proto",
        "//api/protos/xid:messages_go_proto",
        "//internal/compat/proto",
        "//internal/compat/status",
        "@com_github_google_go_cmp//cmp",
        "@org_golang_google_protobuf//testing/protocmp",
        "@org_golang_google_protobuf//types/known/fieldmaskpb",
        "@org_golang_google_protobuf//types/known/timestamppb",
    ],
)
