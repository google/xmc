    deps = [
        "//internal/compat/insecuresecretdataaccess:insecuresecretdataaccess",
        "//internal/compat/jwtkeyconverter:jwtkeyconverter",
        "@com_github_tink_crypto_tink_go_v2//jwt:jwt",
