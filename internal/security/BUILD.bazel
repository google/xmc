# gazelle:ignore
load("@io_bazel_rules_go//go:def.bzl", "go_library", "go_test")

go_library(
    name = "security",
    srcs = ["key_reloader.go"],
    importpath = "xmanager_cloud/internal/security",
    visibility = ["//visibility:public"],
    deps = [
        "//internal/compat/log",
        "//internal/compat/insecuresecretdataaccess:insecuresecretdataaccess",
