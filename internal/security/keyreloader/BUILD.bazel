load("@io_bazel_rules_go//go:def.bzl", "go_library", "go_test")

package(default_visibility = ["//visibility:public"])

go_library(
    name = "keyreloader",
    srcs = ["key_reloader.go"],
    importpath = "github.com/google/xmc/internal/security/keyreloader",
    deps = [
        "//internal/logging",
        "//internal/security/jwtkeyset",
        "@com_github_tink_crypto_tink_go_v2//jwt",
    ],
)

go_test(
    name = "keyreloader_test",
    srcs = ["key_reloader_test.go"],
    embed = [":keyreloader"],
    deps = [
        "//internal/security/jwtkeyset",
        "@com_github_tink_crypto_tink_go_v2//jwt",
    ],
)
