load("@io_bazel_rules_go//go:def.bzl", "go_library", "go_test")

go_library(
    name = "normalizer",
    srcs = [
        "lexer.go",
        "normalizer.go",
    ],
    importpath = "xmanager_cloud/internal/query_generator/normalizer",
    visibility = ["//:__subpackages__"],
    deps = [
        "//api/filter/go/filtervisitor",
        "//internal/query_generator:querytools",
    ],
)

go_test(
    name = "normalizer_test",
    srcs = ["normalizer_test.go"],
    embed = [":normalizer"],
    deps = [
        "//api/filter/go/filtervisitor",
        "//internal/query_generator:querytools",
    ],
)
