load("@io_bazel_rules_go//go:def.bzl", "go_library", "go_test")

package(default_visibility = ["//visibility:public"])

go_library(
    name = "querytools",
    srcs = [
        "query_generator.go",
        "query_generator_test_tables.go",
        "unnest.go",
    ],
    importpath = "xmanager_cloud/query_generator/querytools",
    deps = [
        ":equalityvisitor",
        "//api/filter:filter_expression_go_proto",
        "//api/filter/go/filtervisitor",
        "//api/filter/go/queryfilterbase",
        "//internal/compat/log",
        "//internal/compat/proto",
        "//internal/compat/safesql",
        "//internal/compat/spanner",
        "//internal/compat/status",
        "//internal/query_generator/filter",
    ],
)

go_library(
    name = "equalityvisitor",
    srcs = ["equalityvisitor.go"],
    importpath = "xmanager_cloud/query_generator/equalityvisitor",
    deps = [
        "//api/filter:filter_expression_go_proto",
        "//api/filter/go/filtervisitor",
        "//internal/logging",
    ],
)

go_library(
    name = "liststatement",
    srcs = ["liststatement.go"],
    importpath = "xmanager_cloud/query_generator/liststatement",
    deps = [
        ":querytools",
        "//api/filter:filter_expression_go_proto",
        "//api/filter/go/filter",
        "//internal/compat/safesql",
        "//internal/compat/spanner",
        "//internal/compat/status",
        "//internal/logging",
    ],
)

go_library(
    name = "predicate",
    srcs = ["predicate.go"],
    importpath = "xmanager_cloud/query_generator/predicate",
    deps = [
        "//api/filter:filter_expression_go_proto",
        "//api/filter/go/filtervisitor",
        "//internal/compat/proto",
    ],
)

go_test(
    name = "querytools_test",
    srcs = ["query_generator_test.go"],
    embed = [":querytools"],
    deps = [
        ":predicate",
        "//api/filter:filter_expression_go_proto",
        "//api/filter/go/filter",
        "//internal/compat/cmp",
        "//internal/compat/cmpopts",
        "//internal/compat/log",
        "//internal/compat/protocmp",
        "//internal/compat/safesql",
        "//internal/compat/spanner",
    ],
)

go_test(
    name = "equalityvisitor_test",
    srcs = ["equalityvisitor_test.go"],
    embed = [":equalityvisitor"],
    deps = [
        "//api/filter:filter_expression_go_proto",
        "//api/filter/go/filter",
        "//api/filter/go/filtervisitor",
        "//internal/compat/log",
    ],
)

go_test(
    name = "liststatement_test",
    srcs = ["liststatement_test.go"],
    embed = [":liststatement"],
    deps = [
        ":querytools",
        "//api/filter:filter_expression_go_proto",
        "//internal/compat/cmp",
        "//internal/compat/cmpopts",
        "//internal/compat/log",
        "//internal/compat/safesql",
        "//internal/compat/spanner",
        "//internal/compat/status",
    ],
)
