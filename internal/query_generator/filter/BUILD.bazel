load("@io_bazel_rules_go//go:def.bzl", "go_library", "go_test")

go_library(
    name = "filter",
    srcs = ["queryfilter.go"],
    importpath = "xmanager_cloud/internal/query_generator/filter",
    visibility = ["//:__subpackages__"],
    deps = [
        "//internal/compat/safesql",
        "@com_google_cloud_go_spanner//:spanner",
    ],
)

go_test(
    name = "filter_test",
    srcs = ["queryfilter_test.go"],
    embed = [":filter"],
    deps = [
        "//internal/compat/safesql",
        "//internal/compat/status",
        "@com_github_google_go_cmp//cmp",
        "@com_google_cloud_go_spanner//:spanner",
        "@org_golang_google_protobuf//proto",
    ],
)
