load("@io_bazel_rules_go//go:def.bzl", "go_library", "go_test")

package(default_visibility = ["//visibility:public"])

go_library(
    name = "redisclient",
    srcs = [
        "backlog.go",
        "common.go",
        "consumer.go",
        "fake.go",
        "publisher.go",
    ],
    importpath = "xmanager_cloud/internal/task_queue_redis/redisclient",
    deps = [
        "//internal/logging",
        "@com_github_redis_go_redis_v9//:go-redis",
    ],
)

go_test(
    name = "redisclient_test",
    srcs = [
        "backlog_test.go",
        "consumer_test.go",
        "fake_test.go",
        "publisher_test.go",
    ],
    embed = [":redisclient"],
    deps = [
        "@com_github_google_go_cmp//cmp",
        "@com_github_redis_go_redis_v9//:go-redis",
    ],
)
