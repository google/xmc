load("@io_bazel_rules_go//go:def.bzl", "go_binary", "go_library")

package(default_visibility = ["//visibility:private"])

go_library(
    name = "validator_lib",
    srcs = ["validator.go"],
    importpath = "xmanager_cloud/internal/task_queue_redis/validator",
    deps = [
        "//internal/compat/google",
        "//internal/logging",
        "//internal/task_queue_redis/redisclient",
        "@com_github_redis_go_redis_v9//:go-redis",
    ],
)

go_binary(
    name = "validator",
    embed = [":validator_lib"],
    visibility = ["//visibility:public"],
)
