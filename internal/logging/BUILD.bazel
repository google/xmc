load("@io_bazel_rules_go//go:def.bzl", "go_library", "go_test")

go_library(
    name = "logging",
    srcs = [
        "logging.go",
        "operation.go",
        "resources.go",
    ],
    importpath = "xmanager_cloud/internal/logging",
    importpath_aliases = ["xmanager_cloud/logging/logging"],  # keep
    visibility = ["//visibility:public"],
    deps = [
        # keep
        "//internal/kubernetes/common/constants",
        "//internal/compat/metadata",
        "//internal/compat/uuid",
        "//internal/validator",
    ],
)

go_test(
    name = "logging_test",
    srcs = [
        "logging_test.go",
        "operation_test.go",
        "resources_test.go",
    ],
    embed = [":logging"],
    deps = [
        "//internal/compat/cmp",
        "//internal/compat/metadata",
        "//internal/kubernetes/common/constants",
    ],
)
