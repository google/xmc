# gazelle:ignore
load("@io_bazel_rules_go//go:def.bzl", "go_library", "go_test")

go_library(
    name = "auth",
    srcs = [
        "auth.go",
        "authentication.go",
        "authorization.go",
        "test_utils.go",
    ],
    importpath = "xmanager_cloud/internal/auth",
    visibility = ["//visibility:public"],
    deps = [
        "//pkg/auth/oauth2",
        "//api/protos/xid:messages_go_proto",
        "//internal/compat/metadata",
        "//internal/compat/status",
        "//internal/logging",
        "@org_golang_google_api//cloudidentity/v1beta1:v1beta1",
        "@org_golang_google_api//idtoken",
        "@org_golang_google_api//option",
    ],
)

go_test(
    name = "auth_test",
    srcs = [
        "authentication_test.go",
        "authorization_test.go",
    ],
    embed = [":auth"],
    deps = [
        "//api/protos/xid:messages_go_proto",
        "//internal/compat/metadata",
        "@org_golang_google_api//idtoken",
    ],
)
