load("@io_bazel_rules_go//go:def.bzl", "go_library", "go_test")

go_library(
    name = "migrations",
    srcs = [
        "commands.go",
        "runner.go",
    ],
    importpath = "xmanager_cloud/internal/storage/migrations",
    visibility = ["//internal/storage:__subpackages__"],
    deps = [
        "//internal/logging",
        "@com_github_golang_migrate_migrate_v4//:migrate",
        "@com_github_golang_migrate_migrate_v4//source",
        "@com_github_golang_migrate_migrate_v4//source/iofs",
    ],
)

go_test(
    name = "migrations_test",
    size = "small",
    srcs = [
        "commands_test.go",
        "runner_test.go",
    ],
    embed = [":migrations"],
    deps = [
        "@com_github_golang_migrate_migrate_v4//:migrate",
        "@com_github_golang_migrate_migrate_v4//database",
        "@com_github_golang_migrate_migrate_v4//database/stub",
        "@com_github_golang_migrate_migrate_v4//source",
        "@com_github_golang_migrate_migrate_v4//source/stub",
        "@com_github_google_go_cmp//cmp",
    ],
)
