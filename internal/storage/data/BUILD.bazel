load("@io_bazel_rules_go//go:def.bzl", "go_library")
load("//:compat.bzl", "compat_go_library", "compat_go_test")

compat_go_library(
    name = "data",
    srcs = [
        "artifact.go",
        "bits.go",
        "experiment.go",
        "operation.go",
        "workunit.go",
        "workunitexecutions.go",
        "xid.go",
    ],
    importpath = "xmanager_cloud/internal/storage/data",
    visibility = ["//:__subpackages__"],
    deps = [
        "//api/protos/experiment:messages_go_proto",
        "//api/protos/xid:messages_go_proto",
        "//internal/compat/field_mask",
        "//internal/compat/longrunning",
        "//internal/compat/proto",
        "//internal/compat/status",
        "//internal/storage/state",
        "//internal/validator",
    ],
)

compat_go_test(
    name = "data_test",
    srcs = [
        "artifact_test.go",
        "bits_test.go",
        "experiment_test.go",
        "operation_test.go",
        "workunit_test.go",
        "workunitexecutions_test.go",
        "xid_test.go",
    ],
    embed = [":data"],
    deps = [
        "//api/protos/experiment:messages_go_proto",
        "//api/protos/xid:messages_go_proto",
        "//internal/compat/cmp",
        "//internal/compat/field_mask",
        "//internal/compat/longrunning",
        "//internal/compat/proto",
        "//internal/compat/protocmp",
        "@org_golang_google_genproto_googleapis_rpc//status",
        "@org_golang_google_protobuf//types/known/anypb:go_default_library",
        "@org_golang_google_protobuf//types/known/timestamppb:go_default_library",
    ],
)
