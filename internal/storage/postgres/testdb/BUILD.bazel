load("@io_bazel_rules_go//go:def.bzl", "go_library", "go_test")

genrule(
    name = "copy_ess_schema",
    srcs = ["//internal/storage/postgres/schema:ess-schema.sql"],
    outs = ["ess-schema.sql"],
    cmd = "cp $< $@",
)

genrule(
    name = "copy_xid_schema",
    srcs = ["//internal/storage/postgres/schema:xid-schema.sql"],
    outs = ["xid-schema.sql"],
    cmd = "cp $< $@",
)

go_library(
    name = "testdb",
    testonly = True,
    srcs = ["testdb.go"],
    embedsrcs = [
        "ess-schema.sql",
        "xid-schema.sql",
    ],
    importpath = "xmanager_cloud/internal/storage/postgres/testdb",
    visibility = ["//visibility:public"],
    deps = [
        "//internal/storage/postgres/migrations/version",
        "@com_github_jackc_pgx_v5//:pgx",
        "@com_github_jackc_pgx_v5//pgxpool",
        "@com_github_testcontainers_testcontainers_go//:testcontainers-go",
        "@com_github_testcontainers_testcontainers_go//wait",
    ],
)

go_test(
    name = "testdb_test",
    srcs = ["testdb_test.go"],
    embed = [":testdb"],
    tags = ["local"],
    deps = [
        "//internal/storage/postgres/migrations/version",
        "@com_github_google_go_cmp//cmp",
        "@com_github_jackc_pgx_v5//pgxpool",
    ],
)
