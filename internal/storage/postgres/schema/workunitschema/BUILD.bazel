load("@io_bazel_rules_go//go:def.bzl", "go_library", "go_test")

package(default_visibility = ["//visibility:public"])

go_library(
    name = "workunitschema",
    srcs = ["workunitschema.go"],
    importpath = "xmanager_cloud/internal/storage/postgres/schema/workunitschema",
    deps = [
        "//api/filter/go/filtervisitor",
        "//internal/query_generator/querytools",
        "//internal/safesql",
    ],
)

go_test(
    name = "workunitschema_test",
    srcs = ["workunitschema_test.go"],
    embed = [":workunitschema"],
    deps = [
        "//internal/query_generator/dialect/postgres",
        "//internal/query_generator/liststatement",
        "//internal/query_generator/normalizer",
        "//internal/query_generator/querytools",
        "@com_github_google_go_cmp//cmp",
    ],
)
