load("@io_bazel_rules_go//go:def.bzl", "go_library", "go_test")

go_library(
    name = "statushistory",
    srcs = ["repository.go"],
    importpath = "xmanager_cloud/internal/storage/postgres/statushistory",
    visibility = ["//:__subpackages__"],
    deps = [
        "//api/protos/experiment:messages_go_proto",
        "//internal/grpcerr",
        "//internal/safesql",
        "//internal/storage",
        "//internal/storage/postgres/data",
        "//internal/storage/postgres/pgdb",
        "@com_github_jackc_pgx_v5//pgxpool",
    ],
)

go_test(
    name = "statushistory_test",
    srcs = ["repository_test.go"],
    embed = [":statushistory"],
    tags = ["local"],
    deps = [
        "//api/protos/experiment:messages_go_proto",
        "//internal/storage",
        "//internal/storage/postgres/data",
        "//internal/storage/postgres/pgdb",
        "//internal/storage/postgres/testing",
        "@com_github_google_go_cmp//cmp",
        "@com_github_google_go_cmp//cmp/cmpopts",
        "@com_github_jackc_pgx_v5//:pgx",
        "@com_github_jackc_pgx_v5//pgtype",
        "@com_github_jackc_pgx_v5//pgxpool",
    ],
)
