load("@io_bazel_rules_go//go:def.bzl", "go_library", "go_test")

go_library(
    name = "pausestate",
    srcs = ["repository.go"],
    importpath = "xmanager_cloud/internal/storage/postgres/pausestate",
    visibility = ["//:__subpackages__"],
    deps = [
        "//internal/storage",
        "@org_golang_google_grpc//codes",
        "@org_golang_google_grpc//status",
    ],
)

go_test(
    name = "pausestate_test",
    srcs = ["repository_test.go"],
    embed = [":pausestate"],
    deps = [
        "//internal/storage",
        "@org_golang_google_grpc//codes",
        "@org_golang_google_grpc//status",
    ],
)
