load("@io_bazel_rules_go//go:def.bzl", "go_library", "go_test")

go_library(
    name = "testing",
    srcs = ["fake_storage.go"],
    importpath = "xmanager_cloud/internal/storage/testing",
    visibility = ["//:__subpackages__"],
    deps = [
        "//api/protos/experiment:messages_go_proto",
