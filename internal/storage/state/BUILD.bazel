load("@io_bazel_rules_go//go:def.bzl", "go_library")
load("//:compat.bzl", "compat_go_library", "compat_go_test")

compat_go_library(
    name = "state",
    srcs = ["state.go"],
    importpath = "xmanager_cloud/storage/state/state",
    visibility = ["//:__subpackages__"],
    deps = [
        "//api/protos/experiment:messages_go_proto",
        "//internal/compat/proto",
        "//internal/compat/status",
        "//internal/logging",
        "//internal/validator",
    ],
)

compat_go_test(
    name = "state_test",
    srcs = ["state_test.go"],
    embed = [":state"],
    deps = [
        "//api/protos/experiment:messages_go_proto",
        "//internal/compat/cmp",
        "//internal/compat/cmpopts",
        "//internal/compat/protocmp",
        "@org_golang_google_protobuf//types/known/timestamppb",
    ],
)
