load("@io_bazel_rules_go//go:def.bzl", "go_library", "go_test")

go_library(
    name = "storage",
    srcs = [
        "pause.go",
        "storage.go",
        "test_utils.go",
        "workunit_errors.go",
    ],
    importpath = "xmanager_cloud/internal/storage",
    visibility = ["//:__subpackages__"],
    deps = [
        "//api/protos/experiment:messages_go_proto",
        "//api/protos/task_queue:task_go_proto",
        "//api/protos/xid:messages_go_proto",
        "//internal/grpcerr",
        "@com_google_cloud_go_longrunning//autogen/longrunningpb",
        "@org_golang_google_protobuf//proto",
        "@org_golang_google_protobuf//types/known/fieldmaskpb",
    ],
)

go_test(
    name = "storage_test",
    srcs = ["workunit_errors_test.go"],
    embed = [":storage"],
    deps = [
        "//internal/grpcerr",
        "@com_github_google_go_cmp//cmp",
        "@org_golang_google_grpc//codes",
        "@org_golang_google_grpc//status",
    ],
)
