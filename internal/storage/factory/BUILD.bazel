load("@io_bazel_rules_go//go:def.bzl", "go_library", "go_test")

go_library(
    name = "factory",
    srcs = [
        "factory.go",
        "postgres.go",
        "spanner.go",
    ],
    importpath = "xmanager_cloud/internal/storage/factory",
    visibility = ["//:__subpackages__"],
    deps = [
        "//internal/common/health",
        "//internal/storage",
        "//internal/storage/dbconfig",
        "//internal/storage/postgres",
        "//internal/storage/postgres/migrations/version",
        "//internal/storage/spanner",
        "//internal/storage/spanner/migrations/version",
        "@com_google_cloud_go_spanner//:spanner",
        "@org_golang_google_api//option",
    ],
)

go_test(
    name = "factory_test",
    srcs = [
        "factory_test.go",
        "spanner_test.go",
    ],
    embed = [":factory"],
    deps = [
        "//internal/storage",
        "//internal/storage/dbconfig",
        "//internal/storage/postgres/migrations/version",
        "//internal/storage/spanner/emulator",
        "//internal/storage/spanner/migrations/version",
    ],
)

# The PostgreSQL test starts a database container through testcontainers, which needs Docker and
# therefore the "local" tag.
go_test(
    name = "factory_postgres_test",
    srcs = ["postgres_test.go"],
    embed = [":factory"],
    tags = ["local"],
    deps = [
        "//internal/storage/dbconfig",
        "//internal/storage/postgres/testing",
    ],
)
