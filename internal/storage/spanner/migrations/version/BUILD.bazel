load("@io_bazel_rules_go//go:def.bzl", "go_library")
load("//:compat.bzl", "compat_go_test")

genrule(
    name = "ess_version_gen",
    srcs = ["//internal/storage/spanner/migrations:ess_migrations"],
    outs = ["ess_version_gen.go"],
    cmd = "python3 $(location :generate_version.py) essMigrationVersion $@ $(SRCS)",
    tools = [":generate_version.py"],
)

genrule(
    name = "xid_version_gen",
    srcs = ["//internal/storage/spanner/migrations:xid_migrations"],
    outs = ["xid_version_gen.go"],
    cmd = "python3 $(location :generate_version.py) xidMigrationVersion $@ $(SRCS)",
    tools = [":generate_version.py"],
)

go_library(
    name = "version",
    srcs = [
        "version.go",
        ":ess_version_gen",
        ":xid_version_gen",
    ],
    importpath = "xmanager_cloud/internal/storage/spanner/migrations/version",
    visibility = ["//visibility:public"],
)

compat_go_test(
    name = "version_test",
    srcs = ["version_test.go"],
    embed = [":version"],
)
