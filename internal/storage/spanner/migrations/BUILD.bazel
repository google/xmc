load("@io_bazel_rules_go//go:def.bzl", "go_binary")
load("//:compat.bzl", "compat_go_library", "compat_go_test")

filegroup(
    name = "ess_migrations",
    srcs = glob(["ess/*.up.sql"]),
    visibility = ["//internal/storage/spanner/migrations:__subpackages__"],
)

filegroup(
    name = "xid_migrations",
    srcs = glob(["xid/*.up.sql"]),
    visibility = ["//internal/storage/spanner/migrations:__subpackages__"],
)

genrule(
    name = "copy_ess_messages",
    srcs = ["//api/protos/experiment:experiment_messages_descriptor"],
    outs = ["ess_messages.pb"],
    cmd = "cp $< $@",
)

genrule(
    name = "copy_xid_messages",
    srcs = ["//api/protos/xid:xid_messages_descriptor"],
    outs = ["xid_messages.pb"],
    cmd = "cp $< $@",
)

genrule(
    name = "copy_dashboard_messages",
    srcs = ["//api/protos/dashboard:dashboard_messages_descriptor"],
    outs = ["dashboard_messages.pb"],
    cmd = "cp $< $@",
)

compat_go_library(
    name = "migrations_lib",
    srcs = ["runner.go"],
    embedsrcs = glob([
        "ess/*.sql",
        "xid/*.sql",
    ]) + [
        ":ess_messages.pb",
        ":xid_messages.pb",
        ":dashboard_messages.pb",
    ],
    importpath = "xmanager_cloud/internal/storage/spanner/migrations",
    visibility = ["//visibility:private"],
    deps = [
        "//internal/compat/google",
        "//internal/compat/log",
        "//internal/compat/spanner",
        "//internal/storage/spanner/migrations/commands",
        "//internal/storage/spanner/migrations/driver",
        "@com_github_golang_migrate_migrate_v4//:go_default_library",
        "@com_github_golang_migrate_migrate_v4//source",
        "@com_github_golang_migrate_migrate_v4//source/iofs",
        "@com_google_cloud_go_spanner//:spanner",
        "@com_google_cloud_go_spanner//admin/database/apiv1",
        "@org_golang_google_api//option",
    ],
)

go_binary(
    name = "migrations",
    embed = [":migrations_lib"],
    visibility = ["//:__subpackages__"],
)

compat_go_test(
    name = "migrations_test",
    srcs = [
        "runner_test.go",
        "schema_consistency_test.go",
        "shared_test.go",
    ],
    embed = [":migrations_lib"],
    deps = [
        "//internal/compat/cmp",
        "//internal/compat/cmpopts",
        "//internal/storage/spanner/emulator",
        "//internal/storage/spanner/migrations/testing",
        "//internal/storage/spanner/migrations/version",
        "@com_github_golang_migrate_migrate_v4//source/iofs",
        "@com_google_cloud_go_spanner//:spanner",
        "@org_golang_google_api//option",
        "@org_golang_google_genproto//googleapis/spanner/admin/database/v1:database",
    ],
)
