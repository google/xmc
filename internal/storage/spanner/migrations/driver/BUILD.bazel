load("@io_bazel_rules_go//go:def.bzl", "go_library")
load("//:compat.bzl", "compat_go_library", "compat_go_test")

compat_go_library(
    name = "driver",
    srcs = ["spannerdriver.go"],
    importpath = "xmanager_cloud/internal/storage/spanner/migrations/driver",
    visibility = ["//:__subpackages__"],
    deps = [
        "//internal/compat/log",
        "//internal/compat/spanner",
        "//internal/storage/spanner/utils:spannerutils",
        "@com_github_golang_migrate_migrate_v4//database:database",
        "@com_github_golang_migrate_migrate_v4//database/spanner:spanner",
        "@com_google_cloud_go_spanner//admin/database/apiv1:apiv1",
        "@org_golang_google_genproto//googleapis/spanner/admin/database/v1:database",
    ],
)

compat_go_test(
    name = "driver_test",
    srcs = ["spannerdriver_test.go"],
    embed = [":driver"],
    deps = [
        "//internal/compat/proto",
        "//internal/compat/spanner",
        "//internal/storage/spanner/emulator",
        "@com_google_cloud_go_spanner//admin/database/apiv1:apiv1",
        "@com_google_cloud_go_spanner//admin/instance/apiv1:apiv1",
        "@org_golang_google_genproto//googleapis/spanner/admin/database/v1:database",
        "@org_golang_google_genproto//googleapis/spanner/admin/instance/v1:instance",
        "@org_golang_google_protobuf//reflect/protodesc:go_default_library",
        "@org_golang_google_protobuf//types/descriptorpb:go_default_library",
        "@org_golang_google_protobuf//types/known/emptypb:go_default_library",
    ],
)
