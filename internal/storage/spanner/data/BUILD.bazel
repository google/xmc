        "//internal/storage/data",
        "//internal/storage/spanner/schema:artifactschema",
        "//internal/storage/spanner/schema:experimentschema",
        "//internal/storage/spanner/schema:operationschema",
        "//internal/storage/spanner/schema:workunitschema",
        "//internal/storage/spanner/schema:xidschema",
        "@com_github_google_go_cmp//cmp",
        "@com_google_cloud_go_spanner//:spanner",
        "@org_golang_google_genproto_googleapis_rpc//status",
        "@org_golang_google_protobuf//proto",
        "@org_golang_google_protobuf//testing/protocmp",
        "@org_golang_google_protobuf//types/known/anypb",
