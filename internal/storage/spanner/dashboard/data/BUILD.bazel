load("@io_bazel_rules_go//go:def.bzl", "go_library", "go_test")

go_library(
    name = "data",
    srcs = ["dashboard.go"],
    importpath = "github.com/google/xmc/internal/storage/spanner/dashboard/data",
    visibility = ["//visibility:public"],
    deps = [
        "//api/protos/dashboard:messages_go_proto",
        "//internal/grpcerr",
        "//internal/storage/spanner/schema/dashboardschema",
        "//internal/validator",
        "@com_google_cloud_go_spanner//:spanner",
        "@org_golang_google_protobuf//proto",
        "@org_golang_google_protobuf//types/known/fieldmaskpb:go_default_library",
        "@org_golang_google_protobuf//types/known/timestamppb:go_default_library",
    ],
)

go_test(
    name = "data_test",
    srcs = ["dashboard_test.go"],
    embed = [":data"],
    deps = [
        "//api/protos/dashboard:messages_go_proto",
        "@com_google_cloud_go_spanner//:spanner",
        "@org_golang_google_protobuf//proto",
        "@org_golang_google_protobuf//types/known/fieldmaskpb:go_default_library",
        "@org_golang_google_protobuf//types/known/timestamppb:go_default_library",
    ],
)
