load("@io_bazel_rules_go//go:def.bzl", "go_library", "go_test")

go_library(
    name = "dashboard",
    srcs = [
        "chartplots.go",
        "createchart.go",
        "createdashboard.go",
        "deletechart.go",
        "deletedashboard.go",
        "getchart.go",
        "getdashboard.go",
        "listcharts.go",
        "listdashboards.go",
        "readrow.go",
        "repository.go",
        "updatechart.go",
        "updatedashboard.go",
    ],
    importpath = "xmanager_cloud/internal/storage/spanner/dashboard",
    visibility = ["//visibility:public"],
    deps = [
        "//api/filter:filter_expression_go_proto",
        "//api/filter/go/filter",
        "//api/protos/dashboard:messages_go_proto",
        "//internal/grpcerr",
        "//internal/logging",
        "//internal/query_generator/liststatement",
        "//internal/query_generator/normalizer",
        "//internal/query_generator/querytools",
        "//internal/storage/spanner/dashboard/data",
        "//internal/storage/spanner/schema/dashboardschema",
        "//internal/validator",
        "@com_google_cloud_go_spanner//:spanner",
        "@org_golang_google_api//iterator",
        "@org_golang_google_grpc//codes",
        "@org_golang_google_grpc//status",
        "@org_golang_google_protobuf//proto",
        "@org_golang_google_protobuf//types/known/fieldmaskpb:go_default_library",
        "@org_golang_google_protobuf//types/known/timestamppb:go_default_library",
    ],
)

go_test(
    name = "dashboard_test",
    srcs = [
        "chartplots_test.go",
        "createchart_test.go",
        "createdashboard_test.go",
        "deletechart_test.go",
        "deletedashboard_test.go",
        "getchart_test.go",
        "getdashboard_test.go",
        "listcharts_test.go",
        "listdashboards_test.go",
        "readrow_test.go",
        "test_utils.go",
        "updatechart_test.go",
        "updatedashboard_test.go",
    ],
    embed = [":dashboard"],
    # Shard across 4 parallel executors to divide heavy Spanner emulator database
    # setup, DDL schema creation, and live CRUD queries from ~45s down to ~12s.
    shard_count = 4,
    deps = [
        "//api/protos/dashboard:messages_go_proto",
        "//internal/grpcerr",
        "//internal/storage/spanner/dashboard/data",
        "//internal/storage/spanner/emulator",
        "//internal/storage/spanner/schema/dashboardschema",
        "@com_google_cloud_go_spanner//:spanner",
        "@org_golang_google_protobuf//types/known/fieldmaskpb:go_default_library",
        "@org_golang_google_protobuf//types/known/timestamppb:go_default_library",
    ],
)
