load("@io_bazel_rules_go//go:def.bzl", "go_library", "go_test")

go_library(
    name = "pausedtask",
    srcs = [
        "repository.go",
    ],
    importpath = "xmanager_cloud/internal/storage/spanner/pausedtask",
    visibility = ["//:__subpackages__"],
    deps = [
        "//internal/storage",
        "//internal/storage/data",
        "//internal/storage/spanner/data",
        "@com_github_google_uuid//:uuid",
        "@com_google_cloud_go_spanner//:spanner",
    ],
)

go_test(
    name = "pausedtask_test",
    srcs = [
        "repository_test.go",
    ],
    embed = [":pausedtask"],
    deps = [
        "//internal/storage",
        "//internal/storage/data",
        "//internal/storage/spanner",
        "//internal/storage/spanner/emulator",
        "@com_github_google_go_cmp//cmp",
        "@com_github_google_go_cmp//cmp/cmpopts",
        "@com_google_cloud_go_spanner//:spanner",
        "@org_golang_google_grpc//codes",
        "@org_golang_google_protobuf//encoding/prototext",
        "@org_golang_google_protobuf//proto",
        "@org_golang_google_protobuf//testing/protocmp",
    ],
)
