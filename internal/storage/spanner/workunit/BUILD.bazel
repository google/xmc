go_test(
    name = "workunit_unit_test",
    srcs = [
        "createworkunit_unit_test.go",
        "fetch_active_work_units_test.go",
    ],
    embed = [":workunit"],
    deps = [
        "//api/protos/experiment:messages_go_proto",
        "//internal/storage",
        "//internal/storage/spanner",
        "//internal/storage/spanner/emulator",
    ],
)

go_test(
    name = "workunit_test",
    srcs = [
        "createworkunit_test.go",
        "fetchcurrentworkunitexecution_test.go",
        "fetchnextworkunitid_test.go",
        "fetchworkunit_test.go",
        "listworkunitexecutions_test.go",
        "listworkunitmessages_test.go",
        "listworkunits_test.go",
        "repository_test.go",
        "updateworkunit_test.go",
    ],
    # Shard across 4 parallel executors to divide heavy Spanner emulator database
    # setup, DDL schema creation, and live CRUD queries from ~36s down to ~10s.
    shard_count = 4,
    deps = [
        "//api/protos/experiment:messages_go_proto",
        "//internal/domain/workunit",
        "//internal/grpcerr",
        "//internal/storage",
        "//internal/storage/spanner",
        "//internal/storage/spanner/emulator",
        "//internal/storage/spanner/utils",
        "//internal/storage/spanner/workunit",
        "//internal/validator",
        "@com_github_google_go_cmp//cmp",
        "@com_google_cloud_go_spanner//:spanner",
        "@org_golang_google_genproto_googleapis_rpc//status",
        "@org_golang_google_grpc//codes",
        "@org_golang_google_grpc//status",
        "@org_golang_google_protobuf//proto",
        "@org_golang_google_protobuf//testing/protocmp",
        "@org_golang_google_protobuf//types/known/fieldmaskpb",
        "@org_golang_google_protobuf//types/known/timestamppb",
    ],
)
