    importpath = "xmanager_cloud/internal/storage/spanner/workunit",
    visibility = ["//visibility:public"],
    deps = [
        "//api/protos/experiment:messages_go_proto",
        "//internal/domain/experiment",
        "//internal/grpcerr",
        "//internal/logging",
        "//internal/query_generator/liststatement",
        "//internal/query_generator/normalizer",
        "//internal/query_generator/querytools",
        "//internal/safesql",
        "//internal/storage",
        "//internal/storage/data",
        "//internal/storage/spanner/data",
        "//internal/storage/spanner/experiment",
        "//internal/storage/spanner/schema/workunitschema",
