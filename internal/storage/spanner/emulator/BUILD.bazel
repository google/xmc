# gazelle:ignore
load("@io_bazel_rules_go//go:def.bzl", "go_library", "go_test")

exports_files(
    [
        "ess_messages.pb",
        "xid_messages.pb",
    ],
    visibility = ["//visibility:public"],
)

genrule(
    name = "copy_ess_schema",
    srcs = ["//internal/storage/spanner/schema:ess-schema.sql"],
    outs = ["ess-schema.sql"],
    cmd = "cp $< $@",
)

genrule(
    name = "copy_xid_schema",
    srcs = ["//internal/storage/spanner/schema:xid-schema.sql"],
    outs = ["xid-schema.sql"],
    cmd = "cp $< $@",
)

go_library(
    name = "emulator",
    srcs = ["emulator.go"],
    embedsrcs = [
        ":ess-schema.sql",
        ":xid-schema.sql",
        "ess_messages.pb",
        "xid_messages.pb",
    ],
    importpath = "xmanager_cloud/internal/storage/spanner/emulator",
    visibility = ["//visibility:public"],
    deps = [
        "@com_google_cloud_go_spanner//:spanner",
        "@com_google_cloud_go_spanner//admin/database/apiv1:apiv1",
        "@com_google_cloud_go_spanner//admin/instance/apiv1:apiv1",
        "@org_golang_google_api//option:option",
        "//internal/storage/spanner/utils:spannerutils",
        "@org_golang_google_genproto//googleapis/spanner/admin/database/v1:database",
        "@org_golang_google_genproto//googleapis/spanner/admin/instance/v1:instance",
        "@org_golang_google_grpc//codes",
        "@org_golang_google_grpc//status",
    ],
)

go_test(
    name = "emulator_test",
    srcs = ["emulator_test.go"],
    embed = [":emulator"],
    deps = [
        "@com_google_cloud_go_spanner//:spanner",
        "@org_golang_google_api//iterator:iterator",
    ],
)
