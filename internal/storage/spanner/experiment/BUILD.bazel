        "//internal/experiment/experimenttest",
        "//internal/grpcerr",
        "//internal/storage",
        "//internal/storage/spanner",
        "//internal/storage/spanner/emulator",
        "//internal/storage/spanner/experiment",
        "//internal/storage/spanner/utils",
        "//internal/validator",
        "@com_github_google_go_cmp//cmp",
        "@com_google_cloud_go_spanner//:spanner",
        "@org_golang_google_protobuf//proto",
