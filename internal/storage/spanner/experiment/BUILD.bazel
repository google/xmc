load("@io_bazel_rules_go//go:def.bzl", "go_library", "go_test")

go_library(
    name = "experiment",
    srcs = [
        "driftdetection.go",
        "fetchexperiment.go",
        "fetchexperimentstatus.go",
        "insertexperiment.go",
        "listexperiments.go",
        "repository.go",
        "updateexperiment.go",
    ],
    importpath = "xmanager_cloud/internal/storage/spanner/experiment",
    visibility = ["//visibility:public"],
    deps = [
        "//api/protos/experiment:messages_go_proto",
        "//internal/grpcerr",
        "//internal/logging",
        "//internal/query_generator/dialect/spanner",
        "//internal/query_generator/liststatement",
        "//internal/query_generator/normalizer",
        "//internal/query_generator/querytools",
        "//internal/storage",
        "//internal/storage/data",
        "//internal/storage/spanner/data",
        "//internal/storage/spanner/schema/experimentschema",
        "//internal/storage/spanner/utils",
        "//internal/validator",
        "@com_github_kylelemons_godebug//diff",
        "@com_google_cloud_go_spanner//:spanner",
        "@org_golang_google_api//iterator",
        "@org_golang_google_grpc//codes",
        "@org_golang_google_grpc//status",
        "@org_golang_google_protobuf//encoding/prototext",
        "@org_golang_google_protobuf//proto",
        "@org_golang_google_protobuf//types/known/timestamppb",
    ],
)

go_test(
    name = "experiment_unit_test",
    srcs = ["updateexperiment_unit_test.go"],
    embed = [":experiment"],
    deps = [
        "//api/protos/experiment:messages_go_proto",
    ],
)

