# GCP Project ID
PROJECT_ID="your-gcp-project-id"

# GKE Cluster details
GKE_CLUSTER="your-gke-cluster-name"
K8S_NAMESPACE="xmc"
GCP_REGION="us-central1"

# XMC Domain/Endpoint config
XMC_DOMAIN="xmc.yourdomain.com"
XMC_ACR_TARGET="us-docker.pkg.dev/your-gcp-project-id/xmc"

# Setup environment name
XMANAGER_ENV="dev"

# URLs & endpoints
XMANAGER_UI_URL="https://${XMANAGER_ENV}.yourdomain.com"
XMANAGER_ENDPOINT="dns:///grpc.${XMANAGER_ENV}.yourdomain.com"

# IAP Client ID for authenticating backend requests
IAP_CLIENT_ID="your-oauth-iap-client-id.apps.googleusercontent.com"

# Service account client & registry configuration
XMC_CLIENT_SA="portal-sa-client@${PROJECT_ID}.iam.gserviceaccount.com"
XMC_REGISTRY="us-docker.pkg.dev/${PROJECT_ID}/xmc"
