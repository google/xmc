# =============================================================================
# XMC Local Configuration Template (.env.example)
#
# Copy this file to '.env' in the repository root to configure your environment.
# =============================================================================

# -----------------------------------------------------------------------------
# 1. OPTIONAL OVERRIDES (for upgrade_dev_env.sh)
# By default, the upgrade script reads these values directly from your
# Cluster Toolkit deployment YAML (deploy/ctk_v2/xmanager-cloud-deployment.yaml).
# Define them here ONLY if you want to temporarily override them locally.
# -----------------------------------------------------------------------------

# Override the GCP Project ID
#PROJECT_ID="your-gcp-project-id"

# Override the target GKE Cluster name
#GKE_CLUSTER="your-gke-cluster-name"

# Override the GCP region (default: us-central1)
#GCP_REGION="us-central1"

# Override the Kubernetes namespace (default: xmc)
#K8S_NAMESPACE="xmc"

# Override the environment name (default: dev)
#XMANAGER_ENV="dev"

# Override the Artifact Registry repository name (default: xmc)
#XMC_REGISTRY_NAME="xmc"


# -----------------------------------------------------------------------------
# 2. CLIENT CONFIGURATION (Required for XMC Client/CLI)
# Configure these variables to authenticate and connect using the XMC client.
# -----------------------------------------------------------------------------

# The base domain name used for your XMC deployment (e.g., "yourdomain.com").
# Used to derive UI and API endpoints.
XMC_BASE_DOMAIN="yourdomain.com"

# The OAuth Client ID for IAP (Identity-Aware Proxy) used to authenticate requests.
IAP_CLIENT_ID="your-oauth-iap-client-id.apps.googleusercontent.com"

# XMC Service Account used by the client.
XMC_CLIENT_SA="portal-sa-client@your-gcp-project-id.iam.gserviceaccount.com"


# -----------------------------------------------------------------------------
# 3. DERIVED CONFIGURATIONS (DO NOT EDIT)
# Used by various XMC tools to maintain consistency.
# -----------------------------------------------------------------------------

# Endpoints derived from the environment and base domain.
# These will use XMANAGER_ENV if set (defaults to 'dev' if not set in environment/YAML).
XMANAGER_UI_URL="https://${XMANAGER_ENV:-dev}.${XMC_BASE_DOMAIN}"
XMANAGER_ENDPOINT="dns:///grpc.${XMANAGER_ENV:-dev}.${XMC_BASE_DOMAIN}"
