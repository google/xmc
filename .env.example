# =============================================================================
# 1. REQUIRED USER INPUTS
# You MUST configure these variables with your specific GCP and XMC details.
# =============================================================================

# Your GCP Project ID where XMC is deployed.
PROJECT_ID="your-gcp-project-id"

# The name of your GKE cluster running XMC.
GKE_CLUSTER="your-gke-cluster-name"

# The Cluster Toolkit deployment name.
XMC_DEPLOYMENT_NAME="your-deployment-name"

# The base domain name used for your XMC deployment (e.g., "yourdomain.com").
# This is used to derive UI and API endpoints.
XMC_BASE_DOMAIN="yourdomain.com"

# The OAuth Client ID for IAP (Identity-Aware Proxy) used to authenticate requests.
IAP_CLIENT_ID="your-oauth-iap-client-id.apps.googleusercontent.com"

# XMC Service Account used by the client.
XMC_CLIENT_SA="portal-sa-client@${PROJECT_ID}.iam.gserviceaccount.com"

# =============================================================================
# 2. OPTIONAL CUSTOMIZATION & DEFAULTS
# These have sensible defaults but can be adjusted if your deployment differs.
# =============================================================================

# The Kubernetes namespace where XMC components are installed.
K8S_NAMESPACE="xmc"

# The GCP region where your cluster and resources reside.
GCP_REGION="us-central1"

# The environment name (e.g., "dev", "prod", "staging").
# Used to construct DNS subdomains.
XMANAGER_ENV="dev"

# The name of the Artifact Registry repository for XMC.
XMC_REGISTRY_NAME="xmc"


# =============================================================================
# 3. DERIVED CONFIGURATIONS (DO NOT EDIT)
# These variables are automatically constructed from the inputs above.
# They are grouped here to maintain compatibility with different tools
# while ensuring consistency.
# =============================================================================


# The full path to the Artifact Registry target.
# We set both to ensure compatibility with different tools that might look for either.
XMC_REGISTRY="us-docker.pkg.dev/${PROJECT_ID}/${XMC_REGISTRY_NAME}"
XMC_ACR_TARGET="${XMC_REGISTRY}"

# Endpoints derived from the environment and base domain.
XMANAGER_UI_URL="https://${XMANAGER_ENV}.${XMC_BASE_DOMAIN}"
XMANAGER_ENDPOINT="dns:///grpc.${XMANAGER_ENV}.${XMC_BASE_DOMAIN}"
