#!/usr/bin/env bash
set -e

echo "=== Running XMC Pre-Commit Linter Hooks ==="

# 1. Bazel Lint & Auto-Fix via buildifier
if which buildifier >/dev/null 2>&1 || [ -f "$HOME/go/bin/buildifier" ]; then
  echo "--> Running buildifier (Bazel formatter)..."
  BUILDIFIER_BIN="buildifier"
  [ -f "$HOME/go/bin/buildifier" ] && BUILDIFIER_BIN="$HOME/go/bin/buildifier"

  BAZEL_FILES=$(find . -type f \( -name "BUILD" -o -name "BUILD.bazel" -o -name "*.bzl" -o -name "WORKSPACE" -o -name "MODULE.bazel" \))
  if [ -n "$BAZEL_FILES" ]; then
    $BUILDIFIER_BIN -lint=fix -mode=fix $BAZEL_FILES
  fi
else
  echo "--> WARNING: buildifier not found. To install: go install github.com/bazelbuild/buildtools/buildifier@latest"
fi

# 2. Go Code Formatting & Linting
echo "--> Running Go code formatter & linter (via tools/lint.py)..."
STAGED_GO_FILES=$(git diff --cached --name-only --diff-filter=ACM | grep '\.go$' || true)

if [ -n "$STAGED_GO_FILES" ]; then
  if [ -x "./tools/lint.py" ]; then
    if ! ./tools/lint.py; then
      echo "--> WARNING: Go lint errors found. Please review them before pushing."
    fi
  else
    echo "--> ERROR: tools/lint.py not found or not executable."
    exit 1
  fi
else
  echo "    No staged Go files to lint."
fi

# 3. UI Code Formatting & Linting
STAGED_UI_FILES=$(git diff --cached --name-only --diff-filter=ACM | grep -E '^cmd/ui/.*\.(ts|html|scss)$' || true)

if [ -n "$STAGED_UI_FILES" ]; then
  # Run Prettier
  echo "--> Running UI Formatter (Prettier)..."
  PRETTIER_BIN="cmd/ui/node_modules/.bin/prettier"
  if [ -f "$PRETTIER_BIN" ]; then
    $PRETTIER_BIN --config cmd/ui/.prettierrc --write $STAGED_UI_FILES
  else
    echo "❌ ERROR: Local Prettier not found at $PRETTIER_BIN."
    echo "   To commit TS/HTML files, you must install dependencies: cd cmd/ui && npm install"
    exit 1
  fi

  # Run ESLint
  echo "--> Running UI Linter (ESLint)..."
  ESLINT_BIN="cmd/ui/node_modules/.bin/eslint"
  if [ -f "$ESLINT_BIN" ]; then
    $ESLINT_BIN --config cmd/ui/eslint.config.js --fix $STAGED_UI_FILES
  else
    echo "❌ ERROR: Local ESLint not found at $ESLINT_BIN."
    echo "   To commit TS/HTML files, you must install dependencies: cd cmd/ui && npm install"
    exit 1
  fi
else
  echo "    No staged UI files to format or lint."
fi

# 4. License Check via addlicense
ADDLICENSE_BIN=""
if which addlicense >/dev/null 2>&1; then
  ADDLICENSE_BIN="addlicense"
elif [ -f "$HOME/go/bin/addlicense" ]; then
  ADDLICENSE_BIN="$HOME/go/bin/addlicense"
else
  echo "--> WARNING: addlicense not found. License check skipped."
  echo "    To install: go install github.com/google/addlicense@latest"
fi

STAGED_FILES=$(git diff --cached --name-only --diff-filter=ACMR)
if [ -n "$ADDLICENSE_BIN" ] && [ -n "$STAGED_FILES" ]; then
  echo "--> Running addlicense to auto-add missing headers..."
  $ADDLICENSE_BIN -c "Google LLC" -l apache \
      -ignore "third_party/**" \
      -ignore "**/third_party/**" \
      $STAGED_FILES
fi

# 5. Python Code Formatting & Linting (PEP 8)
STAGED_PYTHON_FILES=$(git diff --cached --name-only --diff-filter=ACM | grep -E '\.py$' || true)
if [ -n "$STAGED_PYTHON_FILES" ]; then
  echo "--> Running Python Linter & Formatter (Ruff)..."
  if which ruff >/dev/null 2>&1; then
    ruff check --fix $STAGED_PYTHON_FILES
    ruff format $STAGED_PYTHON_FILES
  elif which docker >/dev/null 2>&1; then
    echo "--> Running Ruff via Docker container..."
    docker run --rm -v "$(pwd):/io" -w /io ghcr.io/astral-sh/ruff:latest check --fix $STAGED_PYTHON_FILES
    docker run --rm -v "$(pwd):/io" -w /io ghcr.io/astral-sh/ruff:latest format $STAGED_PYTHON_FILES
  elif which flake8 >/dev/null 2>&1; then
    flake8 $STAGED_PYTHON_FILES
  else
    echo "--> WARNING: ruff/flake8/docker not found. Python linting skipped locally."
    echo "    To install: pip install ruff"
  fi
else
  echo "    No staged Python files to format or lint."
fi

# Check if the linters modified any un-staged files
if ! git diff --quiet; then
  echo ""
  echo "❌ PRE-COMMIT HOOK FAILED: Linters automatically fixed formatting issues in your code!"
  echo "   Please review the modified files (git diff), stage them (git add -u), and re-run git commit."
  exit 1
fi

echo "=== ✅ All pre-commit checks passed! ==="
