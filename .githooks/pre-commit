#!/usr/bin/env bash
set -euo pipefail

MODE="fix"
if [ "${1:-}" = "--check" ]; then
  MODE="check"
fi

echo "=== Running XMC Pre-Commit Linter Hooks (Mode: ${MODE}) ==="
FAILED=0
AUTOSTAGE_STATE=""

# Succeeds when a staged path whose status is in <diff-filter> matches <ERE>.
# --no-renames reports a rename as a delete of the old path plus an add of the
# new one, so filter D also matches paths renamed away. Cross-file gates (whose
# result depends on files other than the edited ones) include D so they also run
# when a staged delete or rename removes a file that other files depend on.
# core.quotePath=false keeps non-ASCII paths unquoted so anchored patterns match.
staged_paths_match() {
  local diff_filter="$1" pattern="$2" paths
  paths=$(git -c core.quotePath=false diff --cached --name-only --no-renames --diff-filter="${diff_filter}")
  if [ -z "${paths}" ]; then
    return 1
  fi
  grep -qE -- "${pattern}" <<<"${paths}"
}

check_bazel() {
  local buildifier_bin=""
  if command -v buildifier >/dev/null 2>&1; then
    buildifier_bin="buildifier"
  elif [ -f "$HOME/go/bin/buildifier" ]; then
    buildifier_bin="$HOME/go/bin/buildifier"
  fi

  if [ -z "$buildifier_bin" ]; then
    echo "--> WARNING: buildifier not found. To install: go install github.com/bazelbuild/buildtools/buildifier@latest"
    if [ "$MODE" = "check" ]; then FAILED=1; fi
    return
  fi

  echo "--> Running Bazel Formatter & Linter (Buildifier)..."
  local bazel_files
  bazel_files=$(find . -type f \( -name "BUILD" -o -name "BUILD.bazel" -o -name "*.bzl" -o -name "WORKSPACE" -o -name "MODULE.bazel" \) -not -path "*/node_modules/*")
  if [ -n "$bazel_files" ]; then
    if [ "$MODE" = "check" ]; then
      if ! $buildifier_bin -lint=warn -warnings=unused-variable -mode=check $bazel_files; then
        echo "❌ Bazel buildifier check failed."
        FAILED=1
      fi
    else
      $buildifier_bin -lint=fix -warnings=unused-variable -mode=fix $bazel_files
    fi
  fi
}

check_go() {
  if command -v gofmt >/dev/null 2>&1; then
    echo "--> Running Go Formatter (gofmt)..."
    local unformatted_go
    unformatted_go=$(gofmt -s -l . 2>/dev/null | grep -v 'vendor/' || true)
    if [ -n "$unformatted_go" ]; then
      echo "❌ Unformatted Go files found:"
      echo "$unformatted_go"
      # Fix mode rewrites these files below; restage_fixes decides whether the
      # rewrite can be staged automatically or must fail the hook.
      if [ "$MODE" = "check" ]; then FAILED=1; fi
    fi

    if [ "$MODE" = "fix" ]; then
      find . -type f -name "*.go" -not -path "*/vendor/*" -exec gofmt -s -w {} +
    fi
  fi

  local go_bin_dir=""
  if [ -n "${GOBIN:-}" ]; then
    go_bin_dir="$GOBIN"
  elif [ -n "${GOPATH:-}" ]; then
    go_bin_dir="${GOPATH%%:*}/bin"
  elif command -v go >/dev/null 2>&1; then
    local gopath_env
    gopath_env=$(go env GOPATH 2>/dev/null || true)
    if [ -n "$gopath_env" ]; then
      go_bin_dir="${gopath_env%%:*}/bin"
    else
      go_bin_dir="$HOME/go/bin"
    fi
  else
    go_bin_dir="$HOME/go/bin"
  fi

  local golangci_bin=""
  if command -v golangci-lint >/dev/null 2>&1; then
    golangci_bin="golangci-lint"
  elif [ -f "$go_bin_dir/golangci-lint" ]; then
    golangci_bin="$go_bin_dir/golangci-lint"
  fi

  if [ -n "$golangci_bin" ]; then
    echo "--> Running Golang Linter (golangci-lint)..."
    if [ "$MODE" = "check" ]; then
      if ! $golangci_bin run; then
        echo "❌ golangci-lint check failed."
        FAILED=1
      fi
    else
      if ! $golangci_bin run --fix; then
        echo "❌ golangci-lint run --fix failed or found unfixed issues."
        FAILED=1
      fi
    fi
  else
    echo "--> WARNING: golangci-lint not found. Go linting skipped."
    echo "   To install: go install github.com/golangci/golangci-lint/cmd/golangci-lint@v1.64.6"
    if [ "$MODE" = "check" ]; then FAILED=1; fi
  fi

  if [ -d "tools/lint/check_go_determinism" ]; then
    echo "--> Running Go Test Determinism & State Leakage Checker..."
    if ! go run ./tools/lint/check_go_determinism; then
      FAILED=1
    fi
  fi

  if command -v go >/dev/null 2>&1; then
    echo "--> Checking Go Module Dependencies (go mod tidy)..."
    if [ "$MODE" = "check" ]; then
      if ! go mod tidy -diff >/dev/null 2>&1; then
        echo "❌ Unused or missing Go module dependencies found. Run 'go mod tidy' to sync."
        FAILED=1
      fi
    else
      go mod tidy
    fi
  fi
}

check_legacy_imports() {
  echo "--> Running google3 Legacy Import Ratchet..."
  local baseline="tools/lint/legacy_imports_baseline.json"
  if ! XMC_BYPASS_VENV=1 python3 tools/lint/check_legacy_imports.py >/dev/null; then
    echo "❌ google3 legacy import ratchet failed (see JSON error above)."
    FAILED=1
    return
  fi
  if [ "$MODE" = "fix" ]; then
    # Lower the baseline when counts dropped (the tool never raises counts) and
    # stage it so the reduction is recorded in this commit.
    XMC_BYPASS_VENV=1 python3 tools/lint/check_legacy_imports.py --update-baseline >/dev/null
    if ! git diff --quiet -- "${baseline}"; then
      git add -- "${baseline}"
      echo "--> Lowered and staged ${baseline}."
    fi
  fi
}

check_examples_coverage() {
  echo "--> Checking Nightly E2E Verification Coverage for examples/..."
  if ! XMC_BYPASS_VENV=1 python3 tools/nightly_tests/check_examples_coverage.py >/dev/null; then
    echo "❌ Nightly examples verification coverage check failed."
    FAILED=1
  fi
}

check_agent_doc_paths() {
  # In fix mode, only run when agent docs are staged, or when staged deletes or
  # renames could orphan a path an agent doc references, to keep the hook fast.
  if [ "${MODE}" = "fix" ] && ! staged_paths_match AM '^\.agents/.*\.md$|(^|/)AGENTS\.md$' && ! staged_paths_match D '.'; then
    return
  fi
  echo "--> Checking Agent Doc Path References..."
  if ! XMC_BYPASS_VENV=1 python3 tools/lint/check_agent_doc_paths.py >/dev/null; then
    echo "❌ Agent docs reference non-existent repository paths (see JSON error above)."
    FAILED=1
  fi
}


check_ui() {
  local ui_files
  if [ "$MODE" = "check" ]; then
    ui_files=$(find cmd/ui -type f \( -name "*.ts" -o -name "*.html" -o -name "*.scss" \) -not -path "*/node_modules/*" -not -path "*/.angular/*" || true)
  else
    ui_files=$(git diff --cached --name-only --diff-filter=ACM | grep -E '^cmd/ui/.*\.(ts|html|scss)$' || true)
  fi

  if [ -z "$ui_files" ]; then
    return
  fi

  local prettier_bin="cmd/ui/node_modules/.bin/prettier"
  local eslint_bin="cmd/ui/node_modules/.bin/eslint"

  if [ -f "$prettier_bin" ]; then
    echo "--> Running UI Formatter (Prettier)..."
    if [ "$MODE" = "check" ]; then
      if ! $prettier_bin --config cmd/ui/.prettierrc --check $ui_files; then
        echo "❌ Prettier check failed."
        FAILED=1
      fi
    else
      $prettier_bin --config cmd/ui/.prettierrc --write $ui_files
    fi
  else
    echo "❌ ERROR: Local Prettier not found at $prettier_bin."
    echo "   Please install dependencies: cd cmd/ui && npm ci --legacy-peer-deps"
    if [ "$MODE" = "check" ]; then FAILED=1; fi
  fi

  if [ -f "$eslint_bin" ]; then
    echo "--> Running UI Linter (ESLint)..."
    if [ "$MODE" = "check" ]; then
      if ! $eslint_bin --config cmd/ui/eslint.config.js $ui_files; then
        echo "❌ ESLint check failed."
        FAILED=1
      fi
    else
      $eslint_bin --config cmd/ui/eslint.config.js --fix $ui_files
    fi
  else
    echo "❌ ERROR: Local ESLint not found at $eslint_bin."
    echo "   Please install dependencies: cd cmd/ui && npm ci --legacy-peer-deps"
    if [ "$MODE" = "check" ]; then FAILED=1; fi
  fi
}

check_license() {
  local addlicense_bin=""
  if command -v addlicense >/dev/null 2>&1; then
    addlicense_bin="addlicense"
  elif [ -f "$HOME/go/bin/addlicense" ]; then
    addlicense_bin="$HOME/go/bin/addlicense"
  fi

  if [ -z "$addlicense_bin" ]; then
    echo "--> WARNING: addlicense not found. License check skipped."
    if [ "$MODE" = "check" ]; then FAILED=1; fi
    return
  fi

  echo "--> Running License Header Check (addlicense)..."
  local ignores=(
    -ignore "**/node_modules/**"
    -ignore "**/.angular/**"
    -ignore "**/dist/**"
    -ignore "**/venv/**"
    -ignore "**/ctk-out/**"
    -ignore "**.json"
    -ignore "**.lock"
    -ignore "pyproject.toml"
    -ignore "package.json"
    -ignore "go.mod"
    -ignore "go.sum"
  )

  if [ "$MODE" = "check" ]; then
    if ! $addlicense_bin -check -c "Google LLC" -l apache "${ignores[@]}" .; then
      echo "❌ License header check failed."
      FAILED=1
    fi
  else
    local staged_files
    staged_files=$(git diff --cached --name-only --diff-filter=ACMR || true)
    if [ -n "$staged_files" ]; then
      $addlicense_bin -c "Google LLC" -l apache "${ignores[@]}" $staged_files
    fi
  fi
}

check_python() {
  local py_files
  if [ "$MODE" = "check" ]; then
    py_files=$(find . -type f -name "*.py" -not -path "*/node_modules/*" -not -path "*/.git/*" -not -path "*/venv/*" -not -path "*/ctk-out/*" || true)
  else
    py_files=$(git diff --cached --name-only --diff-filter=ACM | grep -E '\.py$' || true)
  fi

  if [ -z "$py_files" ]; then
    return
  fi

  local ruff_bin=""
  if command -v ruff >/dev/null 2>&1; then
    ruff_bin="ruff"
  elif [ -f "$HOME/.local/bin/ruff" ]; then
    ruff_bin="$HOME/.local/bin/ruff"
  fi

  if [ -n "$ruff_bin" ]; then
    echo "--> Running Python Linter & Formatter (Ruff)..."
    if [ "$MODE" = "check" ]; then
      if ! $ruff_bin check $py_files; then
        echo "❌ Ruff lint check failed."
        FAILED=1
      fi
      if ! $ruff_bin format --check $py_files; then
        echo "❌ Ruff format check failed."
        FAILED=1
      fi
    else
      $ruff_bin check --fix $py_files
      $ruff_bin format $py_files
    fi
  elif command -v docker >/dev/null 2>&1; then
    echo "--> Running Ruff via Docker container..."
    if [ "$MODE" = "check" ]; then
      if ! docker run --rm --user "$(id -u):$(id -g)" -e HOME=/tmp -v "$(pwd):/io" -w /io ghcr.io/astral-sh/ruff:latest check --no-cache $py_files; then FAILED=1; fi
      if ! docker run --rm --user "$(id -u):$(id -g)" -e HOME=/tmp -v "$(pwd):/io" -w /io ghcr.io/astral-sh/ruff:latest format --check --no-cache $py_files; then FAILED=1; fi
    else
      docker run --rm --user "$(id -u):$(id -g)" -e HOME=/tmp -v "$(pwd):/io" -w /io ghcr.io/astral-sh/ruff:latest check --fix --no-cache $py_files
      docker run --rm --user "$(id -u):$(id -g)" -e HOME=/tmp -v "$(pwd):/io" -w /io ghcr.io/astral-sh/ruff:latest format --no-cache $py_files
    fi


  else
    echo "--> WARNING: ruff or docker not found. Python linting skipped."
    if [ "$MODE" = "check" ]; then FAILED=1; fi
  fi
}

check_mypy() {
  # mypy is cross-module: an edit, delete or rename can break unchanged
  # importers, so fix mode runs it whenever a Python file is staged, deleted or
  # renamed. [tool.mypy] in pyproject.toml defines the checked files, as in CI.
  if [ "${MODE}" = "fix" ] && ! staged_paths_match AMD '\.py$'; then
    return
  fi

  local mypy_cmd=()
  if [ -f "./tools/common/venv/bin/mypy" ]; then
    mypy_cmd=("./tools/common/venv/bin/mypy")
  elif [ -f "./tools/venv/bin/mypy" ]; then
    mypy_cmd=("./tools/venv/bin/mypy")
  elif command -v mypy >/dev/null 2>&1; then
    mypy_cmd=("mypy")
  elif [ -f "${HOME}/.local/bin/mypy" ]; then
    mypy_cmd=("${HOME}/.local/bin/mypy")
  elif python3 -m mypy --version >/dev/null 2>&1; then
    mypy_cmd=("python3" "-m" "mypy")
  fi

  if [ "${#mypy_cmd[@]}" -eq 0 ]; then
    echo "--> mypy not found; attempting automatic installation into ./tools/common/venv..."
    if [ ! -x "./tools/common/venv/bin/pip" ]; then
      python3 -m venv ./tools/common/venv >/dev/null 2>&1 || true
    fi
    if [ -x "./tools/common/venv/bin/pip" ] && ./tools/common/venv/bin/pip install --quiet mypy >/dev/null 2>&1; then
      mypy_cmd=("./tools/common/venv/bin/mypy")
    fi
  fi

  if [ "${#mypy_cmd[@]}" -gt 0 ]; then
    echo "--> Running Mypy Static Type Checker..."
    if ! "${mypy_cmd[@]}"; then
      echo "❌ Mypy type check failed."
      FAILED=1
    fi
  else
    echo "❌ ERROR: mypy not found and automatic installation failed. Install mypy (e.g. 'pip install mypy') to proceed."
    FAILED=1
  fi
}

check_terraform() {
  local tf_files
  if [ "$MODE" = "check" ]; then
    tf_files=$(find deploy -type f -name "*.tf" || true)
  else
    tf_files=$(git diff --cached --name-only --diff-filter=ACM | grep -E '\.tf$' || true)
  fi

  if [ -z "$tf_files" ]; then
    return
  fi

  echo "--> Running Terraform Formatter (terraform fmt)..."
  if command -v terraform >/dev/null 2>&1; then
    if [ "$MODE" = "check" ]; then
      if ! terraform fmt -check $tf_files; then
        echo "❌ Terraform formatting check failed."
        FAILED=1
      fi
    else
      terraform fmt $tf_files || true
    fi
  elif command -v docker >/dev/null 2>&1; then
    if [ "$MODE" = "check" ]; then
      if ! docker run --rm -v "$(pwd):/workspace" -w /workspace hashicorp/terraform:latest fmt -check $tf_files; then
        echo "❌ Terraform formatting check failed."
        FAILED=1
      fi
    else
      docker run --rm -v "$(pwd):/workspace" -w /workspace hashicorp/terraform:latest fmt $tf_files || true
    fi
  else
    echo "--> WARNING: terraform or docker not found. Terraform formatting check skipped."
    if [ "$MODE" = "check" ]; then FAILED=1; fi
  fi
}

check_tflint() {
  # TFLint lints whole modules, so fix mode also runs it when a staged delete or
  # rename removes a .tf file that the remaining module files depend on.
  if [ "${MODE}" = "check" ]; then
    if [ -z "$(find deploy -type f -name "*.tf" || true)" ]; then return; fi
  elif ! staged_paths_match AMD '\.tf$'; then
    return
  fi

  echo "--> Running Terraform Linter (TFLint)..."
  if command -v tflint >/dev/null 2>&1; then
    tflint --init >/dev/null 2>&1 || true
    if ! tflint --recursive; then
      echo "❌ TFLint check failed."
      FAILED=1
    fi
  elif command -v docker >/dev/null 2>&1; then
    if ! docker run --rm -v "$(pwd):/data" -w /data --entrypoint sh ghcr.io/terraform-linters/tflint:latest -c "tflint --init >/dev/null 2>&1 && tflint --recursive"; then
      echo "❌ TFLint check failed."
      FAILED=1
    fi
  else
    echo "--> WARNING: tflint or docker not found. TFLint check skipped."
    if [ "$MODE" = "check" ]; then FAILED=1; fi
  fi
}

check_helm() {
  # helm lint covers the whole chart, so fix mode runs it for any staged add,
  # modify, delete or rename under deploy/helm/.
  if [ "${MODE}" = "check" ]; then
    if [ -z "$(find deploy/helm -type f \( -name "*.yaml" -o -name "*.yml" \) || true)" ]; then return; fi
  elif ! staged_paths_match AMD '^deploy/helm/'; then
    return
  fi

  if command -v helm >/dev/null 2>&1; then
    echo "--> Running Helm Chart Linter (helm lint)..."
    if ! helm lint deploy/helm; then
      echo "❌ Helm lint failed."
      FAILED=1
    fi
  else
    echo "--> WARNING: helm not found. Helm chart linting skipped."
    if [ "$MODE" = "check" ]; then FAILED=1; fi
  fi
}

check_security() {
  # Trivy scans all of deploy/, so fix mode runs it for any staged add, modify,
  # delete or rename under deploy/.
  if [ "${MODE}" = "check" ]; then
    if [ -z "$(find deploy -type f \( -name "*.tf" -o -name "*.tfvars" -o -name "*.yaml" -o -name "*.yml" \) || true)" ]; then return; fi
  elif ! staged_paths_match AMD '^deploy/'; then
    return
  fi

  echo "--> Running Infrastructure & Workload Security Scanner (Trivy)..."
  if command -v trivy >/dev/null 2>&1; then
    if ! trivy config --skip-check-update --severity HIGH,CRITICAL deploy/; then
      echo "❌ Trivy security check failed."
      FAILED=1
    fi
  elif command -v docker >/dev/null 2>&1; then
    if ! docker run --rm -v "$(pwd):/src" -w /src aquasec/trivy:latest config --skip-check-update --severity HIGH,CRITICAL deploy/; then
      echo "❌ Trivy security check failed."
      FAILED=1
    fi
  else
    echo "--> WARNING: trivy or docker not found. Security check skipped."
    if [ "$MODE" = "check" ]; then FAILED=1; fi
  fi
}

check_affected_tests() {
  echo "--> Running Affected Bazel Unit Tests..."
  local lockfile_was_clean=0
  if git diff --quiet -- MODULE.bazel.lock 2>/dev/null; then
    lockfile_was_clean=1
  fi
  # Pass --skip-emulator-check because run_affected_tests.py probes the Spanner
  # emulator port whenever any Bazel target is in scope. Skipping the pre-flight
  # port probe lets commits whose affected tests do not use Spanner pass without
  # a running emulator container, while tests that actually dial Spanner still
  # fail closed inside bazel test.
  if ! XMC_BYPASS_VENV=1 python3 ./tools/run_affected_tests.py --skip-emulator-check >/dev/null; then
    echo "❌ Affected Bazel unit tests failed."
    FAILED=1
  fi
  # Restore MODULE.bazel.lock if Bazel updated it as a side effect when it had
  # no unstaged changes before the hook ran.
  if [ "${lockfile_was_clean}" -eq 1 ]; then
    git checkout -- MODULE.bazel.lock 2>/dev/null || true
  fi
}

# Fix mode stages formatter fixes to fully staged files unless
# XMC_PRECOMMIT_NO_AUTOSTAGE=1 restores the manual restage workflow.
autostage_enabled() {
  [ "${MODE}" = "fix" ] && [ "${XMC_PRECOMMIT_NO_AUTOSTAGE:-0}" != "1" ]
}

snapshot_staging() {
  if ! autostage_enabled; then
    return
  fi
  AUTOSTAGE_STATE=$(mktemp)
  trap 'rm -f "${AUTOSTAGE_STATE}"' EXIT
  XMC_BYPASS_VENV=1 python3 tools/lint/precommit_autostage.py snapshot --state "${AUTOSTAGE_STATE}" >/dev/null
}

restage_fixes() {
  if [ "${MODE}" != "fix" ]; then
    return
  fi
  if autostage_enabled; then
    if ! XMC_BYPASS_VENV=1 python3 tools/lint/precommit_autostage.py restage --state "${AUTOSTAGE_STATE}" >/dev/null; then
      echo ""
      echo "❌ PRE-COMMIT HOOK FAILED: Linters fixed files that were not fully staged (see \"blocked\" above)."
      echo "   Please review the modified files (git diff), stage them, and re-run git commit."
      exit 1
    fi
    return
  fi
  if ! git diff --quiet; then
    echo ""
    echo "❌ PRE-COMMIT HOOK FAILED: Linters automatically fixed formatting issues in your code!"
    echo "   Please review the modified files (git diff), stage them (git add -u), and re-run git commit."
    exit 1
  fi
}

# Returns success when files are staged and all are Markdown or under docs/,
# which resolve_test_scope.py classifies as non-code.
staged_docs_only() {
  local staged
  staged=$(git diff --cached --name-only)
  [ -n "${staged}" ] && ! grep -qvE '(\.md$|^docs/)' <<<"${staged}"
}

main() {
  snapshot_staging
  check_bazel
  check_go
  check_legacy_imports
  check_examples_coverage
  check_agent_doc_paths
  check_ui
  check_license
  check_python
  check_mypy
  check_terraform
  check_tflint
  check_helm
  check_security

  restage_fixes

  if [ "$FAILED" -ne 0 ]; then
    echo "=== ❌ Linter checks failed! ==="
    exit 1
  fi

  if [ "$MODE" = "fix" ] && staged_docs_only; then
    echo "--> Skipping Affected Bazel Unit Tests: every staged path is documentation."
  else
    check_affected_tests
  fi
  if [ "$FAILED" -ne 0 ]; then
    echo "=== ❌ Pre-commit checks failed! ==="
    exit 1
  fi

  echo "=== ✅ All pre-commit checks passed! ==="
}

main "$@"
