#!/usr/bin/env bash
set -euo pipefail

MODE="fix"
if [ "${1:-}" = "--check" ]; then
  MODE="check"
fi

echo "=== Running XMC Pre-Commit Linter Hooks (Mode: ${MODE}) ==="
FAILED=0

check_bazel() {
  local buildifier_bin=""
  if command -v buildifier >/dev/null 2>&1; then
    buildifier_bin="buildifier"
  elif [ -f "$HOME/go/bin/buildifier" ]; then
    buildifier_bin="$HOME/go/bin/buildifier"
  fi

  if [ -z "$buildifier_bin" ]; then
    echo "--> WARNING: buildifier not found. To install: go install github.com/bazelbuild/buildtools/buildifier@latest"
    if [ "$MODE" = "check" ]; then FAILED=1; fi
    return
  fi

  echo "--> Running Bazel Formatter & Linter (Buildifier)..."
  local bazel_files=()
  while IFS= read -r -d "" file; do
    bazel_files+=("$file")
  done < <(find . -type f \( -name "BUILD" -o -name "BUILD.bazel" -o -name "*.bzl" -o -name "WORKSPACE" -o -name "MODULE.bazel" \) -not -path "*/node_modules/*" -print0 2>/dev/null)

  if [ ${#bazel_files[@]} -gt 0 ]; then
    if [ "$MODE" = "check" ]; then
      if ! $buildifier_bin -mode=check "${bazel_files[@]}"; then
        echo "❌ Bazel buildifier check failed."
        FAILED=1
      fi
    else
      $buildifier_bin -lint=fix -mode=fix "${bazel_files[@]}"
    fi
  fi
}

check_go() {
  if command -v gofmt >/dev/null 2>&1; then
    echo "--> Running Go Formatter (gofmt)..."
    local unformatted_go
    unformatted_go=$(gofmt -s -l . 2>/dev/null | grep -v "vendor/" || true)
    if [ -n "$unformatted_go" ]; then
      echo "❌ Unformatted Go files found:"
      echo "$unformatted_go"
      FAILED=1
    fi

    if [ "$MODE" = "fix" ]; then
      find . -type f -name "*.go" -not -path "*/vendor/*" -exec gofmt -s -w {} +
    fi
  else
    echo "--> WARNING: gofmt not found. Go formatting checks skipped."
    if [ "$MODE" = "check" ]; then FAILED=1; fi
  fi
}

check_ui() {
  local ui_files=()
  if [ "$MODE" = "check" ]; then
    while IFS= read -r -d "" file; do
      ui_files+=("$file")
    done < <(find cmd/ui -type f \( -name "*.ts" -o -name "*.html" -o -name "*.scss" \) -not -path "*/node_modules/*" -not -path "*/.angular/*" -print0 2>/dev/null)
  else
    while IFS= read -r file; do
      ui_files+=("$file")
    done < <(git diff --cached --name-only --diff-filter=ACM | grep -E "^cmd/ui/.*\.(ts|html|scss)$" || true)
  fi

  if [ ${#ui_files[@]} -eq 0 ]; then
    return
  fi

  local prettier_bin="cmd/ui/node_modules/.bin/prettier"
  local eslint_bin="cmd/ui/node_modules/.bin/eslint"

  if [ -f "$prettier_bin" ]; then
    echo "--> Running UI Formatter (Prettier)..."
    if [ "$MODE" = "check" ]; then
      if ! $prettier_bin --config cmd/ui/.prettierrc --check "${ui_files[@]}"; then
        echo "❌ Prettier check failed."
        FAILED=1
      fi
    else
      $prettier_bin --config cmd/ui/.prettierrc --write "${ui_files[@]}"
    fi
  else
    echo "❌ ERROR: Local Prettier not found at $prettier_bin."
    echo "   Please install dependencies: cd cmd/ui && npm install"
    if [ "$MODE" = "check" ]; then FAILED=1; fi
  fi

  if [ -f "$eslint_bin" ]; then
    echo "--> Running UI Linter (ESLint)..."
    if [ "$MODE" = "check" ]; then
      if ! $eslint_bin --config cmd/ui/eslint.config.js "${ui_files[@]}"; then
        echo "❌ ESLint check failed."
        FAILED=1
      fi
    else
      $eslint_bin --config cmd/ui/eslint.config.js --fix "${ui_files[@]}"
    fi
  else
    echo "❌ ERROR: Local ESLint not found at $eslint_bin."
    echo "   Please install dependencies: cd cmd/ui && npm install"
    if [ "$MODE" = "check" ]; then FAILED=1; fi
  fi
}

check_license() {
  local addlicense_bin=""
  if command -v addlicense >/dev/null 2>&1; then
    addlicense_bin="addlicense"
  elif [ -f "$HOME/go/bin/addlicense" ]; then
    addlicense_bin="$HOME/go/bin/addlicense"
  fi

  if [ -z "$addlicense_bin" ]; then
    echo "--> WARNING: addlicense not found. License check skipped."
    if [ "$MODE" = "check" ]; then FAILED=1; fi
    return
  fi

  echo "--> Running License Header Check (addlicense)..."
  local ignores=(
    -ignore "third_party/**"
    -ignore "**/third_party/**"
    -ignore "**/node_modules/**"
    -ignore "**/.angular/**"
    -ignore "**.json"
    -ignore "**.lock"
    -ignore "**.toml"
    -ignore "package.json"
    -ignore "go.mod"
    -ignore "go.sum"
  )

  if [ "$MODE" = "check" ]; then
    if ! $addlicense_bin -check -c "Google LLC" -l apache "${ignores[@]}" .; then
      echo "❌ License header check failed."
      FAILED=1
    fi
  else
    local staged_files=()
    while IFS= read -r file; do
      staged_files+=("$file")
    done < <(git diff --cached --name-only --diff-filter=ACMR || true)

    if [ ${#staged_files[@]} -gt 0 ]; then
      $addlicense_bin -c "Google LLC" -l apache "${ignores[@]}" "${staged_files[@]}"
    fi
  fi
}

check_python() {
  local py_files=()
  if [ "$MODE" = "check" ]; then
    while IFS= read -r -d "" file; do
      py_files+=("$file")
    done < <(find . -type f -name "*.py" -not -path "*/node_modules/*" -not -path "*/.git/*" -print0 2>/dev/null)
  else
    while IFS= read -r file; do
      py_files+=("$file")
    done < <(git diff --cached --name-only --diff-filter=ACM | grep -E "\.py$" || true)
  fi

  if [ ${#py_files[@]} -eq 0 ]; then
    return
  fi

  local ruff_bin=""
  if command -v ruff >/dev/null 2>&1; then
    ruff_bin="ruff"
  elif [ -f "$HOME/.local/bin/ruff" ]; then
    ruff_bin="$HOME/.local/bin/ruff"
  fi

  if [ -n "$ruff_bin" ]; then
    echo "--> Running Python Linter & Formatter (Ruff)..."
    if [ "$MODE" = "check" ]; then
      if ! $ruff_bin check "${py_files[@]}"; then
        echo "❌ Ruff lint check failed."
        FAILED=1
      fi
      if ! $ruff_bin format --check "${py_files[@]}"; then
        echo "❌ Ruff format check failed."
        FAILED=1
      fi
    else
      $ruff_bin check --fix "${py_files[@]}"
      $ruff_bin format "${py_files[@]}"
    fi
  elif command -v docker >/dev/null 2>&1; then
    echo "--> Running Ruff via Docker container..."
    if [ "$MODE" = "check" ]; then
      if ! docker run --rm -v "$(pwd):/io" -w /io ghcr.io/astral-sh/ruff:latest check "${py_files[@]}"; then FAILED=1; fi
      if ! docker run --rm -v "$(pwd):/io" -w /io ghcr.io/astral-sh/ruff:latest format --check "${py_files[@]}"; then FAILED=1; fi
    else
      docker run --rm -v "$(pwd):/io" -w /io ghcr.io/astral-sh/ruff:latest check --fix "${py_files[@]}"
      docker run --rm -v "$(pwd):/io" -w /io ghcr.io/astral-sh/ruff:latest format "${py_files[@]}"
    fi
  else
    echo "--> WARNING: ruff or docker not found. Python linting skipped."
    if [ "$MODE" = "check" ]; then FAILED=1; fi
  fi
}

check_terraform() {
  local tf_files=()
  if [ "$MODE" = "check" ]; then
    while IFS= read -r -d "" file; do
      tf_files+=("$file")
    done < <(find deploy -type f -name "*.tf" -print0 2>/dev/null)
  else
    while IFS= read -r file; do
      tf_files+=("$file")
    done < <(git diff --cached --name-only --diff-filter=ACM | grep -E "\.tf$" || true)
  fi

  if [ ${#tf_files[@]} -eq 0 ]; then
    return
  fi

  echo "--> Running Terraform Formatter (terraform fmt)..."
  if command -v terraform >/dev/null 2>&1; then
    if [ "$MODE" = "check" ]; then
      if ! terraform fmt -check "${tf_files[@]}"; then
        echo "❌ Terraform formatting check failed."
        FAILED=1
      fi
    else
      terraform fmt "${tf_files[@]}" || true
    fi
  elif command -v docker >/dev/null 2>&1; then
    if [ "$MODE" = "check" ]; then
      if ! docker run --rm -v "$(pwd):/workspace" -w /workspace hashicorp/terraform:latest fmt -check "${tf_files[@]}"; then
        echo "❌ Terraform formatting check failed."
        FAILED=1
      fi
    else
      docker run --rm -v "$(pwd):/workspace" -w /workspace hashicorp/terraform:latest fmt "${tf_files[@]}" || true
    fi
  else
    echo "--> WARNING: terraform or docker not found. Terraform formatting check skipped."
    if [ "$MODE" = "check" ]; then FAILED=1; fi
  fi

  echo "--> Running Terraform Linter (TFLint)..."
  if command -v tflint >/dev/null 2>&1; then
    tflint --init >/dev/null 2>&1 || true
    if ! tflint --recursive; then
      echo "❌ TFLint check failed."
      FAILED=1
    fi
  elif command -v docker >/dev/null 2>&1; then
    if ! docker run --rm -v "$(pwd):/data" -w /data --entrypoint sh ghcr.io/terraform-linters/tflint:latest -c "tflint --init >/dev/null 2>&1 && tflint --recursive"; then
      echo "❌ TFLint check failed."
      FAILED=1
    fi
  else
    echo "--> WARNING: tflint or docker not found. TFLint check skipped."
    if [ "$MODE" = "check" ]; then FAILED=1; fi
  fi

  echo "--> Running Terraform Security Scanner (Trivy)..."
  if command -v trivy >/dev/null 2>&1; then
    if ! trivy config --skip-check-update --misconfig-scanners terraform --severity HIGH,CRITICAL deploy/; then
      echo "❌ Trivy security check failed."
      FAILED=1
    fi
  elif command -v docker >/dev/null 2>&1; then
    if ! docker run --rm -v "$(pwd):/src" aquasec/trivy:latest config --skip-check-update --misconfig-scanners terraform --severity HIGH,CRITICAL /src/deploy; then
      echo "❌ Trivy security check failed."
      FAILED=1
    fi
  else
    echo "--> WARNING: trivy or docker not found. Terraform security check skipped."
    if [ "$MODE" = "check" ]; then FAILED=1; fi
  fi
}

check_shell() {
  local shellcheck_bin=""
  if command -v shellcheck >/dev/null 2>&1; then
    shellcheck_bin="shellcheck"
  elif [ -f "$HOME/.local/bin/shellcheck" ]; then
    shellcheck_bin="$HOME/.local/bin/shellcheck"
  fi

  if [ -z "$shellcheck_bin" ]; then
    echo "--> WARNING: shellcheck not found. To install: apt-get install shellcheck or brew install shellcheck"
    if [ "$MODE" = "check" ]; then FAILED=1; fi
    return
  fi

  local shell_files=()
  if [ "$MODE" = "check" ]; then
    while IFS= read -r -d "" file; do
      shell_files+=("$file")
    done < <(find . -type f \( -name "*.sh" -o -path "./.githooks/*" \) -not -path "*/node_modules/*" -not -path "*/.git/*" -print0 2>/dev/null)
  else
    while IFS= read -r file; do
      shell_files+=("$file")
    done < <(git diff --cached --name-only --diff-filter=ACM | grep -E "(\.sh$|^\.githooks/)" || true)
  fi

  if [ ${#shell_files[@]} -eq 0 ]; then
    return
  fi

  echo "--> Running Shell Script Linter (ShellCheck)..."
  if ! $shellcheck_bin "${shell_files[@]}"; then
    echo "❌ ShellCheck lint check failed."
    FAILED=1
  fi
}

check_gitleaks() {
  local gitleaks_bin=""
  if command -v gitleaks >/dev/null 2>&1; then
    gitleaks_bin="gitleaks"
  elif [ -f "$HOME/go/bin/gitleaks" ]; then
    gitleaks_bin="$HOME/go/bin/gitleaks"
  elif [ -f "$HOME/.local/bin/gitleaks" ]; then
    gitleaks_bin="$HOME/.local/bin/gitleaks"
  fi

  if [ -n "$gitleaks_bin" ]; then
    echo "--> Running Secret Scanner (Gitleaks)..."
    if [ "$MODE" = "check" ]; then
      if ! $gitleaks_bin detect --source=. --no-git; then
        echo "❌ Gitleaks secret scan failed."
        FAILED=1
      fi
    else
      if ! $gitleaks_bin protect --staged; then
        echo "❌ Gitleaks secret scan failed."
        FAILED=1
      fi
    fi
  elif command -v docker >/dev/null 2>&1; then
    echo "--> Running Gitleaks via Docker container..."
    if [ "$MODE" = "check" ]; then
      if ! docker run --rm -v "$(pwd):/path" -w /path zricethezav/gitleaks:latest detect --source="/path" --no-git; then
        echo "❌ Gitleaks secret scan failed."
        FAILED=1
      fi
    else
      if ! docker run --rm -v "$(pwd):/path" -w /path zricethezav/gitleaks:latest protect --staged; then
        echo "❌ Gitleaks secret scan failed."
        FAILED=1
      fi
    fi
  else
    echo "--> WARNING: gitleaks or docker not found. Gitleaks check skipped."
    if [ "$MODE" = "check" ]; then FAILED=1; fi
  fi
}

check_semgrep() {
  local semgrep_bin=""
  if command -v semgrep >/dev/null 2>&1; then
    semgrep_bin="semgrep"
  elif [ -f "$HOME/.local/bin/semgrep" ]; then
    semgrep_bin="$HOME/.local/bin/semgrep"
  elif [ -f "$HOME/go/bin/semgrep" ]; then
    semgrep_bin="$HOME/go/bin/semgrep"
  fi

  if [ -n "$semgrep_bin" ]; then
    echo "--> Running Static Security Analysis (Semgrep)..."
    if ! $semgrep_bin scan --config auto; then
      echo "❌ Semgrep scan failed."
      FAILED=1
    fi
  elif command -v docker >/dev/null 2>&1; then
    echo "--> Running Semgrep via Docker container..."
    if ! docker run --rm -v "$(pwd):/src" semgrep/semgrep:latest semgrep scan --config auto; then
      echo "❌ Semgrep scan failed."
      FAILED=1
    fi
  else
    echo "--> WARNING: semgrep or docker not found. Semgrep check skipped."
    if [ "$MODE" = "check" ]; then FAILED=1; fi
  fi
}

main() {
  check_bazel
  check_go
  check_ui
  check_license
  check_python
  check_terraform
  check_shell
  check_gitleaks
  check_semgrep

  if [ "$MODE" = "fix" ]; then
    if ! git diff --quiet; then
      echo ""
      echo "❌ PRE-COMMIT HOOK FAILED: Linters automatically fixed formatting issues in your code!"
      echo "   Please review the modified files (git diff), stage them (git add -u), and re-run git commit."
      exit 1
    fi
  fi

  if [ "$FAILED" -ne 0 ]; then
    echo "=== ❌ Linter checks failed! ==="
    exit 1
  fi

  echo "=== ✅ All pre-commit checks passed! ==="
}

main "$@"
