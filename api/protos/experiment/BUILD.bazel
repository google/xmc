# gazelle:ignore
load("@io_bazel_rules_go//go:def.bzl", "go_library")
load("@io_bazel_rules_go//proto:compiler.bzl", "go_proto_compiler")
load("@io_bazel_rules_go//proto:def.bzl", "go_proto_library")
load("@rules_proto//proto:defs.bzl", "proto_descriptor_set", "proto_library")

package(default_visibility = ["//visibility:public"])

exports_files(["status.proto"])

proto_descriptor_set(
    name = "experiment_messages_descriptor",
    visibility = ["//visibility:public"],
    deps = [
        ":experiment_messages_proto",
        # Provides cloud.xmanager.v1.Action for the PausedTasks.ActionProto column.
        "//api/protos/task_queue:task_proto",
    ],
)

proto_library(
    name = "experiment_messages_proto",
    srcs = [
        "artifact.proto",
        "experiment.proto",
        "operations.proto",
        "priority.proto",
        "resources.proto",
        "status.proto",
        "status_message.proto",
        "structured_message.proto",
        "study.proto",
        "url.proto",
        "work_unit.proto",
        "work_unit_execution.proto",
    ],
    import_prefix = "xmanager_cloud/experiment_state_server/proto",
    strip_import_prefix = "/api/protos/experiment",
    deps = [
        "//api/protos/dashboard:dashboard_messages_proto",
        "//api/protos/xid:xid_messages_proto",
        "@com_google_googleapis//google/api:field_behavior_proto",
        "@com_google_googleapis//google/api:resource_proto",
        "@com_google_googleapis//google/rpc:status_proto",
        "@com_google_protobuf//:timestamp_proto",
    ],
)

alias(
    name = "messages_go_proto",
    actual = ":experiment",
)

proto_library(
    name = "experiment_api_proto",
    srcs = ["api.proto"],
    import_prefix = "xmanager_cloud/experiment_state_server/proto",
    strip_import_prefix = "/api/protos/experiment",
    deps = [
        ":experiment_messages_proto",
        "@com_google_googleapis//google/api:annotations_proto",
        "@com_google_googleapis//google/api:client_proto",
        "@com_google_googleapis//google/api:field_behavior_proto",
        "@com_google_googleapis//google/api:resource_proto",
        "@com_google_googleapis//google/longrunning:operations_proto",
        "@com_google_protobuf//:empty_proto",
        "@com_google_protobuf//:field_mask_proto",
    ],
)

go_proto_compiler(
    name = "go_grpc_gateway",
    plugin = "@com_github_grpc_ecosystem_grpc_gateway_v2//protoc-gen-grpc-gateway",
    suffix = ".pb.gw.go",
    visibility = ["//visibility:public"],
    deps = [
        "@com_github_grpc_ecosystem_grpc_gateway_v2//runtime",
        "@com_github_grpc_ecosystem_grpc_gateway_v2//utilities",
        "@org_golang_google_grpc//:grpc",
        "@org_golang_google_grpc//grpclog",
        "@org_golang_google_grpc//metadata",
        "@org_golang_google_protobuf//proto",
    ],
)

alias(
    name = "api_go_proto",
    actual = ":experiment",
)

proto_library(
    name = "cloud_xmanager_v1_proto",
    srcs = [
        "api.proto",
        "artifact.proto",
        "experiment.proto",
        "operations.proto",
        "priority.proto",
        "resources.proto",
        "status.proto",
        "status_message.proto",
        "structured_message.proto",
        "study.proto",
        "url.proto",
        "work_unit.proto",
        "work_unit_execution.proto",
    ],
    import_prefix = "xmanager_cloud/experiment_state_server/proto",
    strip_import_prefix = "/api/protos/experiment",
    deps = [
        "//api/protos/dashboard:dashboard_messages_proto",
        "//api/protos/xid:xid_messages_proto",
        "@com_google_googleapis//google/api:annotations_proto",
        "@com_google_googleapis//google/api:client_proto",
        "@com_google_googleapis//google/api:field_behavior_proto",
        "@com_google_googleapis//google/api:resource_proto",
        "@com_google_googleapis//google/longrunning:operations_proto",
        "@com_google_googleapis//google/rpc:status_proto",
        "@com_google_protobuf//:empty_proto",
        "@com_google_protobuf//:field_mask_proto",
        "@com_google_protobuf//:timestamp_proto",
    ],
)

go_proto_library(
    name = "cloud_xmanager_v1_go_proto",
    compilers = [
        "@io_bazel_rules_go//proto:go_proto",
        "@io_bazel_rules_go//proto:go_grpc_v2",
        ":go_grpc_gateway",
    ],
    importpath = "xmanager_cloud/api/protos/experiment",
    proto = ":cloud_xmanager_v1_proto",
    deps = [
        "//api/protos/dashboard:messages_go_proto",
        "//api/protos/xid:messages_go_proto",
        "@com_google_cloud_go_longrunning//autogen/longrunningpb",
        "@com_google_googleapis//google/api:field_behavior_go_proto",
        "@com_google_googleapis//google/api:resource_go_proto",
        "@org_golang_google_genproto_googleapis_api//:api",
        "@org_golang_google_genproto_googleapis_api//annotations",
        "@org_golang_google_genproto_googleapis_rpc//status",
    ],
)

go_library(
    name = "experiment",
    embed = [":cloud_xmanager_v1_go_proto"],
    importpath = "xmanager_cloud/api/protos/experiment",
)
