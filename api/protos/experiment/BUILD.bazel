load("@rules_proto//proto:defs.bzl", "proto_library")
load("@io_bazel_rules_go//proto:def.bzl", "go_proto_library")

package(default_visibility = ["//visibility:public"])

proto_library(
    name = "experiment_messages_proto",
    srcs = [
        "artifact.proto",
        "experiment.proto",
        "operations.proto",
        "priority.proto",
        "resources.proto",
        "status.proto",
        "status_message.proto",
        "structured_message.proto",
        "url.proto",
        "work_unit.proto",
        "work_unit_execution.proto",
    ],
    strip_import_prefix = "/api/protos/experiment",
    import_prefix = "third_party/xmanager_cloud/experiment_state_server/proto",
    deps = [
        "//api/protos/xid:xid_messages_proto",
        "@com_google_protobuf//:timestamp_proto",
        "@com_google_googleapis//google/api:field_behavior_proto",
        "@com_google_googleapis//google/api:resource_proto",
    ],
)

go_proto_library(
    name = "messages_go_proto",
    importpath = "xmanager_cloud/experiment_state_server/proto/messages_go_proto",
    proto = ":experiment_messages_proto",
    deps = [
        "//api/protos/xid:messages_go_proto",
        "@com_google_googleapis//google/api:field_behavior_go_proto",
        "@com_google_googleapis//google/api:resource_go_proto",
        "@org_golang_google_genproto_googleapis_api//annotations",
    ],
)

proto_library(
    name = "experiment_api_proto",
    srcs = ["api.proto"],
    strip_import_prefix = "/api/protos/experiment",
    import_prefix = "third_party/xmanager_cloud/experiment_state_server/proto",
    deps = [
        ":experiment_messages_proto",
        "@com_google_protobuf//:empty_proto",
        "@com_google_protobuf//:field_mask_proto",
        "@com_google_googleapis//google/api:annotations_proto",
        "@com_google_googleapis//google/api:client_proto",
        "@com_google_googleapis//google/api:field_behavior_proto",
        "@com_google_googleapis//google/api:resource_proto",
        "@com_google_googleapis//google/longrunning:operations_proto",
    ],
)

go_proto_library(
    name = "api_go_proto",
    compilers = [
        "@io_bazel_rules_go//proto:go_proto",
        "@io_bazel_rules_go//proto:go_grpc_v2",
    ],
    importpath = "xmanager_cloud/experiment_state_server/proto/api_go_proto",
    proto = ":experiment_api_proto",
    deps = [
        ":messages_go_proto",
        "@com_google_googleapis//google/api:annotations_go_proto",
        "@com_google_googleapis//google/api:client_go_proto",
        "@com_google_googleapis//google/api:field_behavior_go_proto",
        "@com_google_googleapis//google/api:resource_go_proto",
        "@com_google_cloud_go_longrunning//autogen/longrunningpb",
    ],
)
