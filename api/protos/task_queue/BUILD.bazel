load("@rules_proto//proto:defs.bzl", "proto_library")
load("@io_bazel_rules_go//proto:def.bzl", "go_proto_library")

package(default_visibility = ["//visibility:public"])

proto_library(
    name = "task_proto",
    srcs = ["task.proto"],
    strip_import_prefix = "/api/protos/task_queue",
    import_prefix = "third_party/xmanager_cloud/task_queue/proto",
    deps = [
        "//api/protos/experiment:experiment_messages_proto",
        "@com_google_protobuf//:field_mask_proto",
        "@com_google_protobuf//:timestamp_proto",
        "@com_google_googleapis//google/api:field_behavior_proto",
    ],
)

go_proto_library(
    name = "task_go_proto",
    importpath = "xmanager_cloud/task_queue/proto/task_go_proto",
    proto = ":task_proto",
    deps = [
        "//api/protos/experiment:messages_go_proto",
        "@com_google_googleapis//google/api:field_behavior_go_proto",
        "@org_golang_google_genproto_googleapis_api//annotations",
    ],
)
