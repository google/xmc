load("@com_google_protobuf//bazel:py_proto_library.bzl", "py_proto_library")
load("@io_bazel_rules_go//proto:def.bzl", "go_proto_library")
load("@rules_proto//proto:defs.bzl", "proto_descriptor_set", "proto_library")

package(default_visibility = ["//visibility:public"])

proto_descriptor_set(
    name = "dashboard_messages_descriptor",
    visibility = ["//visibility:public"],
    deps = [":dashboard_messages_proto"],
)

proto_descriptor_set(
    name = "dashboard_service_descriptor",
    visibility = ["//visibility:public"],
    deps = [":dashboard_service_proto"],
)

proto_library(
    name = "dashboard_messages_proto",
    srcs = ["messages.proto"],
    import_prefix = "xmanager_cloud/dashboard_service/proto",
    strip_import_prefix = "/api/protos/dashboard",
    deps = [
        "@com_google_googleapis//google/api:field_behavior_proto",
        "@com_google_googleapis//google/api:resource_proto",
        "@com_google_protobuf//:timestamp_proto",
    ],
)

proto_library(
    name = "dashboard_service_proto",
    srcs = ["dashboard_service.proto"],
    import_prefix = "xmanager_cloud/dashboard_service/proto",
    strip_import_prefix = "/api/protos/dashboard",
    deps = [
        ":dashboard_messages_proto",
        "@com_google_googleapis//google/api:annotations_proto",
        "@com_google_googleapis//google/api:client_proto",
        "@com_google_googleapis//google/api:field_behavior_proto",
        "@com_google_googleapis//google/api:resource_proto",
        "@com_google_protobuf//:empty_proto",
        "@com_google_protobuf//:field_mask_proto",
    ],
)

go_proto_library(
    name = "messages_go_proto",
    compilers = ["@io_bazel_rules_go//proto:go_grpc"],
    importpath = "xmanager_cloud/dashboard_service/proto/api_go_proto",
    proto = ":dashboard_messages_proto",
    deps = [
        "@org_golang_google_genproto_googleapis_api//:go_default_library",
        "@org_golang_google_genproto_googleapis_api//annotations",
    ],
)

go_proto_library(
    name = "service_go_proto",
    compilers = [
        "@io_bazel_rules_go//proto:go_proto",
        "@io_bazel_rules_go//proto:go_grpc_v2",
        "//api/protos/experiment:go_grpc_gateway",
    ],
    importpath = "xmanager_cloud/dashboard_service/proto/service_go_proto",
    proto = ":dashboard_service_proto",
    deps = [
        ":messages_go_proto",
        "@org_golang_google_genproto_googleapis_api//:go_default_library",
        "@org_golang_google_genproto_googleapis_api//annotations",
    ],
)

alias(
    name = "api_go_proto",
    actual = ":messages_go_proto",
)

alias(
    name = "api_go_grpc_proto",
    actual = ":service_go_proto",
)

alias(
    name = "api_go_grpc_gateway_proto",
    actual = ":service_go_proto",
)

py_proto_library(
    name = "dashboard_messages_py_proto",
    deps = [":dashboard_messages_proto"],
)

py_proto_library(
    name = "dashboard_service_py_proto",
    deps = [":dashboard_service_proto"],
)
