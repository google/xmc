load("@com_google_protobuf//bazel:py_proto_library.bzl", "py_proto_library")
load("@io_bazel_rules_go//go:def.bzl", "go_library")
load("@io_bazel_rules_go//proto:compiler.bzl", "go_proto_compiler")
load("@io_bazel_rules_go//proto:def.bzl", "go_proto_library")
load("@rules_proto//proto:defs.bzl", "proto_descriptor_set", "proto_library")

package(default_visibility = ["//visibility:public"])

_DASHBOARD_M_OPTS = [
    "Mxmanager_cloud/dashboard_service/proto/dashboard_service.proto=xmanager_cloud/api/protos/dashboard;dashboard",
    "Mxmanager_cloud/dashboard_service/proto/messages.proto=xmanager_cloud/api/protos/dashboard;dashboard",
]

go_proto_compiler(
    name = "dashboard_go_proto",
    options = _DASHBOARD_M_OPTS,
    plugin = "@org_golang_google_protobuf//cmd/protoc-gen-go",
    suffix = ".pb.go",
    visibility = ["//visibility:private"],
    deps = [
        "@org_golang_google_protobuf//proto",
        "@org_golang_google_protobuf//reflect/protoreflect",
        "@org_golang_google_protobuf//runtime/protoimpl",
    ],
)

go_proto_compiler(
    name = "dashboard_go_grpc",
    options = _DASHBOARD_M_OPTS + ["require_unimplemented_servers=false"],
    plugin = "@org_golang_google_grpc_cmd_protoc_gen_go_grpc//:protoc-gen-go-grpc",
    suffix = "_grpc.pb.go",
    visibility = ["//visibility:private"],
    deps = [
        "@org_golang_google_grpc//:grpc",
        "@org_golang_google_grpc//codes",
        "@org_golang_google_grpc//status",
    ],
)

go_proto_compiler(
    name = "dashboard_go_grpc_gateway",
    options = _DASHBOARD_M_OPTS,
    plugin = "@com_github_grpc_ecosystem_grpc_gateway_v2//protoc-gen-grpc-gateway",
    suffix = ".pb.gw.go",
    visibility = ["//visibility:private"],
    deps = [
        "@com_github_grpc_ecosystem_grpc_gateway_v2//runtime",
        "@com_github_grpc_ecosystem_grpc_gateway_v2//utilities",
        "@org_golang_google_grpc//:grpc",
        "@org_golang_google_grpc//grpclog",
        "@org_golang_google_grpc//metadata",
        "@org_golang_google_protobuf//proto",
    ],
)

proto_descriptor_set(
    name = "dashboard_messages_descriptor",
    visibility = ["//visibility:public"],
    deps = [":dashboard_messages_proto"],
)

proto_descriptor_set(
    name = "dashboard_service_descriptor",
    visibility = ["//visibility:public"],
    deps = [":dashboard_service_proto"],
)

proto_library(
    name = "dashboard_messages_proto",
    srcs = ["messages.proto"],
    import_prefix = "xmanager_cloud/dashboard_service/proto",
    strip_import_prefix = "/api/protos/dashboard",
    deps = [
        "@com_google_googleapis//google/api:field_behavior_proto",
        "@com_google_googleapis//google/api:resource_proto",
        "@com_google_protobuf//:timestamp_proto",
    ],
)

proto_library(
    name = "dashboard_service_proto",
    srcs = ["dashboard_service.proto"],
    import_prefix = "xmanager_cloud/dashboard_service/proto",
    strip_import_prefix = "/api/protos/dashboard",
    deps = [
        ":dashboard_messages_proto",
        "@com_google_googleapis//google/api:annotations_proto",
        "@com_google_googleapis//google/api:client_proto",
        "@com_google_googleapis//google/api:field_behavior_proto",
        "@com_google_googleapis//google/api:resource_proto",
        "@com_google_protobuf//:empty_proto",
        "@com_google_protobuf//:field_mask_proto",
    ],
)

proto_library(
    name = "cloud_xmanager_v1_proto",
    srcs = [
        "dashboard_service.proto",
        "messages.proto",
    ],
    import_prefix = "xmanager_cloud/dashboard_service/proto",
    strip_import_prefix = "/api/protos/dashboard",
    deps = [
        "@com_google_googleapis//google/api:annotations_proto",
        "@com_google_googleapis//google/api:client_proto",
        "@com_google_googleapis//google/api:field_behavior_proto",
        "@com_google_googleapis//google/api:resource_proto",
        "@com_google_protobuf//:empty_proto",
        "@com_google_protobuf//:field_mask_proto",
        "@com_google_protobuf//:timestamp_proto",
    ],
)

go_proto_library(
    name = "cloud_xmanager_v1_go_proto",
    compilers = [
        ":dashboard_go_proto",
        ":dashboard_go_grpc",
        ":dashboard_go_grpc_gateway",
    ],
    importpath = "xmanager_cloud/api/protos/dashboard",
    proto = ":cloud_xmanager_v1_proto",
    deps = [
        "@org_golang_google_genproto_googleapis_api//:api",
        "@org_golang_google_genproto_googleapis_api//annotations",
        "@org_golang_google_protobuf//types/known/emptypb",
        "@org_golang_google_protobuf//types/known/fieldmaskpb",
        "@org_golang_google_protobuf//types/known/timestamppb",
    ],
)

go_library(
    name = "dashboard",
    embed = [":cloud_xmanager_v1_go_proto"],
    importpath = "xmanager_cloud/api/protos/dashboard",
)

alias(
    name = "messages_go_proto",
    actual = ":dashboard",
)

alias(
    name = "service_go_proto",
    actual = ":dashboard",
)

alias(
    name = "api_go_proto",
    actual = ":dashboard",
)

alias(
    name = "api_go_grpc_proto",
    actual = ":dashboard",
)

alias(
    name = "api_go_grpc_gateway_proto",
    actual = ":dashboard",
)

py_proto_library(
    name = "dashboard_messages_py_proto",
    deps = [":dashboard_messages_proto"],
)

py_proto_library(
    name = "dashboard_service_py_proto",
    deps = [":dashboard_service_proto"],
)
