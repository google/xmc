load("@io_bazel_rules_go//go:def.bzl", "go_library")
load("@io_bazel_rules_go//proto:def.bzl", "go_proto_library")
load("@rules_proto//proto:defs.bzl", "proto_library")

package(default_visibility = ["//visibility:public"])

proto_library(
    name = "components_proto",
    srcs = ["components.proto"],
    import_prefix = "third_party/xmanager_cloud/components/proto",
    strip_import_prefix = "/api/protos/components/v1alpha1",
    deps = [
        "@com_google_protobuf//:struct_proto",
        "@com_google_protobuf//:timestamp_proto",
    ],
)

go_proto_library(
    name = "components_go_proto",
    compilers = [
        "@io_bazel_rules_go//proto:go_proto",
        "@io_bazel_rules_go//proto:go_grpc_v2",
    ],
    importpath = "xmanager_cloud/api/protos/components/v1alpha1",
    proto = ":components_proto",
    deps = [
        "@org_golang_google_protobuf//types/known/structpb",
        "@org_golang_google_protobuf//types/known/timestamppb",
    ],
)

go_library(
    name = "components",
    embed = [":components_go_proto"],
    importpath = "xmanager_cloud/api/protos/components/v1alpha1",
)
