# gazelle:ignore
load("@io_bazel_rules_go//go:def.bzl", "go_library")
load("@io_bazel_rules_go//proto:def.bzl", "go_proto_library")
load("@rules_proto//proto:defs.bzl", "proto_library", "proto_descriptor_set")

proto_descriptor_set(
    name = "xid_messages_descriptor",
    deps = [":xid_messages_proto"],
    visibility = ["//visibility:public"],
)

package(default_visibility = ["//visibility:public"])

proto_library(
    name = "xid_messages_proto",
    srcs = ["messages.proto"],
    import_prefix = "third_party/xmanager_cloud/xid_service/proto",
    strip_import_prefix = "/api/protos/xid",
    deps = [
        "@com_google_googleapis//google/api:field_behavior_proto",
        "@com_google_googleapis//google/api:resource_proto",
        "@com_google_protobuf//:timestamp_proto",
    ],
)

go_proto_library(
    name = "messages_go_proto",
    importpath = "xmanager_cloud/xid_service/proto/messages_go_proto",
    proto = ":xid_messages_proto",
    deps = [
        "@org_golang_google_genproto_googleapis_api//:go_default_library",
        "@org_golang_google_genproto_googleapis_api//annotations",
    ],
)

proto_library(
    name = "xid_api_proto",
    srcs = ["api.proto"],
    import_prefix = "third_party/xmanager_cloud/xid_service/proto",
    strip_import_prefix = "/api/protos/xid",
    deps = [
        ":xid_messages_proto",
        "@com_google_googleapis//google/api:annotations_proto",
        "@com_google_googleapis//google/api:client_proto",
        "@com_google_googleapis//google/api:field_behavior_proto",
        "@com_google_googleapis//google/api:resource_proto",
        "@com_google_protobuf//:field_mask_proto",
    ],
)

go_proto_library(
    name = "api_go_proto",
    compilers = [
        "@io_bazel_rules_go//proto:go_proto",
        "@io_bazel_rules_go//proto:go_grpc_v2",
    ],
    importpath = "xmanager_cloud/xid_service/proto/api_go_proto",
    proto = ":xid_api_proto",
    deps = [
        ":messages_go_proto",
        "@org_golang_google_genproto_googleapis_api//:go_default_library",
        "@org_golang_google_genproto_googleapis_api//annotations",
    ],
)

proto_library(
    name = "cloud_xmanager_v1_proto",
    srcs = [
        "api.proto",
        "messages.proto",
    ],
    import_prefix = "third_party/xmanager_cloud/xid_service/proto",
    strip_import_prefix = "/api/protos/xid",
    deps = [
        "@com_google_googleapis//google/api:annotations_proto",
        "@com_google_googleapis//google/api:client_proto",
        "@com_google_googleapis//google/api:field_behavior_proto",
        "@com_google_googleapis//google/api:resource_proto",
        "@com_google_protobuf//:field_mask_proto",
        "@com_google_protobuf//:timestamp_proto",
    ],
)

go_proto_library(
    name = "cloud_xmanager_v1_go_proto",
    compilers = [
        "@io_bazel_rules_go//proto:go_proto",
        "@io_bazel_rules_go//proto:go_grpc_v2",
    ],
    importpath = "xmanager_cloud/api/protos/xid",
    proto = ":cloud_xmanager_v1_proto",
    deps = [
        "@com_google_googleapis//google/api:field_behavior_go_proto",
        "@com_google_googleapis//google/api:resource_go_proto",
        "@org_golang_google_genproto_googleapis_api//:go_default_library",
        "@org_golang_google_genproto_googleapis_api//annotations",
    ],
)

go_library(
    name = "xid",
    embed = [":cloud_xmanager_v1_go_proto"],
    importpath = "xmanager_cloud/api/protos/xid",
)
