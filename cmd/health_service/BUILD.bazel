load("@io_bazel_rules_go//go:def.bzl", "go_binary")
load("//:compat.bzl", "compat_go_library", "compat_go_test")
load("//:oci.bzl", "oci_image_for_service")

compat_go_library(
    name = "health_service_lib",
    srcs = [
        "config.go",
        "health_checker.go",
        "list_configs.go",
        "main.go",
        "server.go",
    ],
    importpath = "xmanager_cloud/cmd/health_service/main",
    visibility = ["//visibility:private"],
    deps = [
        "//api/protos/health:api_go_proto",
        "//internal/common/health",
        "//internal/compat/google",
        "//internal/configutil",
        "//internal/logging",
        "//internal/security/tlsutil",
        "//internal/task_queue_redis/redisclient",
        "//pkg/auth/oauth2",
        "@com_github_grpc_ecosystem_grpc_gateway_v2_custom//:runtime",
        "@com_google_cloud_go_spanner//:spanner",
        "@org_golang_google_api//option:go_default_library",
        "@org_golang_google_api//run/v2:go_default_library",
        "@org_golang_google_grpc//:go_default_library",
        "@org_golang_google_grpc//codes:go_default_library",
        "@org_golang_google_grpc//credentials/insecure:go_default_library",
        "@org_golang_google_grpc//health/grpc_health_v1:go_default_library",
        "@org_golang_google_grpc//reflection:go_default_library",
        "@org_golang_google_grpc//status:go_default_library",
        "@org_golang_google_protobuf//types/known/timestamppb",
        "@org_golang_x_sync//singleflight:go_default_library",
        "@org_golang_x_time//rate:go_default_library",
    ],
)

go_binary(
    name = "health_service",
    embed = [":health_service_lib"],
    pure = "on",
    visibility = ["//visibility:public"],
    x_defs = {
        "xmanager_cloud/cmd/health_service/main.buildVersion": "{STABLE_APP_VERSION}",
    },
)

oci_image_for_service(
    name = "health_service_image",
    binary = ":health_service",
)

compat_go_test(
    name = "server_test",
    srcs = [
        "health_checker_test.go",
        "list_configs_test.go",
        "server_test.go",
    ],
    embed = [":health_service_lib"],
    deps = [
        "@com_github_google_go_cmp//cmp:go_default_library",
        "@org_golang_google_api//option:go_default_library",
        "@org_golang_google_api//run/v2:go_default_library",
        "@org_golang_google_grpc//:go_default_library",
        "@org_golang_google_grpc//health:go_default_library",
        "@org_golang_google_protobuf//testing/protocmp:go_default_library",
    ],
)
