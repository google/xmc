load("@io_bazel_rules_go//go:def.bzl", "go_binary", "go_library", "go_test")
load("//:oci.bzl", "oci_image_for_service")

go_library(
    name = "health_service_lib",
    srcs = [
        "admin_role_guard.go",
        "config.go",
        "health_checker.go",
        "lazy_spanner_client.go",
        "list_configs.go",
        "main.go",
        "pause_scheduling.go",
        "server.go",
    ],
    importpath = "xmanager_cloud/cmd/health_service/main",
    visibility = ["//visibility:private"],
    deps = [
        "//api/protos/health:api_go_proto",
        "//internal/auth",
        "//internal/broadcast",
        "//internal/common/health",
        "//internal/configutil",
        "//internal/featureflags",
        "//internal/kubernetes/common/constants",
        "//internal/logging",
        "//internal/security/tlsutil",
        "//internal/storage",
        "//internal/storage/spanner",
        "//internal/storage/spanner/clisession",
        "//internal/storage/spanner/migrations/version",
        "//internal/task_queue_redis/redisclient",
        "//pkg/auth/oauth2",
        "//pkg/components/store",
        "//pkg/components/summary",
        "@com_github_google_uuid//:uuid",
        "@com_github_grpc_ecosystem_grpc_gateway_v2//runtime",
        "@com_github_prometheus_client_golang//prometheus",
        "@com_github_prometheus_client_golang//prometheus/promauto",
        "@com_github_prometheus_client_golang//prometheus/promhttp",
        "@com_google_cloud_go_spanner//:spanner",
        "@org_golang_google_api//cloudidentity/v1beta1",
        "@org_golang_google_api//option",
        "@org_golang_google_api//run/v2:run",
        "@org_golang_google_grpc//:grpc",
        "@org_golang_google_grpc//codes",
        "@org_golang_google_grpc//credentials/insecure",
        "@org_golang_google_grpc//health/grpc_health_v1",
        "@org_golang_google_grpc//metadata",
        "@org_golang_google_grpc//reflection",
        "@org_golang_google_grpc//status",
        "@org_golang_google_protobuf//proto",
        "@org_golang_google_protobuf//types/known/timestamppb",
        "@org_golang_x_sync//singleflight",
        "@org_golang_x_time//rate",
    ],
)

go_binary(
    name = "health_service",
    embed = [":health_service_lib"],
    pure = "on",
    visibility = ["//visibility:public"],
    x_defs = {
        "xmanager_cloud/cmd/health_service/main.buildVersion": "{STABLE_APP_VERSION}",
    },
)

oci_image_for_service(
    name = "health_service_image",
    binary = ":health_service",
)

go_test(
    name = "server_test",
    srcs = [
        "admin_role_guard_test.go",
        "health_checker_test.go",
        "lazy_spanner_client_test.go",
        "list_configs_test.go",
        "pause_scheduling_test.go",
        "server_test.go",
    ],
    embed = [":health_service_lib"],
    deps = [
        "//api/protos/xid:messages_go_proto",
        "//internal/auth",
        "//internal/broadcast",
        "//internal/common/health",
        "//internal/kubernetes/common/constants",
        "//internal/storage",
        "//internal/storage/spanner/clisession",
        "//internal/storage/spanner/emulator",
        "//internal/storage/testing",
        "//internal/task_queue_redis/redisclient",
        "//pkg/auth/oauth2",
        "@com_github_google_go_cmp//cmp",
        "@com_github_google_uuid//:uuid",
        "@com_github_prometheus_client_golang//prometheus/testutil",
        "@com_google_cloud_go_iam//apiv1/iampb",
        "@com_google_cloud_go_spanner//:spanner",
        "@org_golang_google_api//option",
