load("@io_bazel_rules_go//go:def.bzl", "go_library", "go_test")

package(default_visibility = ["//visibility:public"])

go_library(
    name = "reconciler",
    srcs = [
        "resource_reconciler.go",
    ],
    importpath = "github.com/google/xmc/cmd/rod_data_provider/reconciler",
    visibility = ["//visibility:public"],
    deps = [
        "//cmd/rod_data_provider/cache",
        "@io_k8s_apimachinery//pkg/api/errors",
        "@io_k8s_sigs_controller_runtime//:go_default_library",
        "@io_k8s_sigs_controller_runtime//pkg/client",
        "@io_k8s_sigs_controller_runtime//pkg/predicate",
        "@io_k8s_sigs_kueue//apis/kueue/v1beta1",
    ],
)

go_test(
    name = "reconciler_test",
    srcs = [
        "resource_reconciler_test.go",
    ],
    embed = [":reconciler"],
    deps = [
        "//cmd/rod_data_provider/cache",
        "@io_k8s_apimachinery//pkg/apis/meta/v1:meta",
        "@io_k8s_apimachinery//pkg/runtime",
        "@io_k8s_sigs_controller_runtime//:go_default_library",
        "@io_k8s_sigs_controller_runtime//pkg/client",
        "@io_k8s_sigs_controller_runtime//pkg/client/fake",
        "@io_k8s_sigs_kueue//apis/kueue/v1beta1",
    ],
)
