load("@io_bazel_rules_go//go:def.bzl", "go_binary")
load("//:compat.bzl", "compat_go_library", "compat_go_test")
load("//:oci.bzl", "oci_image_for_service")

package(default_visibility = ["//visibility:public"])

compat_go_library(
    name = "rod_data_provider_lib",
    srcs = [
        "config.go",
        "kueue_collector.go",
        "kueue_resource_extractor.go",
        "main.go",
        "queue_converters.go",
        "queue_matcher.go",
        "server.go",
    ],
    importpath = "xmanager_cloud/cmd/rod_data_provider/main",
    visibility = ["//visibility:private"],
    deps = [
        "//api/protos/rod",
        "//cmd/rod_data_provider/cache",
        "//cmd/rod_data_provider/reconciler",
        "//internal/compat/google",
        "//internal/logging",
        "//pkg/auth/oauth2",
        "@com_github_grpc_ecosystem_grpc_gateway_v2_custom//:runtime",
        "@io_k8s_apimachinery//pkg/api/resource",
        "@io_k8s_apimachinery//pkg/apis/meta/v1:meta",
        "@io_k8s_apimachinery//pkg/runtime",
        "@io_k8s_client_go//kubernetes/scheme",
        "@io_k8s_client_go//rest",
        "@io_k8s_sigs_controller_runtime//:go_default_library",
        "@io_k8s_sigs_controller_runtime//pkg/client",
        "@io_k8s_sigs_controller_runtime//pkg/metrics/server",
        "@io_k8s_sigs_kueue//apis/kueue/v1beta1",
        "@org_golang_google_grpc//:go_default_library",
        "@org_golang_google_grpc//codes",
        "@org_golang_google_grpc//credentials/insecure:go_default_library",
        "@org_golang_google_grpc//reflection:go_default_library",
        "@org_golang_google_grpc//status",
        "@org_golang_x_sync//errgroup:go_default_library",
    ],
)

go_binary(
    name = "rod_data_provider",
    embed = [":rod_data_provider_lib"],
    pure = "on",
    visibility = ["//visibility:public"],
)

oci_image_for_service(
    name = "rod_data_provider_image",
    binary = ":rod_data_provider",
)

compat_go_test(
    name = "server_test",
    srcs = [
        "config_test.go",
        "server_test.go",
    ],
    embed = [":rod_data_provider_lib"],
    deps = [
        "//api/protos/rod",
        "//cmd/rod_data_provider/cache",
        "@io_k8s_api//core/v1:core",
        "@io_k8s_apimachinery//pkg/api/resource",
        "@io_k8s_apimachinery//pkg/apis/meta/v1:meta",
        "@io_k8s_sigs_kueue//apis/kueue/v1beta1",
    ],
)

compat_go_test(
    name = "kueue_resource_extractor_test",
    srcs = [
        "kueue_resource_extractor_test.go",
    ],
    embed = [":rod_data_provider_lib"],
    deps = [
        "@io_k8s_api//core/v1:core",
        "@io_k8s_apimachinery//pkg/api/resource",
        "@io_k8s_sigs_kueue//apis/kueue/v1beta1",
    ],
)

compat_go_test(
    name = "queue_converters_test",
    srcs = [
        "queue_converters_test.go",
    ],
    embed = [":rod_data_provider_lib"],
    deps = [
        "//api/protos/rod",
        "@com_github_google_go_cmp//cmp",
        "@io_k8s_api//core/v1:core",
        "@io_k8s_apimachinery//pkg/api/resource",
        "@io_k8s_apimachinery//pkg/apis/meta/v1:meta",
        "@io_k8s_sigs_kueue//apis/kueue/v1beta1",
        "@org_golang_google_protobuf//testing/protocmp",
    ],
)
