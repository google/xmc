{
  "$schema": "./node_modules/@angular/cli/lib/config/schema.json",
  "version": 1,
  "newProjectRoot": "projects",
  "projects": {
    "xmc-ui": {
      "projectType": "application",
      "schematics": {
        "@schematics/angular:component": {
          "standalone": true,
          "style": "scss"
        }
      },
      "root": "",
      "sourceRoot": "",
      "prefix": "xmc",
      "architect": {
        "build": {
          "builder": "@angular-devkit/build-angular:application",
          "options": {
            "outputPath": "dist",
            "index": "index.html",
            "browser": "main.ts",
            "polyfills": ["zone.js"],
            "tsConfig": "tsconfig.json",
            "assets": ["logo.svg", "static"],
            "styles": ["styles.scss"],
            "stylePreprocessorOptions": {
              "includePaths": ["."]
            },
            "scripts": [],
            "externalDependencies": [],
            "optimization": {
              "fonts": {
                "inline": false
              }
            }
          },
          "configurations": {
            "production": {
              "budgets": [
                {
                  "type": "initial",
                  "maximumWarning": "2mb",
                  "maximumError": "4mb"
                }
              ],
              "outputHashing": "all"
            },
            "development": {
              "optimization": false,
              "extractLicenses": false,
              "sourceMap": true
            }
          },
          "defaultConfiguration": "production"
        },
        "serve": {
          "builder": "@angular-devkit/build-angular:dev-server",
          "options": {
            "buildTarget": "xmc-ui:build",
            "proxyConfig": "proxy.conf.json"
          },
          "configurations": {
            "production": {
              "buildTarget": "xmc-ui:build:production"
            },
            "development": {
              "buildTarget": "xmc-ui:build:development"
            }
          },
          "defaultConfiguration": "development"
        },
        "test": {
          "builder": "@angular-devkit/build-angular:karma",
          "options": {
            "karmaConfig": "karma.conf.js",
            "main": "app/testing/test.ts",
            "tsConfig": "tsconfig.spec.json",
            "include": ["app/**/*_test.ts"],
            "polyfills": ["zone.js", "zone.js/testing"],
            "styles": ["styles.scss"],
            "stylePreprocessorOptions": {
              "includePaths": ["."]
            }
          }
        }
      }
    }
  },
  "cli": {
    "analytics": false
  }
}
