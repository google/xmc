{
  "extends": "./tsconfig.json",
  "compilerOptions": {
    "outDir": "./out-tsc/spec",
    "types": [
      "jasmine"
    ],
    "paths": {
      "xmanager_cloud/ui/app/*": ["app/*"],
      "jasmine": ["app/stubs/jasmine.ts"],
      "javascript/closure/format/format": ["app/stubs/format.ts"],
      "javascript/closure/i18n/messageformat": ["app/stubs/messageformat.ts"],
      "javascript/closure/i18n/messages": ["app/stubs/messages.ts"],
      "javascript/closure/i18n/numberformat": ["app/stubs/numberformat.ts"],
      "@angular/cdk/testing/catalyst/async": ["app/testing/catalyst_async.ts"]
    }
  },
  "include": [
    "**/*.spec.ts",
    "**/*.d.ts",
    "app/**/*_test.ts",
    "app/testing/test.ts"
  ],
  "exclude": []
}
