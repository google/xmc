{
  "extends": "./tsconfig.json",
  "compilerOptions": {
    "outDir": "./out-tsc/spec",
    "types": ["jasmine"],
    "paths": {
      "app/*": ["./app/*"],
      "xmanager_cloud/ui/app/*": ["./app/*"],
      "@angular/cdk/testing/catalyst/async": ["./app/testing/catalyst_async.ts"]
    }
  },
  "include": ["**/*.spec.ts", "**/*.d.ts", "app/**/*_test.ts", "app/testing/**/*.ts"],
  "exclude": ["screenshot_tests/**/*"]
}
