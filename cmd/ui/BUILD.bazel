load("@rules_python//python:defs.bzl", "py_library", "py_test")
load("//:oci.bzl", "oci_image_for_ui")

# Standalone BUILD.bazel file for XMC UI
package(default_visibility = ["//visibility:public"])

filegroup(
    name = "ui_srcs",
    srcs = glob([
        "app/**/*",
        "static/**/*",
        "*.ts",
        "*.scss",
        "*.html",
        "*.json",
        "*.svg",
        "nginx.conf",
        "generate_config.sh",
    ]),
    visibility = ["//visibility:public"],
)

oci_image_for_ui(
    name = "ui_image",
    srcs = [":ui_srcs"],
)

py_library(
    name = "server",
    srcs = ["server.py"],
    imports = ["."],
    visibility = ["//visibility:public"],
)

py_test(
    name = "server_test",
    srcs = ["server_test.py"],
    deps = [
        ":server",
    ],
)

py_test(
    name = "ui_unit_tests",
    srcs = ["run_ui_tests.py"],
    data = glob([
        "app/**/*",
        "static/**/*",
        "*.ts",
        "*.scss",
        "*.html",
        "*.json",
        "*.svg",
        "package-lock.json",
        "karma.conf.js",
    ]),
    main = "run_ui_tests.py",
    tags = [
        "local",
    ],
)
