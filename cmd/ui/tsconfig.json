{
  "compilerOptions": {
    "ignoreDeprecations": "6.0",
    "target": "ES2022",
    "useDefineForClassFields": false,
    "forceConsistentCasingInFileNames": true,
    "strict": true,
    "noImplicitOverride": true,
    "noPropertyAccessFromIndexSignature": false,
    "noImplicitReturns": true,
    "noFallthroughCasesInSwitch": true,
    "skipLibCheck": true,
    "esModuleInterop": true,
    "experimentalDecorators": true,
    "moduleResolution": "bundler",
    "module": "ES2022",
    "lib": ["ES2024", "dom"],
    "paths": {
      "app/*": ["./app/*"],
      "xmanager_cloud/ui/app/*": ["./app/*"],
      "jasmine": ["./app/stubs/jasmine.ts"],
      "javascript/closure/format/format": ["./app/stubs/format.ts"],
      "javascript/closure/i18n/messageformat": ["./app/stubs/messageformat.ts"],
      "javascript/closure/i18n/messages": ["./app/stubs/messages.ts"],
      "javascript/closure/i18n/numberformat": ["./app/stubs/numberformat.ts"]
    }
  },
  "include": ["**/*.ts", "**/*.d.ts"],
  "angularCompilerOptions": {
    "enableI18nLegacyMessageIdFormat": false,
    "strictInjectionParameters": true,
    "strictInputAccessModifiers": true,
    "strictTemplates": true
  },
  "exclude": [
    "**/*_test.ts",
    "**/*.spec.ts",
    "screenshot_tests",
    "playwright.config.ts",
    "app/testing",
    "node_modules.bak",
    "node_modules.bak/**"
  ]
}
