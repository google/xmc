load("@io_bazel_rules_go//go:def.bzl", "go_library", "go_test")

go_library(
    name = "toollibs",
    srcs = ["dashboard_client.go"],
    importpath = "github.com/google/xmc/cmd/experiment_state_server/toollibs",
    visibility = ["//visibility:public"],
    deps = [
        "//api/protos/dashboard:api_go_grpc_proto",
        "//api/protos/dashboard:api_go_proto",
        "@org_golang_google_grpc//:go_default_library",
    ],
)

go_test(
    name = "toollibs_test",
    srcs = ["dashboard_client_test.go"],
    embed = [":toollibs"],
    deps = [
        "//api/protos/dashboard:api_go_grpc_proto",
        "//api/protos/dashboard:api_go_proto",
        "@org_golang_google_grpc//:go_default_library",
    ],
)
