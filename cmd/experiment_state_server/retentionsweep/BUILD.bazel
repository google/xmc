load("@io_bazel_rules_go//go:def.bzl", "go_library", "go_test")

go_library(
    name = "retentionsweep",
    srcs = ["sweeper.go"],
    importpath = "xmanager_cloud/cmd/experiment_state_server/retentionsweep",
    visibility = ["//cmd/experiment_state_server:__subpackages__"],
    deps = [
        "//internal/logging",
        "//internal/storage",
    ],
)

go_test(
    name = "retentionsweep_test",
    srcs = ["sweeper_test.go"],
    embed = [":retentionsweep"],
    deps = [
        "//internal/storage",
        "@com_github_google_go_cmp//cmp",
    ],
)
