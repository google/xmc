load("@io_bazel_rules_go//go:def.bzl", "go_binary", "go_library", "go_test")
load("//:oci.bzl", "oci_image_for_service")

go_library(
    name = "experiment_state_server_lib",
    srcs = [
        "health.go",
        "main.go",
    ],
    embedsrcs = glob(["static/**"]),
    importpath = "xmanager_cloud/cmd/experiment_state_server/main",
    deps = [
        "//api/protos/components/v1alpha1",
        "//api/protos/experiment:api_go_proto",
        "//api/protos/xid:api_go_proto",
        "//cmd/experiment_state_server/config",
        "//cmd/experiment_state_server/server",
        "//internal/auth",
        "//internal/common/health",
        "//internal/logging",
        "//internal/security/keyreloader",
        "//internal/security/tlsutil",
        "//internal/storage/spanner",
        "//internal/task_queue",
        "//pkg/auth/oauth2",
        "//pkg/auth/oauth2/mock",
        "//pkg/components/cms",
        "//pkg/components/store",
        "@com_github_grpc_ecosystem_grpc_gateway_v2//runtime",
        "@com_github_prometheus_client_golang//prometheus/promhttp",
        "@com_google_cloud_go_spanner//:spanner",
        "@org_golang_google_api//cloudidentity/v1beta1",
        "@org_golang_google_api//option",
        "@org_golang_google_grpc//:grpc",
        "@org_golang_google_grpc//credentials/insecure",
        "@org_golang_google_grpc//health",
        "@org_golang_google_grpc//health/grpc_health_v1",
        "@org_golang_google_grpc//reflection",
        "@org_golang_x_sync//errgroup",
    ],
)

go_binary(
    name = "experiment_state_server",
    embed = [":experiment_state_server_lib"],
    pure = "on",
    visibility = ["//visibility:public"],
)

go_binary(
    name = "experiment_state_server_dev",
    embed = [":experiment_state_server_lib"],
    gotags = ["mockauth"],
    pure = "on",
    visibility = ["//visibility:public"],
)

oci_image_for_service(
    name = "experiment_state_server_image",
    binary = ":experiment_state_server_dev",
)

go_test(
    name = "health_test",
    srcs = ["health_test.go"],
    embed = [":experiment_state_server_lib"],
    deps = [
        "//cmd/experiment_state_server/server",
        "//internal/storage/spanner/migrations/version",
    ],
)
