load("@io_bazel_rules_go//go:def.bzl", "go_binary", "go_library", "go_test")
load("//:oci.bzl", "oci_image_for_service")

package(default_visibility = ["//visibility:private"])

go_library(
    name = "actuator_lib",
    srcs = [
        "config.go",
        "health.go",
        "main.go",
        "metadata.go",
        "prod.go",
    ],
    importpath = "xmanager_cloud/cmd/actuator/main",
    deps = [
        "//cmd/actuator/k8s_client",
        "//cmd/actuator/pausescheduling",
        "//cmd/actuator/workunittaskhandler",
        "//internal/broadcast",
        "//internal/common/health",
        "//internal/configutil",
        "//internal/featureflags",
        "//internal/gcemetadata",
        "//internal/kubernetes/common/constants",
        "//internal/logging",
        "//internal/security/keyreloader",
        "//internal/storage",
        "//internal/storage/dbconfig",
        "//internal/storage/factory",
        "//internal/task_queue_redis/redisclient",
        "//pkg/auth/jwks",
        "@com_github_prometheus_client_golang//prometheus/promhttp",
        "@io_k8s_client_go//kubernetes",
        "@io_k8s_sigs_controller_runtime//:controller-runtime",
        "@org_golang_x_sync//errgroup",
    ],
)

go_test(
    name = "actuator_test",
    srcs = [
        "health_test.go",
        "main_test.go",
        "prod_test.go",
    ],
    embed = [":actuator_lib"],
    deps = [
        "//internal/common/health",
        "//internal/task_queue_redis/redisclient",
        "@io_k8s_client_go//kubernetes",
        "@io_k8s_client_go//kubernetes/fake",
    ],
)

go_binary(
    name = "actuator",
    embed = [":actuator_lib"],
    pure = "on",
    visibility = ["//visibility:public"],
)

oci_image_for_service(
    name = "actuator_image",
    binary = ":actuator",
)
