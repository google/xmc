load("@io_bazel_rules_go//go:def.bzl", "go_binary", "go_library", "go_test")
load("//:oci.bzl", "oci_image_for_service")

package(default_visibility = ["//visibility:private"])

go_library(
    name = "ingestion_gateway_lib",
    srcs = ["main.go"],
    importpath = "xmanager_cloud/cmd/ingestion_gateway",
    deps = [
        "//cmd/ingestion_gateway/ingestiongateway",
        "//internal/compat/google",
        "//internal/logging",
    ],
)

go_binary(
    name = "ingestion_gateway",
    embed = [":ingestion_gateway_lib"],
    pure = "on",
    visibility = ["//visibility:public"],
)

oci_image_for_service(
    name = "ingestion_gateway_image",
    binary = ":ingestion_gateway",
)

go_test(
    name = "ingestion_gateway_test",
    srcs = ["main_test.go"],
    embed = [":ingestion_gateway_lib"],
    deps = [
        "//cmd/ingestion_gateway/ingestiongateway",
        "@io_k8s_apimachinery//pkg/apis/meta/v1/unstructured",
    ],
)
