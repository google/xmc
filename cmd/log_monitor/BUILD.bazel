load("@io_bazel_rules_go//go:def.bzl", "go_binary")
load("//:compat.bzl", "compat_go_library", "compat_go_test")
load("//:oci.bzl", "oci_image_for_service")

compat_go_library(
    name = "log_monitor_lib",
    srcs = [
        "config.go",
        "database.go",
        "health.go",
        "listener.go",
        "log_processor.go",
        "main.go",
    ],
    importpath = "xmanager_cloud/cmd/log_monitor",
    visibility = ["//visibility:private"],
    deps = [
        "//api/protos/experiment:messages_go_proto",
        "//internal/common/health",
        "//internal/grpcerr",
        "//internal/kubernetes/common/constants",
        "//internal/kubernetes/common/labels",
        "//internal/logging",
        "//internal/storage",
        "//internal/storage/spanner",
        "@com_google_cloud_go_pubsub//:pubsub",
        "@com_google_cloud_go_spanner//:spanner",
        "@org_golang_google_api//option",
        "@org_golang_google_protobuf//types/known/fieldmaskpb:go_default_library",
        "@org_golang_google_protobuf//types/known/timestamppb:go_default_library",
        "@org_golang_x_sync//errgroup:go_default_library",
    ],
)

go_binary(
    name = "log_monitor",
    embed = [":log_monitor_lib"],
    pure = "on",
    visibility = ["//visibility:public"],
)

oci_image_for_service(
    name = "log_monitor_image",
    binary = ":log_monitor",
)

compat_go_test(
    name = "log_monitor_test",
    srcs = [
        "config_test.go",
        "health_test.go",
        "listener_test.go",
        "log_processor_test.go",
    ],
    embed = [":log_monitor_lib"],
    deps = [
        "//api/protos/experiment:messages_go_proto",
        "//internal/grpcerr",
        "//internal/storage",
        "//internal/storage/spanner/migrations/version",
        "@com_github_google_go_cmp//cmp",
        "@com_google_cloud_go_pubsub//:pubsub",
        "@com_google_cloud_go_pubsub//pstest",
        "@org_golang_google_api//option",
        "@org_golang_google_grpc//:go_default_library",
        "@org_golang_google_grpc//credentials/insecure:go_default_library",
        "@org_golang_google_protobuf//testing/protocmp",
        "@org_golang_google_protobuf//types/known/fieldmaskpb:go_default_library",
        "@org_golang_google_protobuf//types/known/timestamppb:go_default_library",
    ],
)
