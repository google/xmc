load("@io_bazel_rules_go//go:def.bzl", "go_binary", "go_library", "go_test")

go_library(
    name = "log_monitor_lib",
    srcs = [
        "config.go",
        "database.go",
        "health.go",
        "listener.go",
        "log_processor.go",
        "main.go",
    ],
    importpath = "xmanager_cloud/cmd/log_monitor",
    visibility = ["//visibility:private"],
    deps = [
        "//api/protos/experiment:messages_go_proto",
        "//internal/common:health",
        "//internal/compat/field_mask",
        "//internal/compat/google",
        "//internal/compat/spanner",
        "//internal/compat/status",
        "//internal/kubernetes/common:constants",
        "//internal/kubernetes/common/labels",
        "//internal/logging",
        "//internal/storage",
        "//internal/storage/spanner",
        "@org_golang_google_api//option",
        "@org_golang_google_protobuf//types/known/timestamppb",
    ],
)

go_binary(
    name = "log_monitor",
    embed = [":log_monitor_lib"],
    visibility = ["//visibility:public"],
)

go_test(
    name = "log_monitor_test",
    srcs = [
        "config_test.go",
        "health_test.go",
        "listener_test.go",
        "log_processor_test.go",
    ],
    embed = [":log_monitor_lib"],
    deps = [
        "//api/protos/experiment:messages_go_proto",
        "//internal/compat/cmp",
        "//internal/compat/field_mask",
        "//internal/compat/protocmp",
        "//internal/compat/status",
        "//internal/storage",
        "//internal/storage/spanner/emulator",
        "@org_golang_google_api//option",
        "@org_golang_google_protobuf//types/known/timestamppb",
    ],
)
