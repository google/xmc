load("@io_bazel_rules_go//go:def.bzl", "go_library", "go_test")

package(default_visibility = ["//cmd/study_controller:__subpackages__"])

go_library(
    name = "worker",
    srcs = [
        "consumer.go",
        "handler.go",
        "payload.go",
    ],
    importpath = "xmanager_cloud/cmd/study_controller/worker",
    deps = [
        "//api/protos/task_queue:task_go_proto",
        "//internal/kubernetes/common/constants",
        "//internal/logging",
        "//internal/task_queue_redis/redisclient",
        "//internal/validator",
        "@org_golang_google_protobuf//encoding/protojson",
    ],
)

go_test(
    name = "worker_test",
    srcs = [
        "consumer_test.go",
        "handler_test.go",
        "payload_test.go",
    ],
    embed = [":worker"],
    deps = [
        "//internal/kubernetes/common/constants",
        "//internal/logging",
        "//internal/task_queue_redis/redisclient",
        "@com_github_google_go_cmp//cmp",
        "@com_github_redis_go_redis_v9//:go-redis",
    ],
)
