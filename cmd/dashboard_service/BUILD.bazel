load("@io_bazel_rules_go//go:def.bzl", "go_binary", "go_library", "go_test")
load("//:oci.bzl", "oci_image_for_service")

go_library(
    name = "dashboard_service_lib",
    srcs = [
        "config.go",
        "main.go",
    ],
    importpath = "xmanager_cloud/cmd/dashboard_service/main",
    visibility = ["//visibility:private"],
    deps = [
        "//api/protos/dashboard:api_go_grpc_proto",
        "//api/protos/dashboard:api_go_proto",
        "//api/protos/xid:api_go_proto",
        "//cmd/dashboard_service/server",
        "//internal/auth",
        "//internal/common/health",
        "//internal/configutil",
        "//internal/dashboard/dataengine",
        "//internal/logging",
        "//internal/storage/spanner/dashboard",
        "//pkg/auth/oauth2",
        "//pkg/clickhouse",
        "//pkg/clickhouse/componentconfig",
        "//pkg/components/crreader",
        "@com_github_grpc_ecosystem_grpc_gateway_v2//runtime",
        "@com_google_cloud_go_spanner//:spanner",
        "@io_k8s_apimachinery//pkg/api/errors",
        "@org_golang_google_api//cloudidentity/v1beta1",
        "@org_golang_google_api//option",
        "@org_golang_google_grpc//:grpc",
        "@org_golang_google_grpc//credentials/insecure",
        "@org_golang_google_grpc//health",
        "@org_golang_google_grpc//health/grpc_health_v1",
        "@org_golang_google_grpc//reflection",
    ],
)

go_binary(
    name = "dashboard_service",
    embed = [":dashboard_service_lib"],
    pure = "on",
    visibility = ["//visibility:public"],
)

oci_image_for_service(
    name = "dashboard_service_image",
    binary = ":dashboard_service",
)

go_test(
    name = "config_test",
    srcs = ["config_test.go"],
    embed = [":dashboard_service_lib"],
)

go_test(
    name = "main_test",
    srcs = ["main_test.go"],
    embed = [":dashboard_service_lib"],
    deps = [
        "//cmd/dashboard_service/server",
        "//internal/dashboard/dataengine",
        "//pkg/auth/oauth2",
        "//pkg/clickhouse",
        "//pkg/clickhouse/componentconfig",
        "//pkg/components/crreader/crreadertest",
        "@com_github_clickhouse_clickhouse_go_v2//lib/driver",
        "@com_github_google_go_cmp//cmp",
        "@com_github_grpc_ecosystem_grpc_gateway_v2//runtime",
        "@io_k8s_apimachinery//pkg/api/errors",
        "@io_k8s_apimachinery//pkg/apis/meta/v1/unstructured",
        "@io_k8s_apimachinery//pkg/runtime/schema",
        "@org_golang_google_grpc//:grpc",
        "@org_golang_google_grpc//metadata",
    ],
)
