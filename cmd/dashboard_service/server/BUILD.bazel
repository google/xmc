load("@io_bazel_rules_go//go:def.bzl", "go_library", "go_test")

go_library(
    name = "server",
    srcs = [
        "chartacl.go",
        "createchart.go",
        "createdashboard.go",
        "deletechart.go",
        "deletedashboard.go",
