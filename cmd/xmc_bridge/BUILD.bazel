load("@io_bazel_rules_go//go:def.bzl", "go_binary", "go_library", "go_test")
load("//:oci.bzl", "oci_image_for_service")

package(default_visibility = ["//visibility:public"])

go_library(
    name = "xmc_bridge_lib",
    srcs = [
        "main.go",
    ],
    importpath = "xmanager_cloud/cmd/xmc_bridge",
    visibility = ["//visibility:private"],
    deps = [
        "//api/protos/components/v1alpha1",
        "//internal/logging",
        "//pkg/components/bridge",
        "//pkg/components/bridge/statussync",
        "@io_k8s_apimachinery//pkg/apis/meta/v1:meta",
        "@io_k8s_apimachinery//pkg/apis/meta/v1/unstructured",
        "@io_k8s_apimachinery//pkg/runtime",
        "@io_k8s_apimachinery//pkg/runtime/schema",
        "@io_k8s_apimachinery//pkg/types",
        "@io_k8s_client_go//discovery",
        "@io_k8s_client_go//discovery/cached/memory",
        "@io_k8s_client_go//dynamic",
        "@io_k8s_client_go//kubernetes",
        "@io_k8s_client_go//rest",
        "@io_k8s_client_go//restmapper",
        "@io_k8s_client_go//tools/clientcmd",
        "@org_golang_google_grpc//:grpc",
        "@org_golang_google_grpc//credentials/insecure",
    ],
)

go_binary(
    name = "xmc_bridge",
    embed = [":xmc_bridge_lib"],
    pure = "on",
    visibility = ["//visibility:public"],
)

oci_image_for_service(
    name = "xmc_bridge_image",
    binary = ":xmc_bridge",
)

go_test(
    name = "xmc_bridge_test",
    srcs = [
        "main_test.go",
    ],
    embed = [":xmc_bridge_lib"],
    deps = [
        "//api/protos/components/v1alpha1",
        "//pkg/components/bridge",
        "@io_k8s_apimachinery//pkg/apis/meta/v1:meta",
        "@io_k8s_apimachinery//pkg/apis/meta/v1/unstructured",
        "@io_k8s_apimachinery//pkg/runtime",
        "@io_k8s_apimachinery//pkg/runtime/schema",
        "@io_k8s_client_go//dynamic/fake",
        "@io_k8s_client_go//testing",
        "@org_golang_google_grpc//:grpc",
    ],
)
