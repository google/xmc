load("@io_bazel_rules_go//go:def.bzl", "go_binary")
load("//:compat.bzl", "compat_go_library", "compat_go_test")
load("//:oci.bzl", "oci_image_for_service")

compat_go_library(
    name = "config",
    srcs = ["config/config.go"],
    importpath = "xmanager_cloud/cmd/xid_service",
    visibility = ["//visibility:public"],
    deps = [
        "//internal/auth",
        "//internal/compat/log",
        "//internal/logging",
    ],
)

compat_go_library(
    name = "xid_service_lib",
    srcs = [
        "health.go",
        "main.go",
    ],
    importpath = "xmanager_cloud/cmd/xid_service/main",
    visibility = ["//visibility:private"],
    deps = [
        ":config",
        "//api/protos/xid:api_go_proto",
        "//cmd/xid_service/server",
        "//internal/auth",
        "//internal/common/health",
        "//internal/compat/google",
        "//internal/compat/spanner",
        "//internal/logging",
        "//internal/storage/spanner",
        "//pkg/auth/oauth2",
        "@com_google_cloud_go_spanner//:spanner",
        "@org_golang_google_api//cloudidentity/v1beta1",
        "@org_golang_google_api//option",
        "@org_golang_google_grpc//:go_default_library",
        "@org_golang_google_grpc//credentials/insecure:go_default_library",
        "@org_golang_google_grpc//health:go_default_library",
        "@org_golang_google_grpc//health/grpc_health_v1:go_default_library",
        "@org_golang_google_grpc//reflection:go_default_library",
    ],
)

go_binary(
    name = "xid_service",
    embed = [":xid_service_lib"],
    pure = "on",
    visibility = ["//visibility:public"],
)

oci_image_for_service(
    name = "xid_service_image",
    binary = ":xid_service",
)

compat_go_test(
    name = "health_test",
    srcs = ["health_test.go"],
    embed = [":xid_service_lib"],
    deps = [
        "//internal/storage/spanner/migrations/version",
        "@org_golang_google_grpc//:go_default_library",
        "@org_golang_google_grpc//health/grpc_health_v1:go_default_library",
    ],
)
