load("@io_bazel_rules_go//go:def.bzl", "go_binary", "go_library", "go_test")
load("//:oci.bzl", "oci_image_for_service")

go_library(
    name = "xid_service_lib",
    srcs = [
        "health.go",
        "main.go",
    ],
    importpath = "xmanager_cloud/cmd/xid_service/main",
    visibility = ["//visibility:private"],
    deps = [
        "//api/protos/xid:api_go_proto",
        "//cmd/xid_service/config",
        "//cmd/xid_service/server",
        "//internal/common/health",
        "//internal/logging",
        "//pkg/auth/oauth2",
        "@org_golang_google_grpc//:grpc",
        "@org_golang_google_grpc//credentials/insecure",
        "@org_golang_google_grpc//health",
        "@org_golang_google_grpc//health/grpc_health_v1",
        "@org_golang_google_grpc//reflection",
    ],
)

go_binary(
    name = "xid_service",
    embed = [":xid_service_lib"],
    pure = "on",
    visibility = ["//visibility:public"],
)

oci_image_for_service(
    name = "xid_service_image",
    binary = ":xid_service",
)

go_test(
    name = "health_test",
    srcs = [
        "health_test.go",
        "main_test.go",
    ],
    embed = [":xid_service_lib"],
    deps = [
        "//api/protos/xid:api_go_proto",
        "//cmd/xid_service/config",
        "//cmd/xid_service/server",
        "//internal/auth",
        "//internal/storage",
        "//internal/storage/spanner/migrations/version",
        "@org_golang_google_grpc//:grpc",
        "@org_golang_google_grpc//credentials/insecure",
        "@org_golang_google_grpc//health/grpc_health_v1",
        "@org_golang_google_grpc//reflection",
    ],
)
