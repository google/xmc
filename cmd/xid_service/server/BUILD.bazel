load("@io_bazel_rules_go//go:def.bzl", "go_library", "go_test")

go_library(
    name = "server",
    srcs = [
        "checkuserauthorization.go",
        "createxidentry.go",
        "getxidentry.go",
        "listxidentries.go",
        "runtime.go",
        "server.go",
        "updatexidentry.go",
    ],
    importpath = "xmanager_cloud/cmd/xid_service/server",
    visibility = ["//visibility:public"],
    deps = [
        "//api/protos/xid:api_go_proto",
        "//api/protos/xid:messages_go_proto",
        "//cmd/xid_service/config",
        "//cmd/xid_service/xid",
        "//internal/auth",
        "//internal/common/health",
        "//internal/grpcerr",
        "//internal/logging",
        "//internal/storage",
        "//internal/storage/spanner",
        "//internal/storage/spanner/clisession",
        "//internal/validator",
        "//pkg/auth/jwks",
        "//pkg/auth/oauth2",
        "//pkg/auth/oauth2/mock",
        "@com_google_cloud_go_spanner//:spanner",
        "@org_golang_google_api//cloudidentity/v1beta1",
        "@org_golang_google_api//option",
        "@org_golang_google_grpc//status",
    ],
)

go_test(
    name = "server_test",
    srcs = [
        "checkuserauthorization_test.go",
        "createxidentry_test.go",
        "getxidentry_test.go",
        "listxidentries_test.go",
        "runtime_test.go",
        "server_test.go",
        "updatexidentry_test.go",
    ],
    embed = [":server"],
    # Shard across 4 parallel executors to divide Spanner emulator database
    # setup and live integration tests from ~26s down to ~18s.
    shard_count = 4,
    deps = [
        "//api/protos/xid:api_go_proto",
        "//api/protos/xid:messages_go_proto",
        "//cmd/xid_service/config",
        "//internal/auth",
        "//internal/grpcerr",
        "//internal/prototest",
        "//internal/storage",
        "//internal/storage/spanner",
        "//internal/storage/spanner/emulator",
        "//internal/validator",
        "@com_github_google_go_cmp//cmp",
        "@org_golang_google_api//cloudidentity/v1beta1",
        "@org_golang_google_grpc//status",
        "@org_golang_google_protobuf//proto",
        "@org_golang_google_protobuf//testing/protocmp",
        "@org_golang_google_protobuf//types/known/fieldmaskpb",
    ],
)
