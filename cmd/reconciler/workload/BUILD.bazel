load("@io_bazel_rules_go//go:def.bzl", "go_library", "go_test")

go_library(
    name = "workload",
    srcs = [
        "converter.go",
        "reconciler.go",
    ],
    importpath = "xmanager_cloud/cmd/reconciler/workload",
    visibility = ["//visibility:public"],
    deps = [
        "//api/protos/experiment:messages_go_proto",
        "//internal/compat/field_mask",
        "//internal/logging",
