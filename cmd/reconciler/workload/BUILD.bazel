go_test(
    name = "workload_test",
    srcs = [
        "converter_test.go",
        "reconciler_test.go",
    ],
    embed = [":workload"],
    deps = [
        "//api/protos/experiment:messages_go_proto",
        "//internal/compat/cmp",
        "//internal/compat/field_mask",
        "//internal/compat/protocmp",
        "//internal/kubernetes/common:constants",
        "//internal/storage",
        "@io_k8s_api//core/v1:core",
        "@io_k8s_sigs_controller_runtime//pkg/client/fake",
    ],
