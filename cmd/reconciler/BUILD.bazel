load("@io_bazel_rules_go//go:def.bzl", "go_binary", "go_library", "go_test")
load("//:oci.bzl", "oci_image_for_service")

go_library(
    name = "reconciler_lib",
    srcs = [
        "config.go",
        "controllers.go",
        "health.go",
        "main.go",
        "manager.go",
        "metadata.go",
    ],
    importpath = "xmanager_cloud/cmd/reconciler",
    visibility = ["//visibility:private"],
    deps = [
        "//api/protos/experiment:messages_go_proto",
        "//cmd/actuator/k8s_client",
        "//cmd/reconciler/clusterqueue",
        "//cmd/reconciler/hypercomputeclient",
        "//cmd/reconciler/jobset",
        "//cmd/reconciler/kueue_sync",
        "//cmd/reconciler/shared",
        "//cmd/reconciler/workload",
        "//internal/common/health",
        "//internal/configutil",
        "//internal/gcemetadata",
        "//internal/kubernetes/common/constants",
        "//internal/logging",
        "//internal/storage",
        "//internal/storage/spanner",
        "//internal/workunit",
        "@com_github_go_logr_logr//:logr",
        "@com_google_cloud_go_spanner//:spanner",
        "@io_k8s_api//core/v1:core",
        "@io_k8s_apimachinery//pkg/labels",
        "@io_k8s_apimachinery//pkg/runtime",
        "@io_k8s_apimachinery//pkg/selection",
        "@io_k8s_client_go//kubernetes/scheme",
        "@io_k8s_sigs_controller_runtime//:controller-runtime",
        "@io_k8s_sigs_controller_runtime//pkg/cache",
        "@io_k8s_sigs_controller_runtime//pkg/client",
        "@io_k8s_sigs_controller_runtime//pkg/config",
        "@io_k8s_sigs_controller_runtime//pkg/healthz",
        "@io_k8s_sigs_controller_runtime//pkg/manager",
        "@io_k8s_sigs_controller_runtime//pkg/metrics/server",
        "@io_k8s_sigs_jobset//api/jobset/v1alpha2",
        "@io_k8s_sigs_kueue//apis/kueue/v1beta1",
        "@org_golang_google_api//option",
        "@org_golang_x_sync//errgroup",
    ],
)

go_test(
    name = "reconciler_test",
    srcs = [
        "controllers_test.go",
        "health_test.go",
        "main_test.go",
        "manager_test.go",
    ],
    embed = [":reconciler_lib"],
    deps = [
        "//internal/storage/spanner/migrations/version",
        "@io_k8s_apimachinery//pkg/version",
        "@io_k8s_client_go//discovery",
        "@io_k8s_client_go//kubernetes",
        "@io_k8s_client_go//kubernetes/fake",
        "@io_k8s_sigs_controller_runtime//pkg/client/fake",
    ],
)

go_binary(
    name = "reconciler",
    embed = [":reconciler_lib"],
    pure = "on",
    visibility = ["//visibility:public"],
)

oci_image_for_service(
    name = "reconciler_image",
    binary = ":reconciler",
)
