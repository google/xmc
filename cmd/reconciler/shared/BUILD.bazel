load("@io_bazel_rules_go//go:def.bzl", "go_library", "go_test")

go_library(
    name = "shared",
    srcs = [
        "batcher.go",
        "batcher_retry.go",
        "batcher_work_unit_not_found.go",
        "lifecycle.go",
        "storage_errors.go",
    ],
    importpath = "xmanager_cloud/cmd/reconciler/shared",
    visibility = ["//visibility:public"],
    deps = [
        "//api/protos/experiment:messages_go_proto",
        "//api/protos/task_queue:task_go_proto",
        "//internal/logging",
        "//internal/storage",
        "//internal/validator",
        "//internal/workunit",
        "@com_github_prometheus_client_golang//prometheus",
        "@com_github_prometheus_client_golang//prometheus/promauto",
        "@io_k8s_sigs_controller_runtime//pkg/metrics",
        "@org_golang_google_grpc//codes",
        "@org_golang_google_grpc//status",
        "@org_golang_google_protobuf//proto",
    ],
)

go_test(
    name = "shared_test",
    srcs = [
        "batcher_retry_test.go",
        "batcher_test.go",
        "batcher_work_unit_not_found_test.go",
        "storage_errors_test.go",
    ],
    embed = [":shared"],
    deps = [
        "//api/protos/experiment:messages_go_proto",
        "//api/protos/task_queue:task_go_proto",
        "//internal/grpcerr",
        "//internal/storage",
        "//internal/workunit",
        "@com_github_google_go_cmp//cmp",
        "@com_github_google_go_cmp//cmp/cmpopts",
        "@com_github_prometheus_client_golang//prometheus/testutil",
        "@com_github_prometheus_client_model//go",
        "@org_golang_google_grpc//codes",
        "@org_golang_google_grpc//status",
        "@org_golang_google_protobuf//proto",
        "@org_golang_google_protobuf//testing/protocmp",
    ],
)
