load("@io_bazel_rules_go//go:def.bzl", "go_library", "go_test")

package(default_visibility = ["//visibility:private"])

go_library(
    name = "metricsingester",
    srcs = [
        "bigquery_writer.go",
        "config.go",
        "health.go",
        "ingester.go",
        "normalize.go",
        "subscription.go",
        "writer.go",
    ],
    importpath = "xmanager_cloud/cmd/metrics_ingester/metricsingester",
    visibility = [
        "//cmd/metrics_ingester:__subpackages__",
        "//test/metrics:__pkg__",
    ],
    deps = [
        "//api/protos/metrics:metrics_go_proto",
        "//internal/logging",
        "@com_github_clickhouse_clickhouse_go_v2//lib/driver",
        "@com_google_cloud_go_pubsub//:pubsub",
        "@org_golang_google_protobuf//encoding/protowire",
        "@org_golang_google_protobuf//proto",
        "@org_golang_google_protobuf//types/descriptorpb",
    ],
)

go_test(
    name = "metricsingester_test",
    srcs = [
        "bigquery_writer_test.go",
        "config_test.go",
        "health_test.go",
        "ingester_test.go",
        "normalize_test.go",
        "subscription_test.go",
        "writer_test.go",
    ],
    data = [
        "//deploy/bigquery:schema.json",
    ],
    embed = [":metricsingester"],
    deps = [
        "//api/protos/metrics:metrics_go_proto",
        "//internal/prototest",
        "@com_github_clickhouse_clickhouse_go_v2//lib/driver",
        "@com_github_google_go_cmp//cmp",
        "@com_google_cloud_go_bigquery//:bigquery",
        "@com_google_cloud_go_bigquery//storage/managedwriter/adapt",
        "@com_google_cloud_go_pubsub//:pubsub",
        "@com_google_cloud_go_pubsub//pstest",
        "@org_golang_google_api//option",
        "@org_golang_google_grpc//:grpc",
        "@org_golang_google_grpc//credentials/insecure",
        "@org_golang_google_protobuf//proto",
        "@org_golang_google_protobuf//reflect/protodesc",
        "@org_golang_google_protobuf//reflect/protoreflect",
        "@org_golang_google_protobuf//testing/protocmp",
        "@org_golang_google_protobuf//types/dynamicpb",
    ],
)
