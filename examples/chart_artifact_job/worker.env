# ==============================================================================
# Worker Environment Configuration for the xmcv2 GKE Cluster
# ==============================================================================

# Target GKE Environment and Namespace
XMANAGER_ENV="xmcv2"
K8S_NAMESPACE="xmc"

# Ingestion Gateway the worker posts metrics to (cluster-internal service DNS). The
# gateway publishes to Redpanda and a ClickHouse materialized view lands the rows in
# default.xmc_metrics, which is what the dashboard charts read back.
XMC_GATEWAY_URL="http://ingestion-gateway-service.xmc.svc.cluster.local:8080/api/v1/metrics"

# Dashboard Service endpoint used by launch.py. Left unset, it is derived from
# XMANAGER_UI_URL or XMANAGER_ENDPOINT as https://<domain>/v1/dashboards. Set it to an
# http(s):// URL to force the transcoded REST route, or to a host:port to use gRPC
# directly (which needs `kubectl port-forward -n xmc svc/dashboard-service 50051:50051`).
# XMC_DASHBOARD_ENDPOINT="localhost:50051"

# WorkUnit Simulation Parameters
CHART_DEMO_TOTAL_STEPS="60"
QUEUE_NAME="cpu-queue"

# Sampler seed. Left unset, launch.py draws one per run and prints it in its banner;
# set it to the printed value to reproduce that run.
# CHART_DEMO_SEED="123456"
