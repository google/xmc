load("@rules_python//python:defs.bzl", "py_library", "py_test")

# Only the dependency-free modules are built here. `launch.py` and `worker.py` are run
# from the CLI virtualenv and the worker image respectively, and depend on packages that
# are not part of this Bazel workspace.

py_library(
    name = "training_metrics",
    srcs = ["training_metrics.py"],
    imports = ["."],
    visibility = ["//visibility:private"],
)

py_library(
    name = "dashboard_rest_client",
    srcs = ["dashboard_rest_client.py"],
    imports = ["."],
    visibility = ["//visibility:private"],
)

py_test(
    name = "training_metrics_test",
    srcs = ["training_metrics_test.py"],
    deps = [":training_metrics"],
)

py_test(
    name = "dashboard_rest_client_test",
    srcs = ["dashboard_rest_client_test.py"],
    deps = [":dashboard_rest_client"],
)
