# ==============================================================================
# Worker Environment Configuration for xmcv2 GKE Cluster
# ==============================================================================

# Target GKE Environment and Namespace
XMANAGER_ENV="xmcv2"
K8S_NAMESPACE="xmc"

# ClickHouse Database Connection Settings (Cluster-Internal Service DNS)
# ClickHouse is deployed in the 'xmc-metrics' namespace on the same cluster.
CLICKHOUSE_HOST="clickhouse.xmc-metrics.svc.cluster.local"
CLICKHOUSE_PORT="8123"
CLICKHOUSE_USER="default"
CLICKHOUSE_PASSWORD=""
CLICKHOUSE_DATABASE="default"
CLICKHOUSE_SECURE="false"
CLICKHOUSE_TABLE="xmc_metrics"

# WorkUnit Simulation Parameters
NUM_STEPS="100"
XMC_JOB_NAME="clickhouse-metric-writer"
XMC_REPLICA_ID="0"
