load("@bazel_gazelle//:def.bzl", "gazelle")
load("@io_bazel_rules_go//go:def.bzl", "nogo")

# gazelle:prefix xmanager_cloud

nogo(
    name = "xmc_nogo",
    config = "nogo_config.json",
    visibility = ["//visibility:public"],
    deps = [
        "@io_bazel_rules_go//go/tools/builders:nogo_srcs",
    ],
)

# Proto stubs target package mappings (matching how Go codebase imports our proto stubs)
# gazelle:resolve go xmanager_cloud/api/filter/filter_expression_go_proto //api/filter:filter_expression_go_proto
# gazelle:resolve go xmanager_cloud/experiment_state_server/proto/messages_go_proto //api/protos/experiment:messages_go_proto
# gazelle:resolve go xmanager_cloud/experiment_state_server/proto/api_go_proto //api/protos/experiment:api_go_proto
# gazelle:resolve go xmanager_cloud/experiment_state_server/proto/api_go_grpc_proto //api/protos/experiment:api_go_proto
# gazelle:resolve go xmanager_cloud/health_service/proto/api_go_proto //api/protos/health:api_go_proto
# gazelle:resolve go xmanager_cloud/health_service/proto/api_go_grpc_proto //api/protos/health:api_go_proto
# gazelle:resolve go xmanager_cloud/xid_service/proto/messages_go_proto //api/protos/xid:messages_go_proto
# gazelle:resolve go xmanager_cloud/xid_service/proto/api_go_proto //api/protos/xid:api_go_proto
# gazelle:resolve go xmanager_cloud/xid_service/proto/api_go_grpc_proto //api/protos/xid:api_go_proto
# gazelle:resolve go xmanager_cloud/task_queue/proto/task_go_proto //api/protos/task_queue:task_go_proto

gazelle(name = "gazelle")

filegroup(
    name = "internal_libs",
    srcs = [
        "//internal/auth",
        "//internal/common/health",
        "//internal/common/interfaces",
        "//internal/grpcerr",
        "//internal/kubernetes/common/labels",
        "//internal/logging",
        "//internal/query_generator/equalityvisitor",
        "//internal/query_generator/filter",
        "//internal/query_generator/liststatement",
        "//internal/query_generator/normalizer",
        "//internal/query_generator/querytools",
        "//internal/safesql",
        "//internal/security/jwtkeyset",
        "//internal/security/keyreloader",
        "//internal/security/securitytest",
        "//internal/task_queue",
        "//internal/task_queue_redis/redisclient",
        "//internal/task_queue_redis/validator",
        "//internal/validator",
    ],
    visibility = ["//visibility:public"],
)

test_suite(
    name = "internal_tests",
    tests = [
        "//internal/auth:auth_test",
        "//internal/common/health:health_test",
        "//internal/grpcerr:grpcerr_test",
        "//internal/kubernetes/common/labels:labels_test",
        "//internal/logging:logging_test",
        "//internal/prototest:prototest_test",
        "//internal/query_generator/equalityvisitor:equalityvisitor_test",
        "//internal/query_generator/filter:filter_test",
        "//internal/query_generator/liststatement:liststatement_test",
        "//internal/query_generator/normalizer:normalizer_test",
        "//internal/query_generator/querytools:querytools_test",
        "//internal/safesql:safesql_test",
        "//internal/security/jwtkeyset:jwtkeyset_test",
        "//internal/security/keyreloader:keyreloader_test",
        "//internal/task_queue:task_queue_test",
        "//internal/validator:validator_test",
    ],
)
