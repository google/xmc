load("@bazel_gazelle//:def.bzl", "gazelle")
load("@io_bazel_rules_go//go:def.bzl", "TOOLS_NOGO", "nogo")

# gazelle:prefix xmanager_cloud

nogo(
    name = "xmc_nogo",
    config = "nogo_config.json",
    visibility = ["//visibility:public"],
    # Go 1.22+ gives each loop iteration its own variable, and rules_go's nogo
    # runner omits GoVersion on packages, causing loopclosure false positives on
    # parallel subtests and goroutines written for Go 1.26.
    deps = [
        dep
        for dep in TOOLS_NOGO
        if not dep.endswith("/loopclosure:go_default_library")
    ] + [
        "//tools/lint/xmc_analyzers/jobsetpolicy",
        "@org_golang_x_tools//go/analysis/passes/hostport:go_default_library",
        "@org_golang_x_tools//go/analysis/passes/httpmux:go_default_library",
        "@org_golang_x_tools//go/analysis/passes/reflectvaluecompare:go_default_library",
        "@org_golang_x_tools//go/analysis/passes/scannererr:go_default_library",
        "@org_golang_x_tools//go/analysis/passes/sqlrowserr:go_default_library",
        "@org_golang_x_tools//go/analysis/passes/stdversion:go_default_library",
        "@org_golang_x_tools//go/analysis/passes/unusedwrite:go_default_library",
        "@org_golang_x_tools//go/analysis/passes/waitgroup:go_default_library",
    ],
)

gazelle(name = "gazelle")

filegroup(
    name = "internal_libs",
    srcs = [
        "//internal/auth",
        "//internal/common/health",
        "//internal/common/interfaces",
        "//internal/grpcerr",
        "//internal/kubernetes/common/labels",
        "//internal/logging",
        "//internal/query_generator/dialect/postgres",
        "//internal/query_generator/dialect/spanner",
        "//internal/query_generator/equalityvisitor",
        "//internal/query_generator/filter",
        "//internal/query_generator/liststatement",
        "//internal/query_generator/normalizer",
        "//internal/query_generator/querytools",
        "//internal/safesql",
        "//internal/security/jwtkeyset",
        "//internal/security/keyreloader",
        "//internal/security/securitytest",
        "//internal/task_queue",
        "//internal/task_queue_redis/redisclient",
        "//internal/task_queue_redis/validator",
        "//internal/validator",
    ],
    visibility = ["//visibility:public"],
)

test_suite(
    name = "internal_tests",
    tests = [
        "//internal/auth:auth_test",
        "//internal/common/health:health_test",
        "//internal/grpcerr:grpcerr_test",
        "//internal/kubernetes/common/labels:labels_test",
        "//internal/logging:logging_test",
        "//internal/prototest:prototest_test",
        "//internal/query_generator/equalityvisitor:equalityvisitor_test",
        "//internal/query_generator/filter:filter_test",
        "//internal/query_generator/liststatement:liststatement_test",
        "//internal/query_generator/normalizer:normalizer_test",
        "//internal/query_generator/querytools:querytools_test",
        "//internal/safesql:safesql_test",
        "//internal/security/jwtkeyset:jwtkeyset_test",
        "//internal/security/keyreloader:keyreloader_test",
        "//internal/task_queue:task_queue_test",
        "//internal/validator:validator_test",
    ],
)
