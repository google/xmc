load("@io_bazel_rules_go//go:def.bzl", "go_library")

filegroup(
    name = "rules",
    srcs = ["rules.yaml"],
    visibility = ["//visibility:public"],
)

# The stable-2026a profile meta-chart, including the component charts it reads via .Files.
filegroup(
    name = "chart",
    srcs = [
        ".helmignore",
        "Chart.yaml",
        "profile.yaml",
        "values.schema.json",
        "values.yaml",
        ":rules",
        "//deploy/profiles/stable-2026a/components/clickhouse:chart",
        "//deploy/profiles/stable-2026a/components/ingestion-gateway:chart",
        "//deploy/profiles/stable-2026a/components/redpanda:chart",
    ] + glob(["templates/**"]),
    visibility = ["//visibility:public"],
)

go_library(
    name = "stable2026a",
    srcs = ["charts.go"],
    embedsrcs = [
        "//deploy/profiles/stable-2026a/components/ingestion-gateway:chart",
    ],
    importpath = "xmanager_cloud/deploy/profiles/stable-2026a",
    visibility = ["//visibility:public"],
)
