load("@rules_python//python:py_library.bzl", "py_library")
load("@rules_python//python:py_test.bzl", "py_test")

exports_files(["verify_xmc.py"])

# The deployment blueprint, exposed so that tests can assert the chart and the infrastructure it
# is deployed onto agree with each other.
filegroup(
    name = "blueprint",
    srcs = ["xmanager-cloud.yaml"],
    visibility = ["//visibility:public"],
)

# The blueprint that installs onto a VPC and GKE cluster that already exist. It duplicates most
# of xmanager-cloud.yaml because blueprints have no conditionals, so it is exposed for the test
# that holds the two in step.
filegroup(
    name = "existing_infra_blueprint",
    srcs = ["xmanager-cloud-existing-infra.yaml"],
    visibility = ["//visibility:public"],
)

# The deployment files an operator copies and fills in. Exposed so that a test can check each
# names only variables its blueprint declares -- gcluster downgrades the rest to a warning.
filegroup(
    name = "deployment_templates",
    srcs = [
        "xmc-deployment-template.yaml",
        "xmc-existing-infra-deployment-template.yaml",
    ],
    visibility = ["//visibility:public"],
)

# The local module the blueprint resolves the Redis endpoint through, exposed so that tests can
# assert the blueprint passes settings the module actually declares. Terraform would catch a
# mismatch, but not until the primary group applies against a real project.
filegroup(
    name = "redis_endpoint_module",
    srcs = glob(["modules/redis-endpoint/*.tf"]),
    visibility = ["//visibility:public"],
)

py_library(
    name = "verify_xmc_lib",
    srcs = ["verify_xmc.py"],
    imports = ["."],
    visibility = ["//visibility:public"],
    deps = [
        "//tools/common:tool_utils",
    ],
)

py_test(
    name = "verify_xmc_test",
    srcs = ["verify_xmc_test.py"],
    imports = ["."],
    deps = [
        ":verify_xmc_lib",
    ],
)
