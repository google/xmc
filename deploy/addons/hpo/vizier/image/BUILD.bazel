load("@rules_python//python:py_library.bzl", "py_library")
load("@rules_python//python:py_test.bzl", "py_test")

# The dependency-free logic of the Vizier server image. vizier_server.py is not a Bazel target: it
# needs google-vizier and SQLAlchemy, which are installed only in the image (see Dockerfile) and
# are not repository Python dependencies. It is exercised by building and running the image
# (see README.md).
py_library(
    name = "server_config",
    srcs = ["server_config.py"],
    imports = ["."],
)

py_test(
    name = "server_config_test",
    size = "small",
    srcs = ["server_config_test.py"],
    main = "server_config_test.py",
    deps = [":server_config"],
)

py_library(
    name = "supported_algorithms",
    srcs = ["supported_algorithms.py"],
    imports = ["."],
)

py_test(
    name = "supported_algorithms_test",
    size = "small",
    srcs = ["supported_algorithms_test.py"],
    main = "supported_algorithms_test.py",
    deps = [":supported_algorithms"],
)
