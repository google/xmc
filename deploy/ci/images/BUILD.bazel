load("@rules_python//python:py_library.bzl", "py_library")
load("@rules_python//python:py_test.bzl", "py_test")

package(default_visibility = ["//visibility:public"])

exports_files([
    "Dockerfile.base",
    "Dockerfile.lint",
    "docker-bake.hcl",
    "versions.json",
])

py_library(
    name = "render_bake_vars_lib",
    srcs = ["render_bake_vars.py"],
    data = ["versions.json"],
    imports = ["."],
)

py_test(
    name = "render_bake_vars_test",
    srcs = ["render_bake_vars_test.py"],
    data = ["versions.json"],
    imports = ["."],
    deps = [":render_bake_vars_lib"],
)

py_library(
    name = "verify_image_lib",
    srcs = ["verify_image.py"],
    data = ["versions.json"],
    imports = ["."],
)

py_test(
    name = "verify_image_test",
    srcs = ["verify_image_test.py"],
    data = ["versions.json"],
    imports = ["."],
    deps = [":verify_image_lib"],
)
