FROM ci-playwright

# Provide local C/C++ toolchain, openssl (KinD TLS generation), and patch for Bazel E2E builds.
RUN apt-get update && apt-get install -y --no-install-recommends \
        build-essential \
        openssl \
        patch \
    && rm -rf /var/lib/apt/lists/*

COPY --from=ci-cloud /opt/xmc-tools /opt/xmc-tools
COPY --from=ci-cloud /usr/local/bin/docker /usr/local/bin/docker
COPY --from=ci-cloud /usr/lib/google-cloud-sdk /usr/lib/google-cloud-sdk

# Preserve symlinks so gcloud resolves CLOUDSDK_ROOT_DIR to /usr/lib/google-cloud-sdk.
RUN ln -sf /usr/lib/google-cloud-sdk/bin/gcloud /usr/bin/gcloud \
    && ln -sf /usr/lib/google-cloud-sdk/bin/gsutil /usr/bin/gsutil \
    && ln -sf /usr/lib/google-cloud-sdk/bin/gke-gcloud-auth-plugin /usr/bin/gke-gcloud-auth-plugin

ENV PATH="/opt/xmc-tools/bin:/usr/lib/google-cloud-sdk/bin:${PATH}"
