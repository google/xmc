{
  "quadrants": [
    {
      "name": "Control Plane Services & CLI",
      "source_patterns": [
        "cmd/**",
        "pkg/apis/**",
        "pkg/auth/**",
        "pkg/clickhouse/**",
        "pkg/components/**"
      ],
      "reference_doc_patterns": [
        "cmd/**/README.md",
        "pkg/**/README.md"
      ],
      "orientation_doc_patterns": [
        "README.md",
        "CONTRIBUTING.md",
        "ABSENCE.md",
        "docs/architecture/*.md",
        "docs/design/*.md"
      ]
    },
    {
      "name": "Core Flows, Storage & Internal Packages",
      "source_patterns": [
        "internal/**"
      ],
      "reference_doc_patterns": [
        "internal/**/README.md",
        "internal/storage/AGENTS.md"
      ],
      "orientation_doc_patterns": [
        "docs/flows/*.md"
      ]
    },
    {
      "name": "gRPC, Protobuf & Filter Contracts",
      "source_patterns": [
        "api/protos/**/*.proto",
        "api/filter/**",
        "api/testdata/**"
      ],
      "reference_doc_patterns": [
        "cmd/ingestion_gateway/README.md",
        "cmd/experiment_state_server/README.md"
      ],
      "orientation_doc_patterns": [
        "docs/architecture/components.md",
        "docs/flows/*.md"
      ]
    },
    {
      "name": "Cluster Toolkit & Blueprints",
      "source_patterns": [
        "deploy/ctk_v2/**",
        "deploy/clickhouse/**",
        "deploy/local/**",
        "deploy/cli/**",
        "deploy/ci/**"
      ],
      "reference_doc_patterns": [
        "deploy/ctk_v2/README.md",
        "deploy/local/README.md",
        "deploy/cli/README.md",
        "deploy/ci/README.md"
      ],
      "orientation_doc_patterns": [
        "INSTALL.md",
        "docs/developer.md"
      ]
    },
    {
      "name": "Helm Charts, Addons & Profiles",
      "source_patterns": [
        "deploy/helm/**",
        "deploy/profiles/**",
        "deploy/addons/**"
      ],
      "reference_doc_patterns": [
        "deploy/helm/README.md",
        "deploy/profiles/**/README.md",
        "deploy/addons/**/README.md"
      ],
      "orientation_doc_patterns": [
        "INSTALL.md"
      ]
    },
    {
      "name": "Python SDKs (xmc, xdash)",
      "source_patterns": [
        "sdks/python/xmc/**",
        "sdks/python/xdash/**",
        "pyproject.toml"
      ],
      "reference_doc_patterns": [
        "sdks/python/xmc/README.md",
        "sdks/python/xdash/README.md"
      ],
      "orientation_doc_patterns": [
        "README.md",
        "docs/authentication.md",
        "docs/developer.md"
      ]
    },
    {
      "name": "Examples & Workloads",
      "source_patterns": [
        "examples/**"
      ],
      "reference_doc_patterns": [
        "examples/**/README.md"
      ],
      "orientation_doc_patterns": [
        "README.md"
      ]
    },
    {
      "name": "Diagnostic, CI & Dev Tools",
      "source_patterns": [
        "tools/**"
      ],
      "reference_doc_patterns": [
        "tools/**/README.md",
        "test/**/README.md"
      ],
      "orientation_doc_patterns": [
        "tools/README.md",
        ".github/**/*.md",
        "docs/ci_runner_infrastructure.md"
      ]
    },
    {
      "name": "Multi-Agent Guidelines & Rules",
      "source_patterns": [
        ".agents/rules/**",
        ".agents/skills/**"
      ],
      "reference_doc_patterns": [
        ".agents/rules/**/*.md",
        ".agents/skills/**/*.md"
      ],
      "orientation_doc_patterns": [
        ".agents/AGENTS.md",
        "docs/agent_workflows.md"
      ]
    }
  ],
  "identifier_sources": [
    {
      "identifier_type": "CLI Flags & Defaults",
      "source_patterns": [
        "cmd/*/main.go",
        "internal/configutil/**"
      ],
      "verification_command": "git grep -E '(StringVar|IntVar|BoolVar|Flag)\\([^,]*\"[^\"]*\"' cmd/"
    },
    {
      "identifier_type": "Environment Variables",
      "source_patterns": [
        "pkg/**",
        "internal/**",
        "cmd/**",
        "sdks/python/**"
      ],
      "verification_command": "git grep -E '(os\\.(Getenv|LookupEnv)\\(\"[A-Z0-9_]+\"\\)|os\\.(environ\\.get|getenv)\\(['\\''\"][A-Z0-9_]+['\\''\"][,)])' pkg/ internal/ cmd/ sdks/python/"
    },
    {
      "identifier_type": "Network Ports & Protocols",
      "source_patterns": [
        "deploy/helm/templates/**",
        "cmd/*/main.go",
        "deploy/helm/values.yaml"
      ],
      "verification_command": "git grep -E '(8123|9000|8080|50051)' deploy/helm/ cmd/"
    },
    {
      "identifier_type": "Helm Chart Parameters",
      "source_patterns": [
        "deploy/helm/values.yaml",
        "deploy/profiles/**/values.yaml"
      ],
      "verification_command": "grep -E '^[a-zA-Z0-9_]+:' deploy/helm/values.yaml"
    },
    {
      "identifier_type": "Cluster Toolkit Blueprint Vars",
      "source_patterns": [
        "deploy/ctk_v2/xmanager-cloud.yaml",
        "deploy/ctk_v2/xmc-deployment-template.yaml",
        "deploy/ctk_v2/modules/**/variables.tf"
      ],
      "verification_command": "grep -E 'vars:' deploy/ctk_v2/xmanager-cloud.yaml deploy/ctk_v2/xmc-deployment-template.yaml"
    },
    {
      "identifier_type": "Protobuf RPCs & Field Names",
      "source_patterns": [
        "api/protos/**/*.proto"
      ],
      "verification_command": "git grep -E '^[[:space:]]*(service|rpc|message) ' api/protos/"
    },
    {
      "identifier_type": "Python SDK Methods & Signatures",
      "source_patterns": [
        "sdks/python/xmc/**",
        "sdks/python/xdash/**"
      ],
      "verification_command": "git grep '__all__' sdks/python/"
    },
    {
      "identifier_type": "Container Images & Registries",
      "source_patterns": [
        "deploy/helm/values.yaml",
        "examples/**/Dockerfile",
        "examples/**/build_and_push.sh"
      ],
      "verification_command": "git grep 'pkg.dev' deploy/ examples/"
    }
  ]
}
